let mono = target == mono or target == avatar_mono
let avatar = target == avatar_dark or target == avatar_paper or target == avatar_mono
let fg = if target == paper or target == avatar_paper then brand.ink else if mono then brand.ink else brand.paper

if avatar
  emblem fg:fg accent:if mono then fg else brand.coral at:208,290 scale:1.1 name:logo
else
  emblem fg:fg accent:if mono then fg else brand.coral at:428,300 name:logo
  wordmark fg:fg at:124,640 scale:2 name:word
