@target logo-dark.png 920x740 as:dark
@target logo-paper.png 920x740 as:paper
@target logo-mono.png 920x740 as:mono
@target avatar-dark.png 512x512 bg:#0d1312 as:avatar_dark
@target avatar-paper.png 512x512 bg:#f4f2ec as:avatar_paper
@target avatar-mono.png 512x512 as:avatar_mono

# The ramose logo: a pebble with a coral corner mark above its right shoulder, over the
# lowercase wordmark. The `logo` targets draw the lockup with no background, for a page in that
# theme. The `avatar` targets draw the mark alone on a tile.

palette brand
  color ink #0d1312
  color paper #f4f2ec
  color coral #ff6b5b

# The mark, centered on the pebble. The pebble leans its narrow end toward the corner.
def emblem fg:brand.paper accent:brand.coral
  curve 0,-118 62,-98 98,-36 106,34 76,98 0,124 -76,98 -106,34 -98,-36 -62,-98 closed tension:.5 rot:34 fill:fg name:pebble
  path "M56 -188h142v146h-31v-115h-111z" fill:accent name:corner

# "ramose" set in Inter ExtraBold, 100 units to the em, baseline at 0.
def wordmark fg:brand.paper
