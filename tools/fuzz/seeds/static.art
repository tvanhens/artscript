# prop: static-across-frames
# entry: art/fuzz/case.art
@target fz/clip.gif 256x256 bg:#ffffff fps:8 dur:500ms
if t < .2
  let fz_a = rand(0 1)
else
  let fz_b = 1
layer fz_static
  circle rand(5 30) at:rand(100 900),rand(100 900) fill:#123456
anim fz_still dur:rand(1 2) loop
  .fz_static at:rand(0 40),rand(0 40)
play fz_still start:rand(0 .01)
layer fz_lin
  circle 9 at:100,900 fill:#654321
anim fz_slide dur:rand(4 5)
  .fz_lin at:key(0,0 400,0 ease:linear)
play fz_slide start:rand(-.2 -.1)

