@target clip.png 800x800

group at:400,400 rot:24
  curve 0,290 6,340 -6,380 stroke:p.leaf.1,[12 6] taper:0,.7 name:stem
  path "M0 -350 C110 -230 180 -40 125 120 C85 230 25 285 0 300 C-25 285 -85 230 -125 120 C-180 -40 -110 -230 0 -350 Z" fill:radial(p.leaf.3 p.leaf.1 at:.3,.3) name:leaf
    rect 400x700 at:200,0 fill:p.leaf.0 a:.3
    mirror x
      each k in 0..6
        curve 0,-180+k*75 90,-250+k*75 220,-290+k*75 stroke:p.leaf.4,[3 1] a:.6 name:vein
    curve 0,330 0,-360 stroke:p.leaf.4,[8 2] a:.8 name:rib
    rect 800x800 fill:fbm(simplex(26)) -> [fade(p.leaf.0 0) fade(p.leaf.0 .45)] name:texture
    ellipse 60,150 at:-70,-80 fill:p.leaf.4 a:.3 blur:24
    fx grain .06
    fx outline 4
