# Gouache for the reliquary. One key, upper right.
# `sun` points toward the light in a y-down frame, so positive x and negative y
# is the caged sun. Do not retune `sun` on a form. A cool rim is the pool, not a second key.

brush sculpt sun:.62,-.84 lo:p.ink hi:p.shine rimc:p.rim depth:.7 glossk:.28 rimk:.48 wrap:.12 strength:.55 scale:1 plump:1 planes:.62 broad:.32
  sksl """
  float4 shade(Mark m) {
    float2 o = seeded(m);
    float2 hb = float2(m.len, m.width) * .5;
    float2 q = m.uv / hb;
    float ql = max(length(q), .001);
    float e = clamp(m.edge / (min(m.len, m.width) * .5 * plump + .001), 0, 1);
    float z = sqrt(e * (2 - e));
    float3 n = normalize(float3(q / ql * (1 - z), z));
    float3 L = normalize(float3(sun, .72));
    float R = min(hb.x, hb.y);
    float th = atan(m.uv.y, m.uv.x) * R;
    float2 sc = float2(th / (36 * scale), m.edge / (8 * scale));
    float lin = fbm(float2(m.uv.x / (38 * scale), m.uv.y / (8 * scale)) + o, 4) - .5;
    float streak = mix(lin, fbm(sc + o, 4) - .5, smoothstep(.12, .48, ql));
    float blot = fbm(m.uv / (64 * scale) + o * 1.3, 3) - .5;
    float diff = clamp(dot(n, L) * (1 - wrap) + wrap + broad * dot(q, normalize(sun)) * .5 - broad * .12 + strength * (streak * .28 + blot * .32), 0, 1);
    float x = diff * 4;
    float band = (floor(x) + smoothstep(.28, .72, fract(x))) / 4;
    diff = mix(diff, band, planes);
    float3 base = m.paint.rgb;
    float3 sh = mix(base, lo.rgb, depth);
    float3 hl = mix(base, hi.rgb, .38);
    float3 c = mix(sh, base, smoothstep(.04, .48, diff));
    c = mix(c, hl, smoothstep(.64, 1, diff));
    float3 H = normalize(L + float3(0, 0, 1));
    float spec = pow(max(dot(n, H), 0), 28) * glossk * (.45 + streak * 1.6);
    c += hi.rgb * max(spec, 0);
    float back = max(0, dot(q / ql, -normalize(sun)));
    c = mix(c, rimc.rgb, rimk * pow(1 - z, 2.4) * back);
    float edge = m.edge - streak * 2.4 * scale;
    return float4(clamp(c, 0, 1), cover(edge, m));
  }
  """

# Shadow-side ink. Thin where the sun hits, heavy and dry in the shade.
brush ink center:0,0 sun:.62,-.84 thin:.28 heavy:1 dryk:.22 scale:1
  sksl """
  float4 shade(Mark m) {
    float2 o = seeded(m);
    float2 r = m.p - center;
    float side = dot(r / max(length(r), .001), -normalize(sun));
    float n = fbm(float2(m.s / (46 * scale), 0) + o, 3);
    float w = mix(thin, heavy, smoothstep(-.55, .65, side)) * (.78 + .4 * n);
    float e = m.edge - (1 - w) * m.width * .5;
    float dry = smoothstep(.22, .48, fbm(float2(m.s / (8 * scale), m.v * 4) + o * 2, 3));
    return float4(m.paint.rgb, cover(e, m) * mix(1, dry, dryk * (1 - side) * .55));
  }
  """
