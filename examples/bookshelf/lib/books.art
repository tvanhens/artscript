# A cloth or paper book standing on a shelf. The origin is the middle of the spine's foot, so
# `at:` sets a book on a shelf at the shelf's top edge.

use paper { cover wear }
use std/brushes { chip }

palette bindery
  color shadow #070405
  color paper #efe9df
  color type #efe6cf
  color gilt #c9a45a

def book w:40 h:280 tone:#884422 title:"MOBY-DICK" author:"MELVILLE" ink:bindery.type bands:false label:false font:"Times New Roman"
  let ts = min(w*.44 h*.66/(len(title)*.68))
  let asz = min(w*.3 h*.2/(len(author)*.7))
  rect w+10,h at:9,-h/2-4 fill:bindery.shadow a:.45 blur:9 name:cast
  rect w,h at:0,-h/2 r:2.5,2.5,0,0 fill:grad(down mix(tone bindery.paper .06) tone,.3 mix(tone bindery.shadow .35)) brush:[cover(dir:90 roll:.12) wear(strength:.04)] name:face
    rect w,2.5 at:0,-h/2+1 fill:bindery.paper a:.55 jitter:.6,7 name:cap_edge
    each k in 0..2
      rect 1.3,h at:rand(-w*.4 w*.4),0 fill:bindery.paper a:rand(.04 .12) blur:1.2 name:crease
    if label
      let run = min(h*.62 len(title)*ts*.72+22)
      rect w-6,run at:0,-h*.13 r:1.5 fill:mix(tone bindery.shadow .7) name:label_panel
        rect w-10,run-4 r:1 fill:none stroke:fade(bindery.gilt .7),.8 name:label_frame
    group fill:ink name:type brush:chip(strength:.2 scale:.35)
      text title size:ts font:font rot:90 at:0,-h*.13 name:title
      text author size:asz font:font track:2 rot:90 at:0,h*.32 name:author
      if bands
        rect w,3 at:0,-h/2+16 fill:bindery.gilt name:band_top
        rect w,1.4 at:0,-h/2+22 fill:bindery.gilt name:band_top_fine
        rect w,1.4 at:0,h/2-22 fill:bindery.gilt name:band_bottom_fine
        rect w,3 at:0,h/2-16 fill:bindery.gilt name:band_bottom
    rect w,h fill:grad(right fade(bindery.shadow .45) fade(bindery.shadow 0),.18 fade(bindery.shadow 0),.8 fade(bindery.shadow .5)) name:roll
