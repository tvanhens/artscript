# Painterly brushes for hand-painted monster art.

# Volumetric shading: treats the fill as a bulging form, lights it from `sun` (a direction
# in the node's frame, y down), maps shadow toward `lo` and light toward `hi`, breaks the
# values into soft painted planes, lays strokes around the form, and adds a cool back rim.
brush sculpt sun:-.6,-.8 lo:p.ink hi:p.shine rimc:p.rim depth:.7 glossk:.3 rimk:.5 wrap:.12 strength:.5 scale:1 plump:1 planes:.6 broad:.35
  let hb = m.size*.5
  let q = m.uv/hb
  let ql = max(length(q) .001)
  let e = clamp(m.edge/(min(m.size.x m.size.y)*.5*plump+.001) 0 1)
  let z = sqrt(e*(2-e))
  let n = normalize(q/ql*(1-z),z)
  let L = normalize(sun,.7)
  let R = min(hb.x hb.y)
  let th = rad(atan2(m.uv.y m.uv.x))*R
  let sc = th/(40*scale),m.edge/(9*scale)
  let lin = fbm(m.uv.x/(40*scale),m.uv.y/(9*scale) oct:4)-.5
  let streak = lerp(lin fbm(sc oct:4)-.5 smoothstep(.15 .5 ql))
  let blot = fbm(m.uv/(70*scale) oct:3 salt:1)-.5
  let lit = clamp(dot(n L)*(1-wrap)+wrap+broad*dot(q normalize(sun))*.5-broad*.15+strength*(streak*.3+blot*.35) 0 1)
  let x = lit*4
  let band = (floor(x)+smoothstep(.3 .7 fract(x)))/4
  let diff = lerp(lit band planes)
  let base = m.paint.rgb
  let sh = lerp(base lo.rgb depth)
  let hl = lerp(base hi.rgb .4)
  let shaded = lerp(sh base smoothstep(.05 .5 diff))
  let toned = lerp(shaded hl smoothstep(.62 1 diff))
  let H = normalize(L+(0,0,1))
  let spec = pow(max(dot(n H) 0) 30)*glossk*(.5+streak*2)
  let glossed = toned+hi.rgb*max(spec 0)
  let back = max(0 dot(q/ql -normalize(sun)))
  let rimmed = lerp(glossed rimc.rgb rimk*pow(1-z 2.5)*back)
  let cut = m.edge-streak*3*scale
  out clamp(rimmed 0 1) cover:cover(cut)

# A hand-inked contour for a stroked outline: thin on the side facing `sun`, heavy on the
# shadow side, measured from `center` in the node's local units, with a dry, broken edge.
brush ink center:0,0 sun:-.6,-.8 thin:.3 heavy:1 dryk:.35 scale:1
  let r = m.position.xy-center
  let side = dot(r/max(length(r) .001) -normalize(sun))
  let n = fbm(m.s/(50*scale),0 oct:3)
  let w = lerp(thin heavy smoothstep(-.6 .7 side))*(.8+.4*n)
  let e = m.edge-(1-w)*m.size.y*.5
  let dry = smoothstep(.25 .45 fbm(m.s/(9*scale),m.d/(m.size.y/2)*4 oct:3 salt:1))
  out m.paint.rgb cover:cover(e)*lerp(1 dry dryk*(1-side)*.5)
