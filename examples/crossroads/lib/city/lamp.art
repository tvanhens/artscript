# Wrought-iron lamp post with a glass cage around a glowing orb. Foot on the origin.
def lamp h:300 r:20 iron:p.deep.1 tint:p.lamp.3
  ellipse r*9,r*9 at:0,-h fill:tint a:.16 blur:r*5 blend:screen
  ellipse r*3.5,r*3.5 at:0,-h fill:tint a:.22 blur:r*2 blend:screen
  rect 8,h at:0,-h/2 fill:grad(right iron shade(iron 2),.3 iron) name:post
  rect 22,14 at:0,-6 r:2 fill:iron
  rect 14,40 at:0,-30 r:3 fill:iron
  each s in [-1 1]
    curve 0,-h+r*1.6 s*r*1.3,-h+r*2 s*r*1.6,-h+r*1.2 s*r*1.3,-h+r*.6 stroke:iron,3
    curve 0,-h*.55 s*12,-h*.6 s*14,-h*.68 s*8,-h*.7 stroke:iron,2.5
  ellipse r*1.9,r*1.9 at:0,-h fill:tint a:.55 blur:r*.7 blend:screen
  circle r at:0,-h fill:radial(p.glow tint,.45 shade(tint -1)) name:orb
    fx glow r*1.6 color:tint
  each k in [-1 0 1]
    curve k*r*.75,-h-r*1.15 k*r*1.05,-h k*r*.75,-h+r*1.15 stroke:iron,2 a:.85
  curve -r*1.1,-h-r*1.1 0,-h-r*1.8 r*1.1,-h-r*1.1 closed tension:.3 fill:iron
  curve 0,-h-r*1.8 0,-h-r*2.6 stroke:iron,3
  circle 3 at:0,-h-r*2.7 fill:iron
  rect r*2.4,5 at:0,-h+r*1.2 r:2 fill:iron
