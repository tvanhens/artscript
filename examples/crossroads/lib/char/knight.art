# A small horned vessel in a tattered cloak, feet on the origin, facing right.
# `rim` is the color of the light from the right.
def knight rim:p.lamp.3
  each s in [-1 1]
    curve s*9-4,-26 s*9-5,-8 s*9-3,-1 s*9+5,-1 s*9+4,-10 s*9+4,-26 closed tension:.4 fill:p.cloak.0
  curve -24,-84 -32,-56 -44,-18 -40,-6 -30,-13 -24,-3 -13,-15 -3,-5 7,-15 19,-4 29,-15 39,-10 35,-42 26,-74 12,-88 -12,-88 closed tension:.45 fill:grad(right p.cloak.1 p.cloak,.55 p.cloak.2) name:cloak
    curve -40,-60 -46,-14 -30,-16 -20,-50 closed tension:.5 fill:p.cloak.0 a:.7 blur:6
    curve 14,-86 34,-56 40,-12 30,-18 22,-64 closed tension:.5 fill:rim a:.3 blur:5
    curve -6,-84 -10,-48 -14,-14 stroke:p.cloak.0,[1 3 1] a:.6
    curve 8,-82 12,-48 10,-16 stroke:p.cloak.0,[1 2.5 1] a:.5
    curve -22,-80 0,-74 22,-80 stroke:p.cloak.0,[1 3 1] a:.6 blur:1
    fx rim 2 dir:1,0 color:rim a:.7
    fx grain .05 scale:1.5
  curve 24,-46 44,-28 78,6 stroke:p.nail,[4 3.4 1.4] taper:0,.35 name:nail
    fx glow 3 color:fade(rim .6)
  rect 10,4 at:22,-48 rot:42 r:1 fill:p.cloak.0
  group name:head
    curve -20,-116 -28,-128 -36,-144 -40,-160 -38,-174 -33,-162 -27,-147 -16,-131 -5,-123 closed tension:.5 fill:grad(up p.shell_shade p.shell) name:horn_l
    curve 20,-116 28,-128 36,-144 40,-160 38,-174 33,-162 27,-147 16,-131 5,-123 closed tension:.5 fill:grad(up p.shell_shade p.shell) name:horn_r
      fx rim 1.5 dir:1,0 color:rim a:.8
    curve -25,-114 -28,-100 -25,-87 -15,-79 0,-76 15,-79 25,-87 28,-100 25,-114 15,-124 0,-127 -15,-124 closed tension:.5 fill:grad(right p.shell_shade p.shell,.45 p.shell) name:skull
      ellipse 7,12.5 at:-10,-98 rot:8 fill:p.eye
      ellipse 7,12.5 at:10,-98 rot:-8 fill:p.eye
      curve -24,-100 -20,-84 -8,-78 stroke:p.shell_shade,4 a:.7 blur:2.5
      fx rim 2.5 dir:1,-.3 color:rim a:.9
    fx outline 1.5 color:p.cloak.0
