@target monument/vermilion_torii.png 1024x1024
@target monument/vermilion_torii.svg 1024x1024
use face/parts { sparkle }
palette torii
  ramp verm #d9543a 5
  ramp char #3a3942 5
  ramp straw #d8b25a 5
  ramp paper #f1ede4 5
  color paper_cool #c3c9dc
  ramp maple #e47a35 5
  ramp stone #a89f93 5
  ramp moss #7d8f4e 5
  color sheen #8d93ad
  color lacquer #e6ecf8
  color ink_cool #6f7fa8
  color spark #fff3cf
let verm = torii.verm
let char = torii.char
let straw = torii.straw
let paper = torii.paper
let cool = torii.paper_cool
let maple = torii.maple
let stone = torii.stone
let moss = torii.moss
let sheen = torii.sheen
let lacquer = torii.lacquer
let ink_cool = torii.ink_cool
let spark = torii.spark
let gate = mix(verm.line char.line .25)
def _pillar cx:334
  curve -54,188 54,188 62,808 -62,808 closed tension:0 round:9 at:cx,0 fill:grad(right verm verm.3,.2 verm,.42 verm.1,.7 verm.0) name:shaft
    curve 20,180 80,180 80,820 27,820 closed tension:0 fill:verm.1 a:.85 blur:1
    ellipse 12,300 at:46,520 fill:verm.0 a:.45 blur:9
    curve -28,300 -30,520 -33,740 stroke:verm.4,[3 9 4] a:.55 blur:2.5
    each k in 0..4
      let gx = -36+k*20+rand(-3 3)
      curve gx,300+k*40 gx+1,480 gx-1,700-k*30 stroke:verm.1,1.3 a:.22
    rect 160x46 at:0,273 r:4 fill:verm.0 a:.7 blur:9
    rect 160x28 at:0,414 r:4 fill:verm.0 a:.65 blur:8
    rect 124x108 at:0,766 fill:grad(right char char.3,.22 char,.5 char.0) name:band
      curve -50,-50 0,-49 40,-50 stroke:sheen,[1.5 3 1.5] a:.7 blur:.8
      ellipse 4,12 at:-30,-30 fill:lacquer a:.6 blur:1.5
      ellipse 80,14 at:0,0 fill:char.0 a:.7 blur:7
      curve -58,-54 58,-54 stroke:gate,2.2 taper:.1 a:.9
    ellipse 70,8 at:0,704 fill:verm.0 a:.5 blur:5
    fx rim 5 dir:1,1 color:p.rim a:.45
    fx grain .04 scale:2.5
    fx outline 6 color:gate
def _stone cx:334
  curve cx-94,848 cx-90,806 cx-70,772 cx-28,758 cx+28,758 cx+72,774 cx+92,806 cx+96,848 cx,856 closed tension:.5 fill:grad(28 stone.3 stone,.45 stone.1) name:rock
    curve cx+26,750 cx+110,770 cx+110,866 cx-10,866 cx+34,822 cx+40,786 closed tension:.5 fill:stone.1 a:.9 blur:1.2
    ellipse 26,32 at:cx+70,826 fill:stone.0 a:.4 blur:10
    ellipse 70,12 at:cx+4,770 fill:stone.0 a:.6 blur:6
    curve cx-78,814 cx-62,784 cx-30,768 stroke:stone.4,[3 6 3] a:.75 blur:1
    ellipse 92,8 at:cx,850 fill:stone.0 a:.5 blur:5
    each i in 0..22
      circle rand(1 2.2) at:cx+rand(-82 82),rand(782 842) fill:stone.0 a:.4 name:fleck
    curve cx+40,798 cx+52,814 cx+46,832 stroke:stone.line,1.8 a:.45
    fx rim 4 dir:1,1 color:p.rim a:.5
    fx grain .06 scale:2
    fx outline 5 color:stone.line
def _groove x:512
  let u = (x-512)/242
  let yc = 472-36*u*u
  let hw = 38-17*u*u
  curve x-10,yc-hw x-3,yc-hw*.35 x+7,yc+hw*.35 x+18,yc+hw stroke:straw.1,9 taper:.2 a:.55 blur:3.5
  curve x-16,yc-hw x-9,yc-hw*.35 x+1,yc+hw*.35 x+12,yc+hw stroke:straw.0,[1.2 3.4 3.4 1.2] taper:.25 a:.8
  curve x-24,yc-hw*.75 x-17,yc-hw*.1 x-10,yc+hw*.4 stroke:straw.4,[2 4.5 1.5] a:.65 blur:1.2
  each i in 0..3
    let fiber_x = x+rand(-12 4)
    let fiber_y = yc+rand(-1 1)*hw*.6
    curve fiber_x-4,fiber_y-3 fiber_x+4,fiber_y+3 stroke:straw.1,1 a:.4
finish _surface width:4 a:.45 strength:.04 scale:2.5
  fx rim width dir:1,1 color:p.rim a:a
  fx grain strength scale:scale
def _tassel tx:467
  let u = (tx-512)/242
  let ty = 496-53*u*u
  curve tx-9,ty tx+9,ty tx+10,ty+22 tx+18,ty+58 tx+10,ty+64 tx+2,ty+60 tx-6,ty+66 tx-17,ty+58 tx-10,ty+22 closed tension:.35 fill:grad(63 straw.3 straw,.5 straw.1) name:fringe
    curve tx+4,ty tx+30,ty tx+30,ty+80 tx+8,ty+80 closed tension:0 fill:straw.1 a:.7 blur:1
    each k in 0..8
      let f = (k-3.5)/3.5
      let ink = if k-2*floor(k/2) > .5 then straw.0 else straw.4
      curve tx+f*6,ty+18 tx+f*10,ty+40 tx+f*15,ty+60 stroke:ink,1.3 a:.55
    ellipse 14,8 at:tx,ty+6 fill:straw.0 a:.6 blur:4
    rect 22x7 at:tx,ty+17.5 r:2 fill:verm
      curve -9,-2.5 8,-2.5 stroke:verm.4,1.4 a:.7
    fx _surface a:.4 strength:.05 scale:1.8
def _fold i:0 flutter:0
  let dx = (if mod(i 2) > .5 then 18 else 0)+flutter*(i*i*4+i*6)
  let y0 = i*44-(if i < .5 then 30 else 0)
  let y1 = (i+1)*44+2
  let sk = 3+flutter*6
  curve -25+dx,y0 5+dx,y0 5+dx+sk,y1 -25+dx+sk,y1 closed tension:0 round:2.5 fill:if mod(i 2) > .5 then grad(right mix(paper cool .6) mix(cool paper.0 .3)) else grad(right paper.3 paper,.6 mix(paper cool .35))
    ellipse 6,30 at:-10+dx+sk/2+13,(y0+y1)/2 fill:cool a:.6 blur:3
    curve -10+dx+sk/2-13,y0+2 -10+dx+sk/2+13,y0+3 stroke:mix(cool paper.line .4),1.6 a:.55
def _shide flutter:0
  union fill:paper name:sil z:-1
    each i in 0..4
      _fold i flutter:flutter
    fx outline 3 color:mix(paper.line ink_cool .5)
  inside @sil
    each i in 0..4
      _fold i flutter:flutter
    ellipse 26,14 at:2,2 fill:mix(cool paper.line .5) a:.7 blur:6
  fx rim 3 dir:1,1 color:p.rim a:.6
  fx grain .03 scale:1.6
def _leaf cx:150 cy:566 r:44 rot:-18 tint:0
  let tone = if tint < .01 then maple else mix(maple verm tint)
  let o = cx,cy
  let A = [-106 -96 -90 -84 -74 -64 -54 -44 -38 -32 -22 -12 -1 9 15 21 31 90 149 159 165 171 181 191 202 212 218 224 234 244]
  let R = [.58 .82 1 .82 .58 .38 .5104 .7216 .88 .7216 .5104 .38 .348 .492 .6 .492 .348 .3 .348 .492 .6 .492 .348 .38 .5104 .7216 .88 .7216 .5104 .38]
  let L = [-90,1 -38,.88 15,.6 165,.6 218,.88]
  curve o o+polar(r*.75 90+rot) o+polar(r*.95 90+rot+17.19) stroke:line(tone),[8.2 8.2 7.4] taper:0,.08
  curve o o+polar(r*.75 90+rot) o+polar(r*.95 90+rot+17.19) stroke:shade(tone -1),[2.4 2 1.2] taper:0,.7
  curve [each n in 0..30 -> o+polar(r*R.{n} A.{n}+rot)] closed tension:.25 fill:grad(45 shade(tone 1) tone shade(tone -1)) name:blade
    ellipse r*.5,r*.4 at:o+(r*.35,r*.35) fill:shade(tone -2) a:.4 blur:r*.25
    each k in 0..5
      curve o o+polar(r*L.{k}.y*.82 L.{k}.x+rot) stroke:shade(tone -2),[1.8 .8] taper:0,.8 a:.6
    ellipse r*.28,r*.14 at:o-(r*.3,r*.35) fill:shade(tone 2) a:.6 blur:2
    fx outline 3 color:line(tone)
  circle 5.2 at:o+polar(r*1.03 90+rot+18) fill:spark blur:2.6 blend:erase
def _peb px:806 py:850 r:7
  curve px-r,py px-r*.4,py-r*.8 px+r*.6,py-r*.7 px+r,py+r*.2 px,py+r*.5 closed tension:.5 fill:grad(45 stone.3 stone.1) stroke:fade(stone.line .8),1.6
layer ground_shadow
  ellipse 400,32 at:512,852 fill:p.shadow a:.34 blur:16
  each cx in [340 696]
    ellipse 96,13 at:cx,848 fill:p.shadow a:.32 blur:6
layer footings pivot:512,840
  layer pillars pivot:512,800 z:behind
    _pillar 334 name:pillar_l
    _pillar 690 name:pillar_r
    layer nuki pivot:512,373
      group name:nuki_parts
        curve 484,226 540,226 543,356 481,356 closed tension:0 round:6 fill:grad(right verm.3 verm,.5 verm.1) name:strut
          ellipse 46,18 at:512,268 fill:verm.0 a:.7 blur:7
        curve 186,344 838,344 830,404 194,404 closed tension:0 round:8 fill:grad(down verm.3 verm,.45 verm.1) name:beam
          subtract fill:verm.1 a:.9 blur:.8
            copy @beam
            copy @beam at:0,-15
          ellipse 130,9 at:720,396 fill:verm.0 a:.4 blur:6
          ellipse 46,9 at:512,346 fill:verm.0 a:.55 blur:5
          curve 212,352 420,351 620,352 stroke:verm.4,[2 5 2] a:.7 blur:1
          each ex in [184 826]
            rect 13x64 at:ex+6.5,374 r:3 fill:verm.1 a:.55
          each cx in [334 690]
            curve cx-60,348 cx-61,400 stroke:verm.line,2 a:.4
            curve cx+60,348 cx+61,400 stroke:verm.line,2 a:.4
          fx _surface
        fx _surface
      layer plaque pivot:512,266
        rect 88x76 at:512,306 r:10 fill:grad(40.8 char.3 char,.5 char.0) name:plate
          rect 70x58 r:6 fill:fade(straw 0) stroke:straw,4 name:frame
          copy @plate.frame at:-1,-1 fill:fade(straw 0) stroke:straw.4,1.4 a:.6
          curve -8,-16 -10,0 -7,16 stroke:straw.3,[3 4.5 2.5] taper:.2,.5
          curve 10,-18 8,-6 stroke:straw.3,[3 2] taper:.1,.6
          curve 6,4 12,12 9,20 stroke:straw.3,[2.5 4 2] taper:.2,.6
          each s in [-1 1]
            each q in [-1 1]
              circle 2.6 at:36*s,30*q fill:straw.4
          fx inner 3,4 blur:3 color:char.0
          fx outline 4 color:char.line
      layer shimenawa pivot:512,440
        layer shide_l pivot:424,475.24 z:-2
          _shide at:424,475.24 name:paper_l
        layer shide_c pivot:512,480 z:-2
          _shide at:512,480 name:paper_c
        layer shide_r pivot:600,475.24 z:-2
          _shide at:600,475.24 name:paper_r
        layer shide_c_flutter pivot:512,480 a:0 z:-2
          _shide flutter:.6 at:512,480 name:paper_flutter
        group name:bundle
          curve 270,436 390,462 512,472 634,462 754,436 stroke:straw,[34 54 68 54 34] taper:0 name:rope
            copy @rope fill:grad(down straw.3 straw,.5 straw.1)
            subtract fill:straw.1 a:.75 blur:1.2
              copy @rope
              copy @rope at:0,-18
            each x in [262 280.77 300.08 319.95 340.4 361.43 383.08 405.35 428.26 451.84 476.1 501.06 526.74 552.32 577.15 601.27 624.69 647.43 669.51 690.95 711.78 732 751.63]
              _groove x name:groove
            fx _surface a:.4 strength:.05 scale:1.8
          _tassel 467 name:tas_l z:behind
          _tassel 557 name:tas_r z:behind
        union fill:straw z:-1
          copy @rope
          copy @tas_l.fringe
          copy @tas_r.fringe
          fx outline 4.5 color:straw.line
      union fill:verm z:-1
        copy @strut
        copy @beam
        fx outline 6 color:gate
    layer kasagi pivot:512,240
      group name:roof
        curve 96,100 180,150 320,178 512,184 704,178 844,150 928,100 930,124 896,172 808,206 700,220 512,226 324,220 216,206 128,172 94,124 closed tension:.5 fill:grad(down char.3 char,.4 char.0) name:cap z:front
          copy @cap fill:grad(right char.3 char,.45 char.1) a:.5
          subtract fill:char.0 a:.8 blur:.8
            copy @cap
            copy @cap at:0,-12
          curve 112,116 200,160 330,184 470,190 stroke:sheen,[2 7 5 2] a:.8 blur:1.2
          curve 560,190 700,186 820,162 stroke:sheen,[1.5 3 1.5] a:.35 blur:1.5
          ellipse 24,4.5 at:196,160 rot:24 fill:lacquer a:.85 blur:.6
          fx _surface width:5 a:.55 strength:.035 scale:2
        curve 146,170 320,204 512,210 704,204 878,170 874,216 790,244 700,256 512,264 324,256 234,244 150,216 closed tension:.5 fill:grad(down verm.3 verm.3,.32 verm,.66 verm.1) name:shimaki
          subtract fill:verm.1 a:.9 blur:.8
            copy @shimaki
            copy @shimaki at:0,-15
          copy @cap at:4,9 fill:verm.0 a:.6 blur:6
          ellipse 110,14 at:780,242 fill:verm.0 a:.35 blur:8
          curve 190,230 340,242 480,246 stroke:verm.4,[2 4 2] a:.5 blur:1.5
          fx _surface width:5 a:.55 strength:.035 scale:2
      union fill:verm z:-1
        copy @shimaki
        copy @cap
        fx outline 7 color:gate
      layer sparkles
        sparkle 28 at:210,84 color:spark
        sparkle 20 at:900,272 color:spark glow:.25
  _stone 334 name:stone_l
  _stone 690 name:stone_r
  curve 238,800 250,778 270,766 294,762 300,772 282,780 268,794 254,812 240,818 closed tension:.4 fill:none jitter:2.5,14 name:src_l
  group
    intersect fill:grad(45 moss.3 moss,.55 moss.1) name:tuft_l
      copy @src_l
      copy @stone_l.rock
    copy @tuft_l at:3,4 fill:stone.0 a:.45 blur:3 z:behind
    inside @tuft_l
      each i in 0..14
        circle rand(1 1.8) at:rand(248 294),rand(766 814) fill:moss.4 a:.6 name:moss_dot_l
    copy @tuft_l fill:fade(moss 0) stroke:moss.line,1.4 a:.45 blur:.55
  curve 750,770 768,778 782,794 786,806 778,802 766,788 752,780 closed tension:.4 fill:none name:src_r
  copy @src_r at:3,4 fill:stone.0 a:.45 blur:3
  intersect fill:grad(45 moss.3 moss,.55 moss.1) name:tuft_r
    copy @src_r
    copy @stone_r.rock
  inside @tuft_r
    each i in 0..14
      circle rand(1 1.8) at:rand(750 786),rand(770 806) fill:moss.4 a:.6 name:moss_dot_r
  copy @tuft_r fill:fade(moss 0) stroke:moss.line,1.2 a:.35 blur:.6
  _peb 806 850
  _peb 820 854 r:4.5
  _peb 572 852 r:5.5
layer leaf_a pivot:150,566
  _leaf 150 566 name:maple_a
layer leaf_b pivot:870,474
  _leaf 870 474 r:36 rot:28 tint:.35 name:maple_b
layer leaf_c pivot:836,690
  _leaf 836 690 r:30 rot:64 tint:.15 name:maple_c
assert inside(@cap canvas margin:24)
