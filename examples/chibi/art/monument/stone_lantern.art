          curve 246,306 330,324 404,342 512,345 620,342 694,324 778,306 stroke:stone_line,2.2 taper:.08 a:.6
          curve 258,308 330,325 404,343 stroke:lantern.stone.4,2.6 taper:.2 a:.7 blur:.8
          curve 510,214 470,258 430,308 404,346 stroke:lantern.stone.4,[3 5 6 5] taper:.2 a:.8 blur:.8
          curve 514,215 474,259 434,309 408,347 stroke:stone_line,2.4 taper:.2 a:.55
          curve 511,214 553,258 593,308 617,346 stroke:lantern.stone.3,[2 4 4 3] taper:.2 a:.6 blur:.8
          curve 517,215 559,259 599,309 623,347 stroke:stone_line,2.4 taper:.2 a:.6
          _speckle 160 x0:250 x1:790 y0:200 y1:360 tone:lantern.stone
          _moss 22 x0:330 x1:436 y0:232 y1:290
            form:
              curve 330,278 372,252 412,232 436,240 424,264 392,282 356,290 closed tension:.55 jitter:3 fill:none name:form
          _moss 8 x0:470 x1:520 y0:206 y1:226
            form:
              curve 470,214 500,206 520,210 506,224 480,226 closed tension:.55 jitter:2 fill:none name:form
          _spiral 252 cy:286 r0:13 turns:1.15 start:162 sign:1 n:26 w0:3.2 w1:1
          _spiral 250 cy:284 r0:10 turns:.5 start:162 sign:1 n:10 w0:1.8 w1:1.8 ink:lantern.stone.4 alpha:.6 soft:.6
          _spiral 774 cy:285 r0:14 turns:1.15 start:18 sign:-1 n:26 w0:3.2 w1:1
          _spiral 772 cy:283 r0:11 turns:.5 start:18 sign:-1 n:10 w0:1.8 w1:1.8 ink:lantern.stone.4 alpha:.6 soft:.6
          _spiral 404 cy:352 r0:7 turns:.9 start:180 sign:1 n:14 w0:2 w1:2 alpha:.7
          _spiral 620 cy:352 r0:7 turns:.9 start:180 sign:-1 n:14 w0:2 w1:2 alpha:.7
          fx rim 5 dir:1,1 color:lantern.rim a:.55
          fx grain .05 scale:2.2
          fx outline 6.5 color:stone_line
        assert inside(@hat canvas margin:16)
        layer finial pivot:512,212
          union name:cap_src fill:none
            curve 478,214 482,202 512,196 542,202 546,214 512,222 closed tension:.45
