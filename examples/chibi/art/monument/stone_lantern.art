            curve 486,214 494,202 502,214 stroke:stone_line,1.6 taper:.2 a:.5
            curve 504,214 512,202 520,214 stroke:stone_line,1.6 taper:.2 a:.5
            curve 522,214 530,202 538,214 stroke:stone_line,1.6 taper:.2 a:.5
            _speckle 8 x0:484 x1:546 y0:130 y1:220 tone:lantern.stone
            fx rim 4 dir:1,1 color:lantern.rim a:.55
            fx grain .04 scale:1.8
            fx outline 5 color:stone_line
          assert inside(@cap canvas margin:16)
  layer moss_tufts pivot:512,790
    union name:tuft_src fill:none
      curve 356,784 361,764 374,749 393,748 413,748 430,739 447,749 460,763 466,780 453,793 434,795 414,798 395,795 375,790 closed tension:.5 name:c1
      curve 498,790 502,782 509,775 518,773 526,768 535,772 543,777 547,785 551,794 544,797 534,798 525,799 516,795 507,792 closed tension:.5 name:c2
      curve 584,788 590,772 600,759 613,749 629,754 645,749 659,753 671,765 675,782 664,789 648,795 632,797 616,792 600,793 closed tension:.5 name:c3
    copy @tuft_src fill:grad(11 lantern.moss.3 lantern.moss,.5 lantern.moss.1) name:tuft
      ellipse @c1.w*.45,9 at:@c1.cx+@c1.w*.18,@c1.bottom-6 fill:lantern.moss.0 a:.5 blur:5
      ellipse @c1.w*.25,6 at:@c1.cx-@c1.w*.15,@c1.top+10 fill:lantern.moss.4 a:.6 blur:3
      ellipse @c2.w*.45,9 at:@c2.cx+@c2.w*.18,@c2.bottom-6 fill:lantern.moss.0 a:.5 blur:5
      ellipse @c2.w*.25,6 at:@c2.cx-@c2.w*.15,@c2.top+10 fill:lantern.moss.4 a:.6 blur:3
      ellipse @c3.w*.45,9 at:@c3.cx+@c3.w*.18,@c3.bottom-6 fill:lantern.moss.0 a:.5 blur:5
      ellipse @c3.w*.25,6 at:@c3.cx-@c3.w*.15,@c3.top+10 fill:lantern.moss.4 a:.6 blur:3
      _speckle 70 x0:350 x1:690 y0:742 y1:800 tone:lantern.moss
      fx rim 3 dir:1,1 color:lantern.rim a:.4
      fx grain .04 scale:1.8
      fx outline 3 color:lantern.moss.line
    ellipse 18,11 at:282,858 jitter:1.5 fill:grad(31 lantern.rock.4 lantern.rock,.5 rock_cel) stroke:rock_line,2.4
    ellipse 14,9 at:744,852 jitter:1.5 fill:grad(33 lantern.rock.4 lantern.rock,.5 rock_cel) stroke:rock_line,2.4
    ellipse 9,6 at:310,868 jitter:1.5 fill:grad(34 lantern.rock.4 lantern.rock,.5 rock_cel) stroke:rock_line,2.4
    curve 350,790 344,772 336,760 stroke:lantern.moss.line,[7 6 4] taper:0,.8
    curve 350,790 344,772 336,760 stroke:lantern.moss,[4 3 1] taper:0,.8
    curve 676,800 682,782 690,770 stroke:lantern.moss.line,[7 6 4] taper:0,.8
