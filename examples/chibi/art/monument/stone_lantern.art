@target monument/stone_lantern.png 1024x1024
@target monument/stone_lantern.svg 1024x1024
use face/parts { blush smile sparkle }
palette lantern
  stone ramp #a1aa95 5
  rock ramp #87917f 5
  moss ramp #7f9c45 5
  amber ramp #f0a23c 5
  teal ramp #2f6d6b 5
  cream ramp #eadcc0 5
  blush #e89a8a
  night #2c3a3e
  rim #8fd0cc
  firefly #e4f27c
  face #4e4250
  wick #3a2a24
  glint #fbf7ee
  core #fffbea
  hot #fbffe0
  spark #f3f7c8
let stone_cel = mix(lantern.stone.1 lantern.teal.1 .35)
let stone_line = mix(lantern.stone.line lantern.teal.line .4)
let rock_cel = mix(lantern.rock.1 lantern.teal.1 .35)
let rock_line = mix(lantern.rock.line lantern.teal.line .4)
let moss_cast = mix(lantern.stone.0 lantern.teal.0 .3)
let eave_deep = mix(lantern.stone.0 lantern.teal.0 .4)
let window_deep = mix(lantern.amber.0 lantern.teal.0 .55)
let window_jamb = mix(lantern.amber.0 lantern.teal.0 .6)
let flame_root = mix(lantern.amber.0 lantern.teal .4)
let kiso_moss = mix(lantern.stone.0 lantern.moss.0 .4)
def _speckle n:20 x0:0 x1:10 y0:0 y1:10 tone:lantern.stone
  each i in 0..n
    if rand(0 1) < .6
      circle rand(1 2.6) at:rand(x0 x1),rand(y0 y1) fill:shade(tone -2) a:.35
    else
      circle rand(1 2.6) at:rand(x0 x1),rand(y0 y1) fill:shade(tone 1) a:.45
def _moss dots:20 x0:0 x1:10 y0:0 y1:10
  slot form
  copy @form at:2,5 fill:moss_cast a:.35 blur:3
  copy @form fill:lantern.moss name:pad
    copy @pad fill:grad(40 lantern.moss.3 lantern.moss,.5 lantern.moss.1)
    each i in 0..dots
      let x = rand(x0 x1)
      let y = rand(y0 y1)
      let mid = (y0+y1)/2
      let cut = x1-(x1-x0)*.3
      if y < mid and x < cut
        circle rand(1.2 2.6) at:x,y fill:lantern.moss.4 a:.6
      else
        circle rand(1.2 2.6) at:x,y fill:lantern.moss.0 a:.4
  copy @form fill:none stroke:fade(lantern.moss.line .55),1.6
def _petals y0:692 y1:714 up:1
  each x in [432 472 512 552 592]
    if up > 0
      curve x-14,y1 x-10,y0+6 x,y0 x+10,y0+6 x+14,y1 stroke:stone_line,2 taper:.2 a:.55
    else
      curve x-14,y0 x-10,y1-6 x,y1 x+10,y1-6 x+14,y0 stroke:stone_line,2 taper:.2 a:.55
def _spiral cx:252 cy:286 r0:13 turns:1.15 start:162 sign:1 n:26 w0:3.2 w1:1 ink:stone_line alpha:.8 soft:0
  each i in 0..n-1
    let denom = n-1
    let t0 = i/denom
    let t1 = (i+1)/denom
    let a0 = start+sign*t0*turns*360
    let a1 = start+sign*t1*turns*360
    let ra = r0*(1-.82*t0)
    let rb = r0*(1-.82*t1)
    let w = w0+(w1-w0)*t0
    curve (cx,cy)+polar(ra a0) (cx,cy)+polar(rb a1) stroke:ink,w a:alpha blur:soft
def _flame h:64 w:17 lean:3
  let cx = 512
  let by = 486
  curve cx,by+2 cx+w,by-h*.22 cx+w*.62+lean*.5,by-h*.6 cx+lean,by-h cx-w*.6+lean*.5,by-h*.6 cx-w,by-h*.22 closed tension:.5 fill:lantern.amber a:.6 blur:6 name:outer
  copy @outer fill:grad(down lantern.amber.3 lantern.amber,.6 lantern.amber.1)
  let ih = h*.62
  let iw = w*.55
  let il = lean*.6
  let ib = by-4
  curve cx,ib+2 cx+iw,ib-ih*.22 cx+iw*.62+il*.5,ib-ih*.6 cx+il,ib-ih cx-iw*.6+il*.5,ib-ih*.6 cx-iw,ib-ih*.22 closed tension:.5 fill:lantern.amber.4 a:.95 name:inner
    fx adjust hue:8
  let ch = h*.3
  let cw = w*.28
  let cl = lean*.3
  let cb = by-6
  curve cx,cb+2 cx+cw,cb-ch*.22 cx+cw*.62+cl*.5,cb-ch*.6 cx+cl,cb-ch cx-cw*.6+cl*.5,cb-ch*.6 cx-cw,cb-ch*.22 closed tension:.5 fill:lantern.core a:.95
  ellipse w*.5,3 at:cx,by-2 fill:flame_root a:.6 blur:1
def _firefly cx:236 cy:420 r:5
  circle r*7 at:cx,cy fill:radial(fade(lantern.firefly .8) fade(lantern.firefly .35),.3 fade(lantern.firefly 0) r:r*7) name:glow
    fx adjust sat:.3 light:-.04
  ellipse r*1.2,r*.75 at:cx+r*1.3,cy-r rot:-30 fill:lantern.teal.0
  ellipse r*1.1,r*.6 at:cx+r*1.6,cy-r*2 rot:-60 fill:fade(lantern.teal.4 .7) stroke:fade(lantern.teal.line .7),1.2
  circle r*1.15 at:cx,cy fill:lantern.firefly name:lamp
    fx adjust sat:.3 light:-.04
  circle r*.6 at:cx-r*.2,cy-r*.2 fill:lantern.hot
layer ground_shadow
  ellipse 300,34 at:512,860 fill:lantern.night a:.4 blur:16
  ellipse 220,18 at:520,856 fill:lantern.night a:.25 blur:8
layer mossy_rock pivot:512,820
  curve 296,828 318,784 370,756 440,744 520,740 600,744 668,760 716,790 734,828 704,852 620,866 512,870 404,866 326,854 closed tension:.5 fill:grad(17 lantern.rock.3 lantern.rock,.5 lantern.rock.1) name:rock
    path "M600 760 L740 790 L740 880 L520 880 L600 840 L630 800 Z" fill:rock_cel a:.85 blur:1.4
    ellipse 60,24 at:680,840 fill:lantern.rock.0 a:.4 blur:12
    ellipse 230,14 at:512,866 fill:lantern.rock.0 a:.5 blur:8
    curve 352,846 400,856 452,858 stroke:lantern.rock.4,3 taper:.35 a:.5 blur:1
    curve 612,836 640,852 stroke:lantern.rock.line,2.2 taper:.35 a:.5
    _speckle 140 x0:300 x1:730 y0:748 y1:866 tone:lantern.rock
    _moss 80 x0:306 x1:712 y0:738 y1:826
      form:
        curve 303,812 319,792 335,774 358,764 378,748 402,750 425,743 450,742 474,742 499,742 524,739 549,736 573,742 598,743 622,749 647,751 668,760 690,773 713,783 706,803 681,801 658,807 635,809 611,803 586,805 562,811 538,803 513,804 489,809 464,807 439,807 414,802 390,810 367,818 344,807 324,818 closed tension:.5 fill:none name:form
    fx rim 5 dir:1,1 color:lantern.rim a:.5
    fx grain .045 scale:2.2
    fx outline 6 color:rock_line
  assert inside(@rock canvas margin:24)
  layer pedestal pivot:512,770
    union fill:lantern.stone name:ped_shell z:behind
      curve 452,598 572,598 566,646 578,700 446,700 458,646 closed tension:.4
      curve 392,708 632,708 648,722 646,772 378,772 376,722 closed tension:.35
      curve 448,688 512,686 576,688 604,698 626,712 512,716 398,712 420,698 closed tension:.4
      curve 392,580 512,582 632,580 620,598 602,614 512,617 422,614 404,598 closed tension:.4
      curve 372,532 652,532 668,546 664,578 642,588 382,588 360,578 356,546 closed tension:.35
      fx outline 6 color:stone_line
    curve 452,598 572,598 566,646 578,700 446,700 458,646 closed tension:.4 fill:grad(0 lantern.stone.3 lantern.stone,.35 lantern.stone.1,.72 stone_cel) name:post
      path "M544 590 L590 590 L590 710 L548 710 Z" fill:stone_cel a:.6 blur:2
      ellipse 80,16 at:512,610 fill:lantern.stone.0 a:.65 blur:8
      ellipse 10,30 at:474,656 fill:lantern.stone.4 a:.35 blur:8
      _speckle 28 x0:448 x1:576 y0:600 y1:698 tone:lantern.stone
      fx rim 5 dir:1,1 color:lantern.rim a:.5
      fx grain .045 scale:2
    curve 392,708 632,708 648,722 646,772 378,772 376,722 closed tension:.35 fill:grad(13 lantern.stone.3 lantern.stone,.55 lantern.stone.1) name:kiso
      path "M360 700 L440 700 L440 790 L360 790 Z" fill:lantern.stone.3 a:.55
      path "M586 700 L660 700 L660 790 L586 790 Z" fill:stone_cel a:.9 blur:1
      ellipse 14,32 at:580,740 fill:lantern.stone.0 a:.3 blur:8
      ellipse 140,12 at:512,712 fill:lantern.stone.0 a:.5 blur:6
      ellipse 150,10 at:512,770 fill:kiso_moss a:.5 blur:6
      _speckle 70 x0:378 x1:646 y0:708 y1:772 tone:lantern.stone
      _moss 16 x0:376 x1:438 y0:728 y1:776
        form:
          curve 376,744 396,728 420,734 438,752 430,776 380,776 closed tension:.55 jitter:3 fill:none name:form
      _moss 12 x0:600 x1:650 y0:746 y1:778
        form:
          curve 600,760 626,746 650,752 650,778 604,778 closed tension:.55 jitter:3 fill:none name:form
      curve 440,712 440,768 stroke:stone_line,2.4 taper:.2 a:.5
      curve 586,712 586,768 stroke:stone_line,2.4 taper:.2 a:.5
      fx rim 5 dir:1,1 color:lantern.rim a:.5
      fx grain .045 scale:2
    curve 448,688 512,686 576,688 604,698 626,712 512,716 398,712 420,698 closed tension:.4 fill:grad(7 lantern.stone.3 lantern.stone,.55 lantern.stone.1) name:kiso_lotus
      path "M390 680 L450 680 L450 730 L390 730 Z" fill:lantern.stone.3 a:.55
      path "M574 680 L640 680 L640 730 L574 730 Z" fill:stone_cel a:.9 blur:1
      ellipse 12,13 at:568,701 fill:lantern.stone.0 a:.3 blur:8
      ellipse 70,8 at:512,690 fill:lantern.stone.0 a:.6 blur:5
      _petals 692 y1:714 up:1
      curve 398,712 512,715 626,712 stroke:stone_line,2.4 taper:.1 a:.6
      fx rim 4 dir:1,1 color:lantern.rim a:.45
      fx grain .04 scale:1.8
    curve 392,580 512,582 632,580 620,598 602,614 512,617 422,614 404,598 closed tension:.4 fill:grad(9 lantern.stone.3 lantern.stone,.55 lantern.stone.1) name:chudai_lotus
      path "M380 572 L440 572 L440 624 L380 624 Z" fill:lantern.stone.3 a:.55
      path "M584 572 L650 572 L650 624 L584 624 Z" fill:stone_cel a:.9 blur:1
      ellipse 12,18 at:578,598 fill:lantern.stone.0 a:.3 blur:8
      ellipse 130,10 at:512,584 fill:lantern.stone.0 a:.6 blur:6
      _petals 584 y1:610 up:0
