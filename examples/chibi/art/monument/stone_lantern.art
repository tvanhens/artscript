    curve 372,532 652,532 668,546 664,578 642,588 382,588 360,578 356,546 closed tension:.35 fill:grad(10 lantern.stone.3 lantern.stone,.55 lantern.stone.1) name:chudai
      path "M340 524 L430 524 L430 596 L340 596 Z" fill:lantern.stone.3 a:.55
      path "M594 524 L680 524 L680 596 L594 596 Z" fill:stone_cel a:.9 blur:1
      ellipse 14,28 at:588,560 fill:lantern.stone.0 a:.3 blur:8
      curve 374,534 650,534 664,544 512,548 360,544 closed tension:.3 fill:lantern.stone.4 a:.55 blur:1.5
      ellipse 110,8 at:512,542 fill:lantern.stone.0 a:.45 blur:5
      ellipse 86,16 at:512,552 fill:lantern.amber.3 a:.35 blur:10
      ellipse 50,9 at:512,556 fill:lantern.amber.4 a:.3 blur:6
      _speckle 80 x0:360 x1:664 y0:532 y1:588 tone:lantern.stone
      _moss 18 x0:356 x1:446 y0:532 y1:566
        form:
          curve 356,552 370,536 410,532 446,536 436,550 404,558 376,566 closed tension:.55 jitter:3 fill:none name:form
      curve 430,548 430,584 stroke:stone_line,2.4 taper:.2 a:.5
      curve 594,548 594,584 stroke:stone_line,2.4 taper:.2 a:.5
      curve 362,548 512,552 662,548 stroke:stone_line,2.2 taper:.15 a:.45
      fx rim 5 dir:1,1 color:lantern.rim a:.5
      fx grain .045 scale:2
    layer face pivot:512,646
      curve 479,644 488,650 497,644 stroke:lantern.face,3.6 taper:.4 name:eye_l
      curve 527,644 536,650 545,644 stroke:lantern.face,3.6 taper:.4 name:eye_r
      blush 20 h:10 lines:0 at:476,662 color:lantern.blush
      blush 20 h:10 lines:0 at:548,662 color:lantern.blush
      smile 10 at:512,662 color:lantern.face
      assert level(@eye_l @eye_r) tol:.5
    layer eyes_open pivot:512,646 a:0
      ellipse 5,6.5 at:488,646 fill:lantern.face
      circle 1.7 at:486.4,643.6 fill:lantern.glint
      ellipse 5,6.5 at:536,646 fill:lantern.face
      circle 1.7 at:534.4,643.6 fill:lantern.glint
    layer firebox pivot:512,544
      curve 400,322 624,322 636,336 638,530 626,546 398,546 386,530 388,336 closed tension:.35 fill:grad(41 lantern.stone.3 lantern.stone,.55 lantern.stone.1) name:box
        path "M370 310 L436 310 L436 560 L370 560 Z" fill:lantern.stone.3 a:.55
        path "M588 310 L660 310 L660 560 L588 560 Z" fill:stone_cel a:.9 blur:1
        ellipse 14,108 at:582,438 fill:lantern.stone.0 a:.3 blur:8
        path "M380 300 L650 300 L650 392 L380 392 Z" fill:grad(down fade(lantern.stone.0 .85) fade(lantern.stone.0 .85),.43 fade(lantern.stone.0 0))
        ellipse 84,80 at:512,456 fill:lantern.amber.3 blend:soft_light a:.45 blur:16
        ellipse 64,12 at:512,518 fill:lantern.amber.3 a:.3 blur:8
        ellipse 14,80 at:410,430 fill:lantern.stone.4 a:.4 blur:10
        path "M588 300 L660 300 L660 560 L588 560 Z" fill:stone_cel a:.35 blur:1
        ellipse 50,40 at:600,520 fill:lantern.stone.0 a:.3 blur:14
        _speckle 70 x0:390 x1:634 y0:326 y1:542 tone:lantern.stone
        curve 388,526 512,529 636,526 stroke:stone_line,2.2 taper:.15 a:.5
        curve 390,529 512,532 634,529 stroke:lantern.stone.4,1.6 taper:.35 a:.4 blur:.6
        curve 460,508 459,432 474,400 512,386 550,400 565,432 564,508 512,511 closed tension:.45 fill:radial(lantern.amber lantern.amber.1,.45 window_deep at:.5,.72 r:84) stroke:stone_line,3.2 name:window
          path "M440 360 L600 360 L600 410 L440 410 Z" fill:window_jamb a:.7 blur:6
          path "M450 390 L467 390 L467 514 L450 514 Z" fill:lantern.amber.3 a:.6 blur:2
          curve 497,486 527,486 530,512 494,512 closed tension:.25 fill:grad(0 lantern.cream.4 lantern.cream.3,.5 lantern.cream.1) name:candle
            ellipse 15,4 at:512,487 fill:lantern.amber.4 a:.8
          curve 497,486 527,486 530,512 494,512 closed fill:none stroke:fade(lantern.cream.line .6),1.6
          curve 512,488 512,480 stroke:lantern.wick,2.2 taper:0
        curve 464,508 512,511 560,508 stroke:lantern.amber.3,2.6 taper:.35 a:.75 blur:.8
        subtract name:moon fill:lantern.amber.3
          circle 12 at:413,444
          circle 10 at:418,439
        copy @moon fill:lantern.amber.4 a:.6 blur:2
        copy @moon fill:none stroke:stone_line,1.8 a:.8
        circle 9 at:611,444 fill:lantern.amber.3 name:sun
        copy @sun fill:lantern.amber.4 a:.6 blur:2
        copy @sun fill:none stroke:stone_line,1.8 a:.8
        curve 436,340 436,524 stroke:stone_line,2.4 taper:.2 a:.5
        curve 588,340 588,524 stroke:stone_line,2.4 taper:.2 a:.5
        fx rim 4 dir:1,1 color:lantern.rim a:.45
        fx grain .045 scale:2
        fx outline 5.5 color:stone_line
      layer glow pivot:512,452
        circle 160 at:512,452 fill:radial(fade(lantern.amber.3 .42) fade(lantern.amber .16),.45 fade(lantern.amber 0) r:160)
        inside @window
          copy @window fill:radial(fade(lantern.amber.4 .75) fade(lantern.amber.3 .3),.6 fade(lantern.amber 0) at:.5,.64 r:66)
      layer flame pivot:512,486
        _flame 64 w:17 lean:3
      layer flame_low pivot:512,486 a:0
        _flame 46 w:16 lean:-7
      layer roof pivot:512,350
        union name:hat_src fill:none
          curve 512,202 556,207 600,226 652,254 712,280 766,292 774,310 752,322 684,342 620,358 512,362 404,358 340,342 272,322 252,310 258,292 312,280 372,254 424,226 468,207 closed tension:.5
          curve 256,314 236,302 232,280 246,264 268,266 278,284 272,302 closed tension:.5
          curve 768,316 790,304 796,280 782,262 758,264 748,282 754,302 closed tension:.5
          ellipse 13,10 at:404,352
          ellipse 13,10 at:620,352
        copy @hat_src fill:grad(20 lantern.stone.3 lantern.stone,.5 lantern.stone.1) name:hat
          path "M200 180 L512 180 L512 214 L404 346 L404 420 L200 420 Z" fill:lantern.stone.3 a:.6
          path "M512 180 L820 180 L820 420 L620 420 L620 346 L512 214 Z" fill:stone_cel a:.9 blur:1
