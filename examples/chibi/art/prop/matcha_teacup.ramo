@artboard 1024x1024
@target prop/matcha_teacup.png
@target prop/matcha_teacup.svg
use face/parts { eye blush open_mouth sparkle }
palette tea
  ramp matcha #8db54a 5
  ramp jade #5f8f78 5
  ramp cream #f0e2c8 5
  ramp clay #c98b6b 5
  color blush #f2909c
  color steam #fffaf2
  color haze #cfc6d8
  color shadow #4a3530
  color ink #6b3340
  color iris #5f8f3e
  color twinkle #fff3cf
  color foam_hi #f8ffe8
  color spec #fffaf0
  color drip_hi #f4fff6
  color rim #b4cbe6
  color mist #ffffff
def _eye side:1 lid:0 look:.1,.12
  eye 86x100 iris:tea.iris side:side lid:lid look:look name:gaze
def _wisp pts:[0,0] w:[1] n:5
  curve [each p in pts -> p+(7,5)] stroke:tea.haze,w taper:.35 a:.55 blur:3
  curve pts stroke:tea.steam,w taper:.35 a:.88 blur:1.2
  curve [each i in 1..n-1 -> pts.{i}+(-2,-1)] stroke:tea.mist,[each i in 1..n-1 -> w.{i}*.35] taper:.35 a:.7 blur:1
layer ground_shadow
  ellipse 330,40 at:512,868 fill:fade(tea.shadow .38) blur:16
  ellipse 250,22 at:512,864 fill:fade(tea.shadow .22) blur:8
layer saucer pivot:512,800
  union fill:none name:saucer_form
    ellipse 300,58 at:512,812
    ellipse 306,58 at:512,796
  copy @saucer_form fill:tea.clay.1 name:saucer_shell
    ellipse 300,58 at:512,812 fill:grad(7deg tea.clay tea.clay.0)
    ellipse 306,58 at:512,796 fill:grad(12deg tea.clay.4 tea.clay.3,.3 tea.clay,.6 tea.clay.0)
    ellipse 150,26 at:640,812 fill:tea.clay.0 a:.5 blur:12
    ellipse 176,32 at:512,800 fill:tea.clay.1 a:.6 blur:1.5
    ellipse 160,24 at:512,806 fill:tea.clay.0 a:.4 blur:10
    ellipse 176,32 at:512,800 fill:none stroke:tea.clay.line,2 a:.45
    curve 380,818 512,834 640,820 stroke:tea.clay.3,3 a:.8 blur:1
    curve 300,790 360,754 470,740 stroke:tea.clay.4,5 a:.7 blur:1.5
    curve 224,806 300,838 430,852 stroke:tea.clay.4,3 a:.6 blur:1
    each k in 0..26
      let p = polar(sqrt(rand(.3 .95)) rand(0 360))
      circle rand(1.2 2.4) at:512+296*p.x,800+54*p.y fill:tea.clay.0 a:.5 name:fleck
    fx rim 4 dir:1,1 color:tea.rim a:.45
    fx grain .04 scale:2.5
    fx outline 4.5 color:tea.clay.line
  layer leaf pivot:262,832
    curve 282,826 318,806 362,810 376,822 340,840 300,840 closed fill:tea.matcha name:leaf_blade
      copy @leaf_blade fill:grad(24deg tea.matcha.3 tea.matcha.1)
      curve 288,830 330,822 372,820 stroke:tea.matcha.0,2.2 taper:.35 a:.8
    curve 282,828 268,834 260,832 stroke:tea.matcha.line,3 taper:0,.7
    fx outline 3 color:tea.matcha.line
  layer cup_body pivot:512,800
    layer handle pivot:716,600
      curve 712,548 792,548 812,616 764,684 694,700 stroke:tea.cream,[30 34 34 32 28] taper:0
        curve 719,557 799,557 819,625 771,693 701,709 stroke:mix(tea.cream.1 tea.cream.0 .5),[20 24 24 22 18] taper:0 blur:3
        ellipse 16,20 at:716,552 fill:tea.cream.0 a:.6 blur:6
        ellipse 16,20 at:700,698 fill:tea.cream.0 a:.6 blur:6
        curve 708,542 788,542 808,610 stroke:tea.cream.4,[6 8 6] taper:.3 a:.8 blur:1.5
      fx rim 4 dir:1,1 color:tea.rim a:.5
      fx outline 5 color:tea.cream.line
    union fill:none name:cup_form
      curve 722,486 734,560 712,664 660,748 590,796 512,806 434,796 364,748 312,664 290,560 302,486 512,470 closed
      ellipse 212,50 at:512,478
      curve 420,788 512,782 604,788 600,818 512,826 424,818 closed
    copy @cup_form fill:grad(38deg tea.cream.3 tea.cream,.5 tea.cream.1) name:cup_shell
      intersect fill:mix(tea.cream.1 tea.cream.0 .45) a:.95 blur:1.2
        copy @cup_form
        curve 640,470 770,520 770,830 520,840 600,760 636,640 642,540 closed
      ellipse 50,120 at:690,680 fill:tea.cream.0 a:.45 blur:22
      ellipse 60,40 at:700,760 fill:tea.clay.3 a:.35 blur:14
      ellipse 190,30 at:512,812 fill:tea.cream.0 a:.6 blur:10
      let drip = [280,470 512,440 744,470 738,528 700,546 676,590 656,552 590,562 540,548 512,600 486,552 420,560 372,552 350,584 330,546 286,530]
      intersect fill:tea.cream.0 a:.45 blur:4 at:3,7
        curve drip closed tension:.45
        copy @cup_form
      intersect fill:grad(17deg tea.jade.3 tea.jade,.45 tea.jade.1,.8 tea.jade.0) name:drip
        curve drip closed tension:.45
        copy @cup_form
      inside @cup_shell.drip
        ellipse 70,20 at:392,512 fill:tea.jade.4 a:.7 blur:8
        ellipse 18,5 at:372,506 rot:-8 fill:tea.drip_hi a:.85
      ellipse 34,62 at:370,600 fill:tea.cream.4 a:.75 blur:14
      ellipse 7,18 at:352,586 rot:18 fill:tea.spec a:.9
      ellipse 194,40 at:512,480 fill:grad(right tea.cream.0 tea.cream.1,.55 tea.cream.3)
      ellipse 180,26 at:512,470 fill:tea.cream.0 a:.4 blur:8
      ellipse 194,40 at:512,480 fill:none stroke:tea.cream.line,2.5 a:.8
      curve 334,498 420,524 520,530 stroke:tea.cream.4,4 a:.9 blur:1
      fx rim 5 dir:1,1 color:tea.rim a:.5
      fx grain .035 scale:2
      fx outline 6 color:tea.cream.line
    layer foam pivot:512,486
      intersect fill:none name:foam_top
        ellipse 190,36 at:512,490
        ellipse 194,40 at:512,480
      copy @foam_top fill:grad(9deg tea.matcha.4 tea.matcha.3,.35 tea.matcha,.75 tea.matcha.1) name:foam_fill
        let spiral = [each k in 0..70 -> polar(158-150*k/69 k*936/69-22.918)*(1,.2)+(516,492)]
        curve [each p in spiral -> p+(2,3)] stroke:tea.matcha.1,[each k in 0..70 -> 9-k/10] taper:.1,.2 a:.6 blur:1
        curve spiral stroke:tea.matcha.4,[each k in 0..70 -> 7.6-6*k/70] taper:.1,.2 a:.9
        each k in 0..18
          circle rand(1.5 3.5) at:rand(360 660),490+rand(-22 22) fill:tea.matcha.4 a:.55 name:bubble
        ellipse 40,7 at:430,476 fill:tea.foam_hi a:.7 blur:3
        fx inner 0,9 blur:5 color:tea.matcha.0
        fx grain .06 scale:1.5
      layer steam_l pivot:462,466
        _wisp [462,462 434,398 470,330 440,262 456,206] w:[6 22 26 18 4]
      layer steam_r pivot:570,466
        _wisp [570,464 598,408 566,350 590,292] w:[6 18 18 4] n:4
    layer cheeks
      each x in [368 656]
        blush 74x34 at:x,710 color:tea.blush lines:3
    layer eyes pivot:512,648
      _eye side:-1 at:420,648 name:eye_l
      _eye side:1 at:604,648 name:eye_r
      assert level(@eye_l @eye_r) tol:.5
    layer eyes_closed pivot:512,648 a:0
      _eye side:-1 lid:1 at:420,648 name:shut_l
      _eye side:1 lid:1 at:604,648 name:shut_r
    layer mouth
      open_mouth 38 at:512,698 color:tea.ink name:sip
    layer sparkle
      sparkle 56 at:300,440 color:tea.twinkle
      sparkle 30 at:748,418 color:tea.twinkle
assert inside(@saucer_shell artboard margin:24)
assert inside(@cup_shell artboard margin:24)
