@artboard 1024x1024
@target produce/sweet_strawberry.png
@target produce/sweet_strawberry.svg
use face/parts { eye blush open_mouth sparkle }
palette berry
  ramp red #e2404e 5
  ramp gold #f2c04e 5
  ramp leaf #58ad4a 5
  ramp iris #7a3a2a 5
  color blush #ff8aa6
  color plum #5a2a38
  color rim #b8c6f2
  color lip #7a2232
  color glint #fff6f0
  color twinkle #ffe39a
let red = berry.red
let gold = berry.gold
let leaf = berry.leaf
let glint = berry.glint
def _seed x:0 y:0
  let p = (x-512)/280,(y-580)/280
  let sc = 1.05-.3*min(1 sqrt(p.x*p.x+p.y*p.y))
  group at:x,y rot:p.x*28
    ellipse 10*sc,14*sc at:0,1 fill:mix(red.1 red .3) a:.7 blur:1.2
      ellipse 10*sc,14*sc at:4*sc,5*sc fill:red.3 a:.75 blur:2
    curve 0,-9*sc 4.8*sc,1 1,7.5*sc -4.4*sc,2 closed tension:.65 fill:grad(58deg gold.4 gold,.5 gold.1) stroke:fade(gold.line .55),1.2
  circle 1.4*sc at:x-1.4*sc,y-3.4*sc fill:glint a:.85
def _sepal tx:0 ty:0 width:76 ox:0 oy:0 cast:0
  let d = tx-512,ty-338
  let u = d/sqrt(d.x*d.x+d.y*d.y)
  let n = -u.y,u.x
  let sag = if ty > 298 then 1 else .3
  let c = 512+ox,338+oy
  let spec = [0,-.45 .28,-1.05 .62,-.9 .88,-.4 1,0 .86,.32 .6,.8 .3,1 0,.45]
  let pts = [each s in spec -> c+d*s.x+n*(width/2*s.y)+(0,sin(s.x*180)*14*sag)]
  if cast
    curve pts closed fill:red.0 a:.38 blur:9
  else
    let lit = n.x+n.y < 0
    let mid = [each k in [.12 .5 .86] -> (512,338)+d*k+(0,sin(k*180)*5)]
    curve pts closed fill:grad(25deg leaf.3 leaf,.5 leaf.1) stroke:fade(leaf.line .85),2.4
      ellipse 110,48 at:512,338 fill:leaf.1 a:.65 blur:10
      curve 512,338 (tx,ty)+u*10 (tx,ty)+n*60 (512,338)+n*60 closed tension:0 fill:if lit then leaf.1 else leaf.3 a:if lit then .45 else .35 blur:1.2
      curve mid stroke:fade(leaf.0 .6),[4 3 1.2] taper:.35
      curve [each q in [mid.0 mid.1] -> q-(3,4)] stroke:fade(leaf.4 .7),[2.6 1.4] taper:.35 blur:.6
def _sepals ox:0 oy:0 cast:0
  each s in [44824676 59024476 35028888 68428688 29240486 74240286 58442870 45243270]
    _sepal floor(s/100000) floor(mod(s 100000)/100) mod(s 100) ox:ox oy:oy cast:cast
def _dew x:418 y:772 r:15
  let d = [x,y-r*1.5 x+r*.9,y+r*.1 x+r*.5,y+r*.9 x-r*.5,y+r*.9 x-r*.9,y+r*.1]
  curve [each q in d -> q+(4,6)] closed tension:.6 fill:red.0 a:.45 blur:3
  curve d closed tension:.6 fill:fade(red.4 .5)
    curve d closed tension:.6 fill:grad(45deg fade(red.1 0) red.4) a:.7
    ellipse r*1.05,r*.62 at:x+r*.08,y+r*.48 fill:mix(glint red.4 .22) a:.62 blur:3.5
  curve d closed tension:.6 fill:none stroke:fade(red.line .4),1.4
  ellipse r*.22,r*.4 at:x-r*.35,y-r*.2 rot:20 fill:glint a:.95
def _eye x:436 side:-1 lid:.18 w:72 h:86
  eye w,h iris:berry.iris side:side look:-.3,.35 lid:lid at:x,592 name:gaze
layer ground_shadow
  ellipse 250,34 at:512,878 fill:berry.plum a:.36 blur:16
  ellipse 150,18 at:500,872 fill:berry.plum a:.25 blur:8
layer body pivot:506,846
  curve 300,356 404,318 512,334 626,316 728,352 792,440 790,560 738,680 648,782 562,840 504,852 452,834 370,772 290,672 238,556 240,438 closed fill:grad(46deg red.3 red,.45 mix(red red.1 .6),.85 red.1) name:skin
    intersect fill:mix(red.1 red .1) a:.95 blur:1.6
      copy @skin
      curve 712,330 850,420 840,720 640,890 440,890 570,790 664,660 702,500 closed
    ellipse 40,150 at:770,600 fill:mix(red.1 red.0 .4) a:.6 blur:22
    ellipse 200,60 at:560,860 fill:red.1 a:.5 blur:26
    ellipse 230,46 at:512,336 fill:red.0 a:.7 blur:16
    ellipse 120,110 at:380,470 fill:red.3 a:.45 blur:40
    ellipse 90,30 at:620,800 fill:mix(red.3 gold.3 .4) a:.25 blur:14
    each s in [311,426 366,424 420,426 472,426 528,422 581,422 633,421 691,423 746,426 285,461 336,462 392,460 444,463 499,460 549,460 606,463 660,460 714,461 772,464 255,501 310,501 368,502 421,501 476,499 522,497 578,497 632,502 685,499 746,499 285,538 336,539 391,538 660,540 717,539 769,539 310,579 685,575 744,574 280,615 333,616 713,612 314,649 688,652 334,688 388,691 664,689 365,730 419,727 474,726 528,726 579,728 637,729 449,765 502,768 551,765 604,764 471,802 527,807 579,802]
      _seed s.x s.y
    _sepals ox:8 oy:16 cast:1
    curve 276,470 300,412 346,376 392,368 366,396 326,446 296,520 closed fill:red.4 a:.6 blur:7
    curve 282,476 296,428 328,392 366,374 376,386 340,414 310,452 298,486 closed tension:.6 fill:glint a:.92 blur:.7
    circle 7 at:290,512 fill:glint a:.88
    _dew
    ellipse 30,10 at:690,430 rot:40 fill:red.4 a:.45 blur:5
    fx inner -8,-8 blur:8 color:red.0
    fx rim 5 dir:1,1 color:berry.rim a:.5
    fx grain .03 scale:1.8
    fx outline 6.5 color:red.line
  assert inside(@skin artboard margin:24)
  layer cheeks
    each x in [378 646]
      blush 86x40 at:x,648 color:berry.blush lines:3
      blush 56x24 at:x,648 color:berry.blush lines:0
  layer eyes pivot:512,592
    _eye name:eye_l
    _eye 588 side:1 name:eye_r
    assert level(@eye_l @eye_r) tol:.5
  layer eyes_closed pivot:512,592 a:0
    _eye lid:1 w:70 h:84 name:shut_l
    _eye 588 side:1 lid:1 w:70 h:84 name:shut_r
  layer mouth
    open_mouth at:512,642 color:berry.lip name:bite
  layer calyx pivot:512,338
    group name:crown
      _sepals
      curve 470,324 512,310 556,322 564,350 512,364 462,350 closed fill:grad(31deg leaf.3 leaf.1) stroke:fade(leaf.line .7),2.2
        ellipse 50,14 at:512,356 fill:leaf.0 a:.5 blur:6
      fx rim 3 dir:1,1 color:berry.rim a:.4
      fx outline 4.5 color:leaf.line
    layer stem pivot:512,336
      let stem = [512,344 508,300 514,258 536,228 570,216 596,230 598,258 576,270 558,256]
      let sw = [28 26 23 19 15 12 10 8 6]
      curve stem stroke:leaf,sw taper:0,.25
        curve [each q in stem -> q+(5,3)] stroke:leaf.1,[each w in sw -> w*.6] taper:0,.3 blur:2
        curve [each q in [stem.0 stem.1 stem.2 stem.3 stem.4] -> q-(4,2)] stroke:leaf.4,[5 5 4 3 2] taper:.35 a:.75 blur:1
      fx outline 4 color:leaf.line
  layer sparkle
    sparkle 52 at:232,300 color:berry.twinkle
    sparkle 30 at:812,520 color:berry.twinkle
    sparkle 22 at:780,250 color:berry.twinkle
