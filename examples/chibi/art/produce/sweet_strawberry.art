@target produce/sweet_strawberry.png 1024x1024
@target produce/sweet_strawberry.svg 1024x1024
use face/parts { blush sparkle }
palette berry
  red ramp #e2404e 5
  gold ramp #f2c04e 5
  leaf ramp #58ad4a 5
  iris ramp #7a3a2a 5
  blush #ff8aa6
  plum #5a2a38
  rim #b8c6f2
  lip #7a2232
  glint #fff6f0
  twinkle #ffe39a
# House eye with the upper lid lowered, the shy squint from the original.
def _shy_eye w:68 h:80 iris:berry.iris side:1 look:0,0
  group scale:side*w/68,h/80
    curve -32,2.4 -22,-16.4 -6,-26.3 12,-26.3 27,-17.3 34,-5 32,11 22,30 3,39 -16,34 -29,18 closed fill:p.sclera name:white
      copy @white fill:grad(down p.sclera_shade fade(p.sclera_shade 0),.37) a:.8
      ellipse 22.4,34.4 at:look.x*8.8,4+look.y*5.6 fill:grad(down shade(iris -2) shade(iris -1),.38 iris,.72 shade(iris 1)) stroke:fade(line(iris) .9),2 name:disc
        ellipse 25.8,14.4 at:0,-26.8 fill:line(iris) a:.6 blur:2.8
        ellipse 16.1,10.3 at:0,21.3 fill:shade(iris 2) a:.8 blur:3.2 blend:screen
        ellipse 7.6,15.1 at:0,-1.4 fill:mix(line(iris) p.ink .4) a:.92 blur:.5
        curve -13.9,17.9 0,27.5 13.9,17.9 stroke:shade(iris 2),1.2 a:.55
        ellipse 9.6,11.6 at:-6.7*side,-12.4 rot:-25*side fill:p.glint a:.25 blur:1.4
        ellipse 7.6,9.6 at:-6.7*side,-12.4 rot:-25*side fill:p.glint
        circle 3.1 at:8.5*side,15.1 fill:p.glint a:.95
        circle 1.3 at:-2.2*side,6.9 fill:p.glint a:.7
      copy @white fill:grad(down fade(line(iris) .45) fade(line(iris) 0),.24) blend:multiply
    curve -32.6,4.6 -22.4,-17.1 -6.1,-26.9 12.2,-26.9 26.5,-17.8 34,-5.3 40.8,-18.4 stroke:p.ink,[1.4 3.4 5.1 6.5 7.1 6.1 1.4] taper:.12,.16
    curve 33.3,-.6 37.4,.2 39.8,3.4 stroke:p.ink,2.7 taper:0,.85
    curve -10.2,38 6.8,38.8 21.1,31.2 stroke:p.ink,2 taper:.4 a:.45
def _closed_eye cx:436 side:-1
  let hw = 35
  let hh = 42
  let cy = 592
  let w = 70
  let lash = mix(line(berry.iris) p.ink .7)
  curve cx+side*-.98*hw,cy+.02*hh cx+side*-.52*hw,cy+.4*hh cx+side*.06*hw,cy+.52*hh cx+side*.6*hw,cy+.34*hh cx+side*.98*hw,cy-.02*hh cx+side*1.16*hw,cy-.2*hh stroke:lash,[w*.03 w*.1 w*.13 w*.12 w*.08 w*.025] taper:.15,.3
  curve cx+side*.5*hw,cy+.38*hh cx+side*.57*hw,cy+.52*hh cx+side*.6*hw,cy+.66*hh stroke:lash,w*.045 taper:0,.8
  curve cx+side*.74*hw,cy+.25*hh cx+side*.84*hw,cy+.365*hh cx+side*.9*hw,cy+.48*hh stroke:lash,w*.045 taper:0,.8
def _open_mouth
  let cx = 512
  let cy = 642
  let w = 30
  curve cx-w/2,cy cx,cy+w*.06 cx+w/2,cy cx+w*.36,cy+w*.34 cx,cy+w*.56 cx-w*.36,cy+w*.34 closed tension:.45 fill:p.mouth name:lips
    ellipse w*.3,w*.2 at:cx+w*.04,cy+w*.52 fill:p.tongue
  curve cx-w/2,cy cx,cy+w*.06 cx+w/2,cy cx+w*.36,cy+w*.34 cx,cy+w*.56 cx-w*.36,cy+w*.34 closed tension:.45 fill:none stroke:berry.lip,w*.05
def _seed x:0 y:0
  let dx = (x-512)/280
  let dy = (y-580)/280
  let ang = dx*28
  let sc = 1.05-.3*min(1 sqrt(dx*dx+dy*dy))
  group at:x,y rot:ang
    ellipse 10*sc,14*sc at:0,1 fill:mix(berry.red.1 berry.red .3) a:.7 blur:1.2
      ellipse 10*sc,14*sc at:4*sc,5*sc fill:berry.red.3 a:.75 blur:2
    curve 0,-9*sc 4.8*sc,1 1,7.5*sc -4.4*sc,2 closed tension:.65 fill:grad(58deg berry.gold.4 berry.gold,.5 berry.gold.1) stroke:fade(berry.gold.line .55),1.2
  circle 1.4*sc at:x-1.4*sc,y-3.4*sc fill:berry.glint a:.85
# One sepal of the crown. `cast` paints the berry's shoulder shadow instead of the leaf.
def _sepal tx:0 ty:0 width:76 ox:0 oy:0 cast:0
  let dx = tx-512
  let dy = ty-338
  let len = sqrt(dx*dx+dy*dy)
  let ux = dx/len
  let uy = dy/len
  let nx = -uy
  let ny = ux
  let hw = width/2
  let sag = if ty > 298 then 1 else .3
  let p0 = 512+ox+nx*-hw*.45,338+oy+ny*-hw*.45
  let p1 = 512+ox+dx*.28+nx*-hw*1.05,338+oy+dy*.28+ny*-hw*1.05+sin(.28*180)*14*sag
  let p2 = 512+ox+dx*.62+nx*-hw*.9,338+oy+dy*.62+ny*-hw*.9+sin(.62*180)*14*sag
  let p3 = 512+ox+dx*.88+nx*-hw*.4,338+oy+dy*.88+ny*-hw*.4+sin(.88*180)*14*sag
  let p4 = tx+ox,ty+oy
  let p5 = 512+ox+dx*.86+nx*hw*.32,338+oy+dy*.86+ny*hw*.32+sin(.86*180)*14*sag
  let p6 = 512+ox+dx*.6+nx*hw*.8,338+oy+dy*.6+ny*hw*.8+sin(.6*180)*14*sag
  let p7 = 512+ox+dx*.3+nx*hw,338+oy+dy*.3+ny*hw+sin(.3*180)*14*sag
  let p8 = 512+ox+nx*hw*.45,338+oy+ny*hw*.45
  if cast
    curve p0 p1 p2 p3 p4 p5 p6 p7 p8 closed fill:berry.red.0 a:.38 blur:9
  else
    let lit = nx*-.7+ny*-.7 > 0
    let side_color = if lit then berry.leaf.1 else berry.leaf.3
    let side_a = if lit then .45 else .35
    let m0 = 512+dx*.12,338+dy*.12+sin(.12*180)*5
    let m1 = 512+dx*.5,338+dy*.5+sin(.5*180)*5
    let m2 = 512+dx*.86,338+dy*.86+sin(.86*180)*5
    curve p0 p1 p2 p3 p4 p5 p6 p7 p8 closed fill:grad(25deg berry.leaf.3 berry.leaf,.5 berry.leaf.1) stroke:fade(berry.leaf.line .85),2.4 name:blade
      ellipse 110,48 at:512,338 fill:berry.leaf.1 a:.65 blur:10
      curve 512,338 tx+ux*10,ty+uy*10 tx+nx*60,ty+ny*60 512+nx*60,338+ny*60 closed tension:0 fill:side_color a:side_a blur:1.2
      curve m0 m1 m2 stroke:fade(berry.leaf.0 .6),[4 3 1.2] taper:.35
      curve m0+(-3,-4) m1+(-3,-4) stroke:fade(berry.leaf.4 .7),[2.6 1.4] taper:.35 blur:.6
def _sepals ox:0 oy:0 cast:0
  _sepal 448 246 76 ox:ox oy:oy cast:cast
  _sepal 590 244 76 ox:ox oy:oy cast:cast
  _sepal 350 288 88 ox:ox oy:oy cast:cast
  _sepal 684 286 88 ox:ox oy:oy cast:cast
  _sepal 292 404 86 ox:ox oy:oy cast:cast
  _sepal 742 402 86 ox:ox oy:oy cast:cast
  _sepal 584 428 70 ox:ox oy:oy cast:cast
  _sepal 452 432 70 ox:ox oy:oy cast:cast
def _dew x:418 y:772 r:15
  curve x+4,y-r*1.5+6 x+r*.9+4,y+r*.1+6 x+r*.5+4,y+r*.9+6 x-r*.5+4,y+r*.9+6 x-r*.9+4,y+r*.1+6 closed tension:.6 fill:berry.red.0 a:.45 blur:3
  curve x,y-r*1.5 x+r*.9,y+r*.1 x+r*.5,y+r*.9 x-r*.5,y+r*.9 x-r*.9,y+r*.1 closed tension:.6 fill:fade(berry.red.4 .5) name:drop
    curve x,y-r*1.5 x+r*.9,y+r*.1 x+r*.5,y+r*.9 x-r*.5,y+r*.9 x-r*.9,y+r*.1 closed tension:.6 fill:grad(45deg fade(berry.red.1 0) berry.red.4) a:.7
    ellipse r*1.05,r*.62 at:x+r*.08,y+r*.48 fill:mix(berry.glint berry.red.4 .22) a:.62 blur:3.5
  curve x,y-r*1.5 x+r*.9,y+r*.1 x+r*.5,y+r*.9 x-r*.5,y+r*.9 x-r*.9,y+r*.1 closed tension:.6 fill:none stroke:fade(berry.red.line .4),1.4
  ellipse r*.22,r*.4 at:x-r*.35,y-r*.2 rot:20 fill:berry.glint a:.95
layer ground_shadow
  ellipse 250,34 at:512,878 fill:berry.plum a:.36 blur:16
  ellipse 150,18 at:500,872 fill:berry.plum a:.25 blur:8
layer body pivot:506,846
  curve 300,356 404,318 512,334 626,316 728,352 792,440 790,560 738,680 648,782 562,840 504,852 452,834 370,772 290,672 238,556 240,438 closed fill:grad(46deg berry.red.3 berry.red,.45 mix(berry.red berry.red.1 .6),.85 berry.red.1) name:skin
    intersect fill:mix(berry.red.1 berry.red .1) a:.95 blur:1.6
      copy @skin
      curve 712,330 850,420 840,720 640,890 440,890 570,790 664,660 702,500 closed
    ellipse 40,150 at:770,600 fill:mix(berry.red.1 berry.red.0 .4) a:.6 blur:22
    ellipse 200,60 at:560,860 fill:berry.red.1 a:.5 blur:26
    ellipse 230,46 at:512,336 fill:berry.red.0 a:.7 blur:16
    ellipse 120,110 at:380,470 fill:berry.red.3 a:.45 blur:40
    ellipse 90,30 at:620,800 fill:mix(berry.red.3 berry.gold.3 .4) a:.25 blur:14
    # Baked from the original lattice. A draw cannot test contains, and the body rng jitters each pit.
    each s in [311.2,426 366,424.5 419.5,425.9 471.9,425.8 528,422.1 580.9,422 632.9,421.2 690.8,422.7 745.8,425.6 285.1,461.2 336,461.6 392.2,460 444.1,463.3 498.9,459.7 549.4,460.3 605.5,463.2 659.8,460.2 713.6,461.4 771.5,464.5 255.4,500.7 310.1,501.4 367.7,502.4 421.3,501 475.8,498.9 522.5,497 577.8,497.1 632,502 684.9,499 745.9,499.3 284.6,538.1 335.9,539 391,537.9 659.7,539.6 716.8,538.8 768.8,539 309.5,578.7 685.1,574.9 744,573.8 279.5,614.6 333,615.5 712.9,611.9 313.9,649.4 688.1,651.5 333.8,688 388.1,690.6 664.3,689.4 365.1,730.3 419.2,727.3 473.6,726.5 527.7,726.3 578.6,728.3 636.6,729.1 448.8,764.7 502.2,767.9 550.8,764.8 604.3,764 470.9,801.7 527.1,806.8 579.1,802.5]
      _seed s.x s.y
    _sepals ox:8 oy:16 cast:1
    curve 276,470 300,412 346,376 392,368 366,396 326,446 296,520 closed fill:berry.red.4 a:.6 blur:7
    curve 282,476 296,428 328,392 366,374 376,386 340,414 310,452 298,486 closed tension:.6 fill:berry.glint a:.92 blur:.7
    circle 7 at:290,512 fill:berry.glint a:.88
    _dew
    ellipse 30,10 at:690,430 rot:40 fill:berry.red.4 a:.45 blur:5
    fx inner -8,-8 blur:8 color:berry.red.0
    fx rim 5 dir:1,1 color:berry.rim a:.5
    fx grain .03 scale:1.8
    fx outline 6.5 color:berry.red.line
  assert inside(@skin canvas margin:24)
  layer cheeks
    blush 86 h:40 at:378,648 color:berry.blush lines:3
    blush 56 h:24 at:378,648 color:berry.blush lines:0
    blush 86 h:40 at:646,648 color:berry.blush lines:3
    blush 56 h:24 at:646,648 color:berry.blush lines:0
  layer eyes pivot:512,592
    _shy_eye 72 h:86 at:436,592 side:-1 look:-.3,.35 name:eye_l
    _shy_eye 72 h:86 at:588,592 side:1 look:-.3,.35 name:eye_r
    assert level(@eye_l @eye_r) tol:.5
  # Blink alternate. Hidden in the still.
  layer eyes_closed pivot:512,592 a:0
    _closed_eye 436 side:-1
    _closed_eye 588 side:1
  layer mouth
    _open_mouth
  layer calyx pivot:512,338
    group name:crown
      _sepals
      curve 470,324 512,310 556,322 564,350 512,364 462,350 closed fill:grad(31deg berry.leaf.3 berry.leaf.1) stroke:fade(berry.leaf.line .7),2.2
        ellipse 50,14 at:512,356 fill:berry.leaf.0 a:.5 blur:6
      fx rim 3 dir:1,1 color:berry.rim a:.4
      fx outline 4.5 color:berry.leaf.line
    layer stem pivot:512,336
      curve 512,344 508,300 514,258 536,228 570,216 596,230 598,258 576,270 558,256 stroke:berry.leaf,[28 26 23 19 15 12 10 8 6] taper:0,.25
        curve 517,347 513,303 519,261 541,231 575,219 601,233 603,261 581,273 563,259 stroke:berry.leaf.1,[16.8 15.6 13.8 11.4 9 7.2 6 4.8 3.6] taper:0,.3 blur:2
        curve 508,342 504,298 510,256 532,226 566,214 stroke:berry.leaf.4,[5 5 4 3 2] taper:.35 a:.75 blur:1
      fx outline 4 color:berry.leaf.line
  layer sparkle
    sparkle 26 at:232,300 color:berry.twinkle
    sparkle 15 at:812,520 color:berry.twinkle
    sparkle 11 at:780,250 color:berry.twinkle
