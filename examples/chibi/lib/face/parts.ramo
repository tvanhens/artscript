# Chibi face parts tuned for the house style. Highlights sit upper left on both eyes, so `side`
# flips the eye shape and lashes but not the glints.

# `lid` 0..1 lowers the upper lid toward .45 of the half height, and 1 draws the closed lash.
# The sclera gradients stay pinned to the open eye's top (75 tall, top drops 54 at lid 1), so a
# lowered lid covers them instead of restarting them under the lash.
def eye size:68x80 iris:p.iris side:1 look:0,0 lid:0
  let lash = mix(line(iris) p.ink .7)
  let shut = if lid >= 1 then 1 else 0
  group scale:side*size.w/68,size.h/80
    group a:shut
      curve -33.32,.8 -17.68,16 2.04,20.8 20.4,13.6 33.32,-.8 39.44,-8 stroke:lash,[2.04 6.8 8.84 8.16 5.44 1.7] taper:.15,.3
      curve 17,15.2 19.38,20.8 20.4,26.4 stroke:lash,3.06 taper:0,.8
      curve 25.16,10 28.56,14.6 30.6,19.2 stroke:lash,3.06 taper:0,.8
    group a:1-shut
      curve -32,-1+lid*19 -22,-24+lid*42 -6,-36+lid*54 12,-36+lid*54 27,-25+lid*43 34,-10+lid*28 32,11 22,30 3,39 -16,34 -29,18 closed fill:p.sclera name:white
        copy @white fill:grad(down fade(p.sclera_shade clamp(1-lid*54/27.75 0 1)) fade(p.sclera_shade 0),clamp((27.75-lid*54)/(75-lid*54) 0 1)) a:.8
        ellipse 22.4,34.4 at:look.x*8.8,4+look.y*5.6 fill:grad(down shade(iris -2) shade(iris -1),.38 iris,.72 shade(iris 1)) stroke:fade(line(iris) .9),2 name:disc
          ellipse 25.8,14.4 at:0,-26.8 fill:line(iris) a:.6 blur:2.8
          ellipse 16.1,10.3 at:0,21.3 fill:shade(iris 2) a:.8 blur:3.2 blend:screen
          ellipse 7.6,15.1 at:0,-1.4 fill:mix(line(iris) p.ink .4) a:.92 blur:.5
          curve -13.9,17.9 0,27.5 13.9,17.9 stroke:shade(iris 2),1.2 a:.55
          ellipse 9.6,11.6 at:-6.7*side,-12.4 rot:-25*side fill:p.eye_glint a:.25 blur:1.4
          ellipse 7.6,9.6 at:-6.7*side,-12.4 rot:-25*side fill:p.eye_glint
          circle 3.1 at:8.5*side,15.1 fill:p.eye_glint a:.95
          circle 1.3 at:-2.2*side,6.9 fill:p.eye_glint a:.7
        copy @white fill:grad(down fade(line(iris) .45*clamp(1-lid*3 0 1)) fade(line(iris) 0),clamp((18-lid*54)/(75-lid*54) 0 1)) blend:multiply
      curve -32.6,1.6+lid*18.8 -22.4,-24.8+lid*42 -6.1,-36.8+lid*54 12.2,-36.8+lid*54 26.5,-25.6+lid*42.8 34,-10.4+lid*27.6 40.8,-18.4+lid*27.6 stroke:lash,[1.4 3.4 5.1 6.5 7.1 6.1 1.4] taper:.12,.16
      curve 33.3,-5.6+lid*27.6 37.4,-4.8+lid*27.6 39.8,-1.6+lid*27.6 stroke:lash,2.7 taper:0,.85
      curve -10.2,38 6.8,38.8 21.1,31.2 stroke:lash,2 taper:.4 a:.45

# Content `^ ^` arc.
def happy_eye size:68 color:p.ink
  curve -size*.5,size*.16 -size*.22,-size*.17 size*.1,-size*.2 size*.5,size*.12 stroke:color,[size*.044 size*.147 size*.147 size*.044] taper:.3,.35

def blush size:72x32 color:p.blush lines:3
  ellipse 50%,50% fill:color a:.6 blur:min(size.w size.h)*.2
  each k in 0..lines
    let x = (k-(lines-1)/2)*size.w*.22
    curve x-size.w*.05,size.h*.18 x+size.w*.05,-size.h*.18 stroke:shade(color -1),size.w*.045 taper:.5 a:.7

def cat_mouth size:46 color:p.ink
  mirror x
    curve 0,-size*.04 size*.25,size*.22 size*.5,-size*.02 stroke:color,[size*.04 size*.08 size*.04] taper:.35

def smile size:40 color:p.ink
  curve -size/2,-size*.06 0,size*.2 size/2,-size*.06 stroke:color,[size*.05 size*.09 size*.05] taper:.35

# A shape's stroke paints under its children, so the lip line is a copy drawn after the tongue.
def open_mouth size:30 color:p.ink
  curve -size/2,0 0,size*.06 size/2,0 size*.36,size*.34 0,size*.56 -size*.36,size*.34 closed tension:.45 fill:p.mouth name:lips
    ellipse size*.3,size*.2 at:size*.04,size*.52 fill:p.tongue
  copy @lips fill:none stroke:color,size*.05

# Round `o` yawn with a tongue.
def o_mouth size:36 color:p.ink
  curve 0,-size*.3 size*.26,size*.02 0,size*.36 -size*.26,size*.02 closed fill:p.mouth name:lips
    ellipse size*.2,size*.13 at:0,size*.3 fill:p.tongue
  copy @lips fill:none stroke:color,size*.06

# Four-point twinkle with a soft glow. Each side is a quadratic pulled toward the center.
def sparkle size:40 color:p.glint glow:.35
  circle 22.5% fill:color a:glow blur:size*.15
  path "M0 -100Q9 -9 100 0Q9 9 0 100Q-9 9 -100 0Q-9 -9 0 -100Z" scale:size/200 fill:color
