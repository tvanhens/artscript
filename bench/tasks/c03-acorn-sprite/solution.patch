--- /dev/null
+++ b/art/character/acorn_sprite.art
@@ -0,0 +1,143 @@
+@target character/acorn_sprite.png 1024x1024
+use face/parts { eye blush smile sparkle }
+use shade/cel { cel }
+palette acorn
+  ramp nut #c4844a 5
+  ramp cap #8f7048 5
+  ramp stalk #7c5434 5
+  ramp leaf #86b04a 5
+  color shadow #3f3026
+  color rim #b8c8e8
+  color blush #f2967e
+  color mouth #7a3428
+  color glint #fff6e6
+  color iris #5f8a3a
+  color star #fff3cf
+let nut = acorn.nut
+let cap = acorn.cap
+let stalk = acorn.stalk
+let leaf = acorn.leaf
+let rim = acorn.rim
+let glint = acorn.glint
+let nut_line = mix(nut.line nut.0 .45)
+let cap_line = mix(cap.line cap.0 .4)
+let stalk_line = mix(stalk.line stalk.0 .3)
+def _arm side:1
+  group at:512,0 scale:side,1
+    curve -208,650 -246,652 -276,674 -290,708 -280,736 -252,738 -226,716 -208,690 closed fill:grad(90-40*side nut.3 nut,.45 nut.1) name:hand
+      cel @hand tone:nut shift:-10*side,-10
+      ellipse 18,10 at:-251-11*side,676 rot:-30*side fill:nut.4 a:.6 blur:5
+      curve -270,728 -254,732 -238,722 stroke:nut.0,[1 2 1] taper:.35 a:.5
+def _foot side:1
+  group at:512,0 scale:side,1
+    curve -120,884 -116,856 -94,840 -60,838 -34,850 -28,874 -44,892 -102,894 closed fill:grad(90-30*side stalk.3 stalk,.45 stalk.1) name:boot
+      cel @boot tone:stalk shift:-10*side,-10
+      ellipse 22,8 at:-84,852 fill:stalk.4 a:.5 blur:4
+      curve -110,880 -76,888 -42,882 stroke:stalk.0,[1 2.5 1] taper:.35 a:.5
+def _cap_scale tilt:0 width:1 height:1
+  group rot:tilt scale:width,height
+    curve -22,-14 0,-18 22,-14 18,6 0,22 -18,6 closed fill:grad(down cap.3 cap,.55 cap.1) stroke:fade(cap_line .55),1.5
+      curve -12,12 0,20 12,12 stroke:cap.0,[1 3 1] taper:.35 a:.5
+    curve -14,-10 0,-14 12,-11 stroke:cap.4,[1 2.5 1] taper:.35 a:.6
+layer ground_shadow
+  ellipse 240,28 at:512,894 fill:acorn.shadow a:.36 blur:14
+  ellipse 150,14 at:512,892 fill:acorn.shadow a:.25 blur:7
+  ellipse 46,9 at:780,890 fill:acorn.shadow a:.3 blur:5
+layer clover
+  curve 778,892 784,866 778,836 stroke:leaf.1,[7 5.5 4] taper:0,.4
+  each angle in [-62 0 62]
+    group at:778,836 rot:angle scale:1.3
+      curve 0,0 -14,-10 -17,-24 -7,-31 0,-23 7,-31 17,-24 14,-10 closed fill:grad(50 leaf.3 leaf,.5 leaf.1)
+        ellipse 12,7 at:5,-6 fill:leaf.0 a:.4 blur:4
+        ellipse 5,3 at:-8,-22 rot:-30 fill:leaf.4 a:.7 blur:1.5
+      curve 0,-3 0,-20 stroke:leaf.0,[1.6 .6] taper:0,.6 a:.5
+  fx rim 2.5 dir:1,1 color:rim a:.4
+  fx outline 3 color:mix(leaf.line leaf.0 .4)
+layer foot_left
+  _foot side:1 name:foot_l
+  fx rim 3 dir:1,1 color:rim a:.4
+  fx outline 4.5 color:stalk_line
+layer foot_right
+  _foot side:-1 name:foot_r
+  fx rim 3 dir:1,1 color:rim a:.4
+  fx outline 4.5 color:stalk_line
+layer arm_left
+  _arm side:1 name:arm_l
+  fx rim 3 dir:1,1 color:rim a:.4
+  fx grain .04 scale:2
+  fx outline 4.5 color:nut_line
+layer arm_right
+  _arm side:-1 name:arm_r
+  fx rim 3 dir:1,1 color:rim a:.4
+  fx grain .04 scale:2
+  fx outline 4.5 color:nut_line
+layer leaf
+  group at:504,240 rot:22 scale:1.35
+    curve 0,0 -14,-20 -34,-26 -44,-44 -64,-40 -76,-56 -96,-50 -112,-58 -126,-40 -112,-26 -104,-8 -84,-12 -72,4 -52,-2 -40,12 -20,6 closed fill:grad(40 leaf.3 leaf,.5 leaf.1) name:blade
+      cel @blade tone:leaf shift:-4,-6 core:.2
+      curve -2,0 -40,-14 -80,-26 -120,-38 stroke:leaf.0,[3 2.5 1.6 .8] taper:0,.5 a:.75
+      each vein in [-36,-12 -64,-20 -94,-30]
+        curve vein vein+(-8,-16) stroke:leaf.0,[1.6 .6] taper:0,.6 a:.5
+        curve vein vein+(-12,14) stroke:leaf.0,[1.6 .6] taper:0,.6 a:.5
+      ellipse 24,6 at:-60,-34 rot:20 fill:leaf.4 a:.7 blur:2.4
+  fx rim 3 dir:1,1 color:rim a:.4
+  fx outline 4 color:mix(leaf.line leaf.0 .4)
+layer stem
+  let stalk_path = [512,250 509,214 516,186 534,166 558,158]
+  curve stalk_path stroke:stalk,[30 25 20 16 13] taper:0,.3 name:stalk
+    curve [each point in stalk_path -> point+(6,3)] stroke:stalk.0,[16 13 10 8 6] taper:0,.4 a:.6 blur:2
+    curve [each point in stalk_path -> point-(5,2)] stroke:stalk.4,[7 6 5 4 2] taper:.3 a:.7 blur:1
+  ellipse 6,7 at:559,158 rot:-20 fill:grad(down stalk.4 stalk.3)
+    circle 2.2 at:559,158 fill:stalk.1 a:.6
+  fx outline 4.5 color:stalk_line
+layer body
+  curve 498,846 512,880 526,846 closed tension:.4 fill:grad(down nut.1 nut.0) name:tip
+  curve 512,354 640,368 722,436 748,540 734,654 686,756 606,826 512,856 418,826 338,756 290,654 276,540 302,436 384,368 closed fill:grad(42 nut.3 nut,.45 nut.1) name:nut
+    cel @nut tone:nut shift:-40,-30 core:.3
+    ellipse 240,46 at:512,476 fill:nut.0 a:.55 blur:16
+    ellipse 90,120 at:396,560 fill:nut.3 a:.5 blur:34
+    ellipse 160,40 at:512,830 fill:nut.0 a:.4 blur:14
+    ellipse 40,130 at:716,640 fill:nut.0 a:.35 blur:20
+    ellipse 70,50 at:380,770 fill:nut.3 a:.3 blur:28
+    curve 738,560 726,672 682,764 606,830 stroke:nut.0,[2 6 7 4 1] taper:.3 a:.45 blur:1.5
+    each offset in [-176 -136 136 176]
+      curve 512+offset,470 512+offset*1.06,620 512+offset*.7,760 512+offset*.2,846 stroke:nut.1,[1 3 2.5 1] taper:.3 a:.3
+    curve 318,520 304,600 320,690 stroke:glint,[2 7 4] taper:.4 a:.7 blur:1
+    circle 6 at:330,486 fill:glint a:.8
+  fx rim 5 dir:1,1 color:rim a:.45
+  fx grain .04 scale:2
+  fx outline 6 color:nut_line
+layer crown
+  curve 512,212 652,230 740,288 776,362 780,412 760,438 700,456 606,468 512,472 418,468 324,456 264,438 244,412 248,362 284,288 372,230 closed fill:grad(40 cap.3 cap,.45 cap.1) name:cap
+    each band in 0..7
+      let lat = 90-band*11
+      each step in 0..17
+        let swing = step*10-80+mod(band 2)*5
+        if swing <= 80
+          _cap_scale -swing*.35 width:max(cos(swing) .45)*sin(lat) height:sin(lat) at:512+264*sin(lat)*sin(swing),452-240*cos(lat)+18*sin(lat)*cos(swing)
+    cel @cap tone:cap shift:-34,-26
+    subtract fill:cap.3 a:.9
+      copy @cap
+      copy @cap at:0,-18
+    curve 272,436 400,458 512,464 624,458 752,436 stroke:cap.4,[1 3 4 3 1] taper:.35 a:.6
+    ellipse 80,40 at:400,300 rot:-30 fill:cap.4 a:.4 blur:22
+  fx rim 5 dir:1,1 color:rim a:.45
+  fx grain .05 scale:1.8
+  fx outline 6 color:cap_line
+layer cheeks
+  each side in [-1 1]
+    blush 74x32 at:512+162*side,664 color:acorn.blush lines:3
+    blush 48x20 at:512+162*side,664 color:acorn.blush lines:0
+layer eyes
+  each side in [-1 1]
+    curve 512+128*side,520 512+100*side,506 512+66*side,512 stroke:fade(nut_line .8),[2 5 2] taper:.35
+  eye 90x100 iris:acorn.iris side:-1 look:0,.35 lid:.15 at:418,592 name:eye_l
+  eye 90x100 iris:acorn.iris side:1 look:0,.35 lid:.15 at:606,592 name:eye_r
+layer mouth
+  smile 56 at:512,666 color:acorn.mouth
+layer sparkles
+  sparkle 46 at:790,232 color:acorn.star
+  sparkle 28 at:236,300 color:acorn.star
+  sparkle 22 at:818,560 color:acorn.star
+assert inside(@nut canvas margin:24)
+assert level(@eye_l @eye_r) tol:.5
