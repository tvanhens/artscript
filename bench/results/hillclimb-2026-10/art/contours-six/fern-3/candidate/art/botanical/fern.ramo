@target fern.png 900x1200 bg:botanical.paper
@target fern.svg 900x1200 bg:botanical.paper

palette botanical
  color paper #f4eddd
  color ink #4d4939
  color fine #726b53
  color wash #e9e3ce

def pinna length:160 breadth:16
  group scale:length/160,breadth/16
    curve 0,0 7,-3.18 10,-7.06 14,-6.36 17,-4 20,-8.89 24,-8 27,-4.57 30,-10.15 34,-9.13 37,-4.92 40,-10.93 44,-9.84 47,-5.08 50,-11.3 54,-10.17 57,-5.08 60,-11.3 64,-10.17 67,-4.94 70,-10.98 74,-9.89 77,-4.68 80,-10.4 84,-9.36 87,-4.32 90,-9.59 94,-8.63 97,-3.87 100,-8.6 104,-7.74 107,-3.37 110,-7.48 114,-6.73 117,-2.83 120,-6.28 124,-5.65 127,-2.27 130,-5.04 134,-4.53 137,-1.71 140,-3.79 144,-3.41 147,-1.16 150,-2.59 154,-2.33 160,0 154,2.12 150,2.43 147,1.04 144,3.11 140,3.57 137,1.52 134,4.13 130,4.73 127,2.01 124,5.15 120,5.9 117,2.51 114,6.14 110,7.03 107,2.99 104,7.05 100,8.09 97,3.44 94,7.86 90,9.01 87,3.84 84,8.53 80,9.77 77,4.16 74,9.01 70,10.32 67,4.39 64,9.26 60,10.62 57,4.52 54,9.26 50,10.62 47,4.52 44,8.96 40,10.27 37,4.37 34,8.32 30,9.54 27,4.06 24,7.29 20,8.36 17,3.56 14,5.79 10,6.64 7,2.82 closed tension:.35 fill:botanical.paper stroke:botanical.ink,.78 name:contour
    curve 0,0 52,-.8 112,-.5 160,0 fill:none stroke:botanical.ink,[1 .7 .3] name:midrib
    each k in 0..14
      let x = 10+k*10
      let w = 16*sin((x+12)/180*180)*(.98-x/220)
      curve x-6,0 x,-w*.35 x+3,-w*.9 fill:none stroke:botanical.fine,.48 name:upper_vein
      curve x-5,0 x,w*.3 x+3,w*.83 fill:none stroke:botanical.fine,.45 name:lower_vein

layer paper_surface
  rect 900x1200 at:450,600 fill:botanical.paper name:paper
    fx grain .023 scale:.65

