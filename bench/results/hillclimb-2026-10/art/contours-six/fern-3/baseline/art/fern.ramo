@target fern.png 900x1200 bg:botanical.paper
@target fern.svg 900x1200 bg:botanical.paper

palette botanical
  color paper #f4eddd
  color ink #474438
  color fine #77705c
  color wash #e9e4d3

# A narrow, toothed pinnule, drawn from its attachment to its tip.
def pinnule length:28 width:5
  curve 0,0 length*.17,-width*.65 length*.32,-width length*.42,-width*.73 length*.52,-width*.88 length*.61,-width*.58 length*.72,-width*.64 length*.81,-width*.32 length,0 length*.79,width*.45 length*.68,width*.35 length*.58,width*.73 length*.47,width*.58 length*.35,width*.88 length*.17,width*.6 closed tension:.15 fill:botanical.paper stroke:botanical.ink,.65 name:blade
    curve 0,0 length*.48,-.4 length*.95,0 stroke:botanical.fine,.42 name:vein
    each j in 1..6
      let u = j/7
      curve length*u,0 length*(u+.07),-width*.25 length*(u+.13),-width*(1-u)*.95 stroke:botanical.fine,.3 name:upper_veins
      curve length*u,0 length*(u+.08),width*.3 length*(u+.13),width*(1-u)*.85 stroke:botanical.fine,.3 name:lower_veins

def pinna length:200 fullness:1
  curve 0,0 length*.36,-length*.045 length*.74,-length*.1 length,-length*.17 stroke:botanical.ink,[1.15 .85 .5 .15] name:rib
  each k in 0..13
    let u = (k+1)/14
    let x = length*u
    let y = -length*(.035*u+.135*u*u)
    let leaflet = length*.205*sin((u*.88+.12)*180)*fullness
    pinnule length:leaflet width:leaflet*.17 at:x,y rot:-57+u*25 name:upper
    pinnule length:leaflet*.91 width:leaflet*.155 at:x+length*.018,y rot:53-u*22 name:lower
  pinnule length:length*.14 width:length*.018 at:length*.9,-length*.14 rot:-16 name:terminal

layer paper_surface
  rect 900x1200 at:450,600 fill:botanical.paper name:paper
    fx grain .026 scale:.7

layer fern_frond
  # Slowly leaning rachis, with alternate rather than mirrored pinnae.
  each i in 0..18
    let progress = i/18
    let x = 369+190*progress-7*sin(progress*180)
    let y = 899-733*progress
    let span = 223*(1-progress)*(.66+1.35*progress)+12
    pinna length:span at:x,y rot:-158-progress*17 name:left_pinna
    pinna length:span*.94 at:x+3,y-19 rot:-12-progress*10 name:right_pinna
  curve 335,1077 350,1001 369,899 410,700 467,478 524,280 563,144 stroke:botanical.ink,[2.4 2.25 1.9 1.65 1.2 .75 .1] name:rachis
  curve 338,1074 354,999 372,901 412,702 stroke:botanical.fine,.45 name:stem_highlight
  pinnule length:39 width:4.5 at:553,174 rot:-72 name:apex
