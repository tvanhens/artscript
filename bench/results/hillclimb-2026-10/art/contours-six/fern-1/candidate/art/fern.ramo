@target fern.png 900x1200
@target fern.svg 900x1200

# Fine sepia pen work, airy margins, and uncoated ivory stock.
palette botanical
  color paper #f4eddd
  color ink #484735
  color fine #77735a
  ramp stock #f4eddd 5

def leaflet size:32x16
  path "M0 0 C5 -5 15 -9 29 -8 C24 -5 18 2 10 2 C6 2 2 1 0 0 Z" fill:none stroke:botanical.ink,.65 name:edge
  curve 0,0 12,-2 27,-7 fill:none stroke:botanical.fine,.45 name:vein
  each j in 0..4
    let x = 6+j*4
    curve x,-x*.16 x+1,-3-x*.15 x+2,-5-x*.13 fill:none stroke:botanical.fine,.32 name:upper_vein
    curve x,-x*.16 x+3,-x*.12+1 x+5,-x*.18+1 fill:none stroke:botanical.fine,.3 name:lower_vein

def pinna length:240 size:280x90
  curve 0,0 length*.35,-5 length*.7,-9 length,-15 fill:none stroke:botanical.ink,[1.2 .9 .65 .2] name:rib
  each j in 0..12
    let u = j/12
    let x = 8+u*length*.88
    let s = (.9-u*.68)*(length/240)
    leaflet at:x,-u*14 scale:s rot:-42+j*.7 name:upper
    leaflet at:x+3,-u*14 scale:s,-s rot:26-j*.8 name:lower
  leaflet at:length*.89,-13 scale:.45 rot:-8 name:tip

layer paper
  rect 900x1200 at:450,600 fill:botanical.paper name:sheet
    fx grain .025 scale:.65

layer fern
  curve 341,1050 366,956 396,835 424,704 452,568 487,416 524,267 554,161 fill:none stroke:botanical.ink,[2.5 2.4 2.1 1.9 1.5 1.1 .7 .15] name:rachis
  each i in 0..15
    let u = i/14
    let y = 917-i*49
    let x = 376+i*11.4
    let len = 218*(1-u*.83)+45*sin(u*180)
    pinna length:len at:x,y rot:-151+u*17 name:left
    pinna length:len*.96 at:x+2,y-18 rot:-28-u*19 name:right
  pinna length:57 at:541,207 rot:-76 name:crown
