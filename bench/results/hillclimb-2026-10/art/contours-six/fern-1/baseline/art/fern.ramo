@target fern.png 900x1200 scale:1,2 bg:botanical.paper
@target fern.svg 900x1200 bg:botanical.paper

# A botanical pen study: slender rachis, divided pinnae, fine venation.
palette botanical
  color paper #f5efdf
  color ink #343b30
  color faint #77745d
  ramp fibre #eae1cb #faf6eb 5

def pinnule l:28 w:5 side:1
  group blade scale:1,side
    curve 0,0 l*.15,-w*.55 l*.31,-w*.87 l*.42,-w*.79 l*.52,-w l*.64,-w*.75 l*.76,-w*.77 l*.87,-w*.4 l,-1 l*.82,w*.35 l*.69,w*.51 l*.55,w*.47 l*.4,w*.62 l*.23,w*.33 0,0 closed fill:botanical.paper stroke:botanical.ink,.65 name:edge
    curve 0,0 l*.45,-.5 l*.97,-1 fill:none stroke:botanical.ink,.48 taper:.3 name:midrib
    each k in 1..6
      let x = l*k/7
      let v = w*sin(k*180/7)*.78
      curve x-2,-.3 x+2,-v*.55 x+4,-v fill:none stroke:botanical.faint,.35 name:upper_vein
      curve x-2,0 x+1,v*.4 x+3,v*.7 fill:none stroke:botanical.faint,.32 name:lower_vein

def pinna length:175
  curve 0,0 length*.45,-3 length,0 fill:none stroke:botanical.ink,[1.1 .7 .2] name:costa
  each j in 0..11
    let u = (j+1)/12
    let x = length*u
    let l = (10+length*.17)*sqrt(sin(u*173))*(1-u*.45)
    pinnule l l*.18 1 at:x,-2 rot:-64+u*19 name:upper
    pinnule l*.94 l*.17 -1 at:x+2,-1 rot:55-u*17 name:lower
  pinnule 18 2.5 1 at:length-8,0 rot:0 name:tip

layer paper_surface
  rect 900x1200 at:450,600 fill:fbm(simplex(130 seed:11)) -> botanical.fibre a:.2 name:paper_texture
    fx grain .025 scale:.7
  each i in 0..1600
    let x = rand(8 892)
    let y = rand(8 1192)
    curve x,y x+rand(.3 1.8),y-rand(.2 1) stroke:botanical.faint,.35 a:rand(.025 .09) name:fibres

layer fern_frond
  curve 360,1040 387,974 420,900 454,817 483,730 508,638 529,541 546,441 558,339 565,244 566,155 fill:none stroke:botanical.ink,[2.1 2 1.9 1.7 1.5 1.3 1.1 .9 .7 .5 .1] name:rachis
  curve 363,1038 390,973 422,902 456,819 fill:none stroke:botanical.faint,.45 name:stem_edge
  each i in 0..18
    let u = i/18
    let y = 895-697*u
    let x = 422+205*u-61*u*u
    let l = 76+133*sin((u*.83+.17)*180)-67*u
    pinna l at:x,y rot:-151+13*u name:left_pinna
    pinna l*.92 at:x+2,y-17 rot:-34-11*u name:right_pinna
  pinnule 45 5 1 at:566,199 rot:-90 name:crown
