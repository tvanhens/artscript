@target health-potion.png 64x64 bg:none

palette potion
  color ink #251c38
  color glass #7296ac
  color shade #40536f
  color light #b4e1df
  color shine #f3fff1
  color deep #761d46
  color red #cf294e
  color bright #f64b5d
  color pink #ff9690
  color cork #b26e46
  color corklight #e7ad69
  color corkdark #754535

# All edges lie on the pixel grid; no curves or soft effects.
layer bottle
  path "M24 14H40V24H44V28H48V32H50V38H52V50H50V54H46V58H18V54H14V50H12V38H14V32H16V28H20V24H24Z" fill:potion.ink name:flask
    path "M26 17H38V26H42V30H46V34H48V40H50V48H48V52H44V55H20V52H16V48H14V40H16V34H18V30H22V26H26Z" fill:potion.glass
    path "M38 26H42V30H46V34H48V40H50V48H48V52H44V55H20V52H42V48H46V38H44V32H40V28H38Z" fill:potion.shade
    path "M26 18H29V27H25V30H21V34H18V39H16V35H18V30H22V26H26Z" fill:potion.light

layer liquid
  path "M18 36H24V35H38V36H46V40H48V48H46V52H42V54H22V52H18V48H16V40H18Z" fill:potion.deep name:elixir
    path "M18 38H24V37H38V38H44V42H46V48H42V51H22V49H18Z" fill:potion.red
    path "M18 38H24V37H38V38H44V40H24V42H18Z" fill:potion.bright
    path "M20 42H24V46H28V50H38V52H24V50H20Z" fill:potion.bright
    rect 4x2 at:29,38 fill:potion.pink
    rect 2x2 at:39,44 fill:potion.pink

layer reflections
  rect 3x9 at:19.5,41.5 fill:potion.shine
  rect 3x3 at:22.5,49.5 fill:potion.light
  rect 2x6 at:45,33 fill:potion.light
  rect 2x4 at:47,45 fill:potion.glass
  rect 4x2 at:29,53 fill:potion.pink

layer stopper
  path "M24 6H40V8H42V16H40V20H24V16H22V8H24Z" fill:potion.ink name:cork
    path "M25 8H39V10H40V14H38V18H26V14H24V10H25Z" fill:potion.cork
    rect 12x3 at:32,9.5 fill:potion.corklight
    rect 3x5 at:36.5,14.5 fill:potion.corkdark
    rect 2x3 at:28,14.5 fill:potion.corkdark
  path "M22 19H42V21H44V25H42V27H22V25H20V21H22Z" fill:potion.ink name:rim
    rect 20x4 at:32,23 fill:potion.glass
    rect 14x2 at:29,22 fill:potion.light
    rect 5x2 at:25.5,22 fill:potion.shine
    rect 4x2 at:40,24 fill:potion.shade
