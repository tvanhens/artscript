@target props/health-potion.png 64x64 bg:none

palette potion
  color ink #251d32
  color glass #789cae
  color pale #c8e8e5
  color white #f4fff0
  color shade #446075
  color wine #751c40
  color red #c92d4a
  color bright #f4515b
  color pink #ff9290
  color cork #b5784e
  color corklight #e1b778
  color corkdark #704638

layer bottle_layer
