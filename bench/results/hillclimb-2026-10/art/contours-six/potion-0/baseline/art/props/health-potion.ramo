    rect 3x6 at:22.5,44 fill:potion.bright
    rect 7x2 at:29.5,50 fill:potion.bright
  rect 3x9 at:18.5,37.5 fill:potion.white
  rect 3x3 at:21.5,31.5 fill:potion.white
  rect 2x7 at:45,43.5 fill:potion.pale
  rect 9x2 at:32.5,55 fill:potion.pale

