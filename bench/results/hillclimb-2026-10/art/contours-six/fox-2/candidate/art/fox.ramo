layer undergrowth
  curve 141,603 148,582 144,566 fill:none stroke:wood.forest.3,3
  ellipse 11,5 at:135,579 rot:35 fill:wood.forest.3
  ellipse 11,5 at:156,586 rot:-35 fill:wood.forest.3
  curve 641,607 655,580 656,558 fill:none stroke:wood.forest.3,3
  ellipse 13,6 at:645,573 rot:45 fill:wood.forest.3
  ellipse 12,5 at:667,582 rot:-35 fill:wood.forest.3
  curve 226,628 234,613 233,602 fill:none stroke:wood.forest.3,3
  curve 459,619 457,604 449,599 fill:none stroke:wood.mint.1,3
  curve 461,619 470,602 481,601 fill:none stroke:wood.mint.1,3
  ellipse 7,3 at:505,614 fill:wood.mint.2 a:.7
  ellipse 5,2 at:273,628 fill:wood.forest.3

layer fireflies
  circle 3 at:485,331 fill:wood.mint.4
    fx glow 7 color:wood.mint.2
  circle 2 at:619,359 fill:wood.mint.4
    fx glow 6 color:wood.mint.2
  circle 3 at:525,554 fill:wood.mint.4
    fx glow 6 color:wood.mint.2
  circle 2 at:206,380 fill:wood.star
  circle 2 at:331,208 fill:wood.star
  circle 2 at:537,252 fill:wood.star
  star 4 r:7 inner:.24 at:464,270 fill:wood.star
  star 4 r:6 inner:.24 at:201,308 fill:wood.star
