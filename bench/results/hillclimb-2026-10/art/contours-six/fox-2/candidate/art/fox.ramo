@target fox-and-mushroom.png 768x768 bg:wood.night

palette wood
  color night #102c39
  ramp forest #245058 5
  ramp orange #e78139 5
  ramp cream #ffe5b5 5
  ramp mint #76efd0 5
  color ink #382e36
  color blush #ee9b79
  color star #b9dccb

layer forest_back
  circle 310 at:384,369 fill:grad(down wood.forest.1 wood.night) name:forest_window
  path "M150 490 Q180 330 144 169 Q180 204 188 302 L210 254 L194 338 Q207 420 200 490 Z" fill:wood.forest.1
  path "M591 489 Q566 325 612 163 L604 304 L643 265 L600 335 L625 489 Z" fill:wood.forest.1
  path "M252 457 Q271 302 246 216 Q280 300 282 369 L310 335 L286 394 L285 461 Z" fill:wood.forest.1 a:.6
  ellipse 269,58 at:387,609 fill:wood.forest.1
  ellipse 202,25 at:398,619 fill:wood.night a:.6 blur:7

layer mushroom_light
  ellipse 102,126 at:560,463 fill:wood.mint a:.11 blur:22
  ellipse 101,22 at:558,605 fill:wood.mint a:.23 blur:12

layer fox_body
  path "M326 543 C258 523 227 491 225 444 C174 464 155 522 178 564 C196 605 272 623 352 602 Z" fill:grad(right wood.orange.1 wood.orange.2) stroke:wood.ink,5 name:tail
    path "M225 441 C197 457 174 480 172 508 L190 506 L190 524 L212 516 L217 538 L242 520 C225 494 222 466 225 441 Z" fill:wood.cream.2
    path "M192 561 Q253 601 320 581" fill:none stroke:wood.orange.1,7
  path "M330 389 C280 414 267 491 279 557 C282 592 319 610 364 605 C411 603 430 580 424 543 C416 486 411 427 381 402 Z" fill:grad(right wood.orange.1 wood.orange.3) stroke:wood.ink,5 name:body
    path "M351 416 C313 439 308 475 326 522 L313 546 Q353 570 390 541 L375 522 C403 471 387 438 365 419 Z" fill:wood.cream.2
  path "M303 487 Q297 535 308 576 Q320 590 337 576 L340 515" fill:wood.orange.2 stroke:wood.ink,4
  path "M378 494 Q375 540 376 578 Q391 591 408 577 L401 519" fill:wood.orange.3 stroke:wood.ink,4
  ellipse 28,13 at:318,587 fill:wood.orange.1 stroke:wood.ink,4
  ellipse 27,13 at:395,587 fill:wood.orange.2 stroke:wood.ink,4
  curve 315,585 315,591 stroke:wood.ink,2
  curve 325,585 325,591 stroke:wood.ink,2
  curve 391,585 391,591 stroke:wood.ink,2
  curve 401,585 401,591 stroke:wood.ink,2

layer fox_head
  path "M275 328 Q248 285 265 220 Q310 233 337 280 L383 280 Q415 229 451 224 Q461 280 435 328 Z" fill:wood.orange.2 stroke:wood.ink,5 name:ears
  path "M278 284 L278 243 Q303 254 316 286 Z" fill:wood.ink
  path "M403 287 Q422 257 439 247 L434 289 Z" fill:wood.ink
  path "M272 297 Q313 272 355 283 Q400 273 436 300 L447 344 L462 357 L443 364 L453 378 Q421 425 360 440 Q300 431 268 395 L248 378 L265 368 L252 354 L269 346 Z" fill:grad(right wood.orange.2 wood.orange.3) stroke:wood.ink,5 name:head
    path "M260 352 Q304 338 353 383 Q398 341 451 348 L466 398 L369 452 L271 411 Z" fill:wood.cream.2
    ellipse 26,10 at:294,377 fill:wood.blush a:.58
    ellipse 25,10 at:417,376 fill:wood.blush a:.58
    path "M418 293 Q438 310 435 341" fill:none stroke:wood.cream.3,4 a:.7
  curve 292,352 302,344 313,351 fill:none stroke:wood.ink,5 name:left_eye
  curve 395,350 406,342 417,348 fill:none stroke:wood.ink,5 name:right_eye
  path "M344 378 Q355 373 366 378 Q365 389 355 393 Q345 388 344 378 Z" fill:wood.ink name:nose
  curve 355,392 354,401 344,405 336,400 fill:none stroke:wood.ink,3
  curve 355,398 365,405 374,399 fill:none stroke:wood.ink,3

layer mushroom
  path "M542 475 Q553 523 534 583 Q532 602 553 606 Q580 612 589 596 Q570 537 575 474 Z" fill:grad(right wood.mint.2 wood.cream.4) stroke:wood.forest.1,4 name:stem
    path "M546 491 Q562 532 546 585" fill:none stroke:wood.mint.1,5 a:.65
  ellipse 88,21 at:558,479 fill:wood.mint.1 stroke:wood.forest.1,4 name:gills
  curve 491,479 551,485 536,497 stroke:wood.mint.3,2
  curve 515,476 558,486 561,499 stroke:wood.mint.3,2
  curve 593,475 569,485 580,496 stroke:wood.mint.3,2
  path "M464 470 C474 445 492 402 524 389 C566 368 604 400 626 436 Q635 452 648 465 C659 482 621 485 600 479 Q560 465 522 481 C501 490 456 489 464 470 Z" fill:grad(down wood.mint.3 wood.mint.1) stroke:wood.forest.1,4 name:cap
    ellipse 19,10 at:534,406 rot:-18 fill:wood.cream.4
    ellipse 14,9 at:587,420 rot:24 fill:wood.cream.4
    ellipse 10,7 at:498,447 rot:-35 fill:wood.cream.4
    ellipse 19,9 at:558,448 fill:wood.cream.4
    ellipse 10,6 at:621,457 rot:30 fill:wood.cream.4
    path "M491 432 Q520 389 552 394" fill:none stroke:wood.mint.4,4
