@target fox-and-mushroom.png 800x800

palette dusk
  ramp night #172d3c 5
  ramp moss #39625f 5
  ramp fur #e98b48 5
  ramp cream #ffe4b9 5
  ramp magic #9cf5ce 5
  color ink #302f3e
  color pink #e9a08d

layer woodland
  rect 800x800 at:400,400 fill:grad(down dusk.night.0 dusk.night.2)
  ellipse 310,310 at:400,393 fill:dusk.moss.2 a:.15
  path "M90 620 Q140 410 110 140 Q125 110 145 130 Q165 380 195 610 Z" fill:dusk.night.0 a:.55
  path "M650 615 Q680 370 653 122 Q670 102 685 120 Q720 400 717 630 Z" fill:dusk.night.0 a:.55
  curve 144,303 216,242 240,180 stroke:dusk.night.0,18
  curve 681,351 616,289 601,229 stroke:dusk.night.0,16
  ellipse 309,68 at:400,653 fill:dusk.moss.1
  ellipse 232,32 at:414,657 fill:dusk.night.0 a:.45 blur:8

layer mushroom_light
  circle 119 at:570,465 fill:dusk.magic.2 a:.1 blur:24
  ellipse 112,22 at:566,644 fill:dusk.magic.2 a:.19 blur:13

layer fox_tail
  path "M321 612 C246 663 129 644 143 553 C151 505 192 478 178 433 C241 451 288 511 277 566 C300 555 325 571 321 612 Z" fill:grad(right dusk.fur.1 dusk.fur.2) stroke:dusk.ink,5 name:tail
    path "M130 427 C176 428 215 464 220 488 C202 483 196 506 180 507 C171 523 151 526 134 519 Z" fill:dusk.cream.2
    curve 163,565 174,605 224,619 stroke:dusk.fur.3,8

layer fox_body
  path "M317 426 C278 467 270 541 281 605 C284 638 325 648 377 642 C421 637 438 611 422 567 L393 460 Z" fill:grad(right dusk.fur.1 dusk.fur.3) stroke:dusk.ink,5 name:body
    path "M352 454 C313 476 316 520 326 553 L344 574 L362 555 L377 568 C397 520 401 476 377 456 Z" fill:dusk.cream.2
    ellipse 46,75 at:285,557 fill:dusk.fur.0 a:.25
  ellipse 35,17 at:315,633 fill:dusk.fur.2 stroke:dusk.ink,4
  ellipse 33,17 at:394,632 fill:dusk.fur.3 stroke:dusk.ink,4
  curve 329,557 332,617 stroke:dusk.ink,4
  curve 381,559 379,618 stroke:dusk.ink,4
  curve 304,633 304,639 stroke:dusk.fur.0,3
  curve 392,632 392,639 stroke:dusk.fur.1,3

layer fox_head
  path "M273 365 C252 329 247 273 259 242 C291 250 321 276 334 302 L371 301 C390 271 423 250 449 249 C458 286 447 334 434 367 Z" fill:dusk.fur.2 stroke:dusk.ink,5 name:ears
    path "M266 265 Q269 312 288 328 L314 307 Z" fill:dusk.ink
    path "M436 272 Q435 310 419 329 L391 307 Z" fill:dusk.ink
    path "M274 283 L282 313 L296 307 Z" fill:dusk.pink
    path "M428 288 L421 315 L407 309 Z" fill:dusk.pink
  path "M271 345 C291 311 324 304 351 311 C395 303 429 326 438 358 L457 389 L438 390 L446 403 L423 405 C410 441 375 465 351 469 C318 459 284 444 272 410 L251 404 L264 390 L249 386 Z" fill:grad(right dusk.fur.2 dusk.fur.3) stroke:dusk.ink,5 name:head
    path "M255 377 C292 370 320 389 351 427 C380 387 408 374 449 374 L459 431 L352 479 L265 436 Z" fill:dusk.cream.2
    ellipse 19,9 at:293,397 fill:dusk.pink a:.6
    ellipse 19,9 at:412,397 fill:dusk.pink a:.6
    path "M335 326 Q351 317 368 327 L352 351 Z" fill:dusk.fur.4 a:.7
  curve 294,378 304,371 315,379 fill:none stroke:dusk.ink,5
  curve 388,379 399,371 410,377 fill:none stroke:dusk.ink,5
  path "M340 412 Q351 405 363 412 Q360 423 352 425 Q343 422 340 412 Z" fill:dusk.ink
  curve 352,424 352,432 342,436 fill:none stroke:dusk.ink,3
  curve 352,432 362,436 367,431 fill:none stroke:dusk.ink,3

layer mushroom
  path "M552 515 C554 555 552 602 538 624 C546 641 586 641 599 626 C581 594 583 552 585 514 Z" fill:grad(right dusk.moss.3 dusk.magic.3) stroke:dusk.moss.0,4 name:stem
    curve 573,551 572,590 579,617 stroke:dusk.magic.4,5
  ellipse 91,22 at:570,519 fill:dusk.magic.3 stroke:dusk.moss.0,4
  each i in 0..9
    curve 570,528 498+i*18,513 stroke:dusk.moss.2,2 a:.5
  path "M470 511 C484 489 495 433 531 410 C551 396 580 396 604 411 C641 434 652 480 670 508 C645 525 601 517 570 520 C531 519 500 526 470 511 Z" fill:grad(down dusk.magic.2 dusk.moss.3) stroke:dusk.moss.0,4 name:cap
    ellipse 22,12 at:546,433 rot:-16 fill:dusk.magic.4
    ellipse 16,10 at:602,451 rot:27 fill:dusk.magic.4
    ellipse 12,8 at:512,478 rot:-24 fill:dusk.magic.3
    ellipse 9,6 at:630,490 fill:dusk.magic.3
    curve 501,459 524,426 550,417 stroke:dusk.magic.4,5 a:.7
    fx glow 12 color:dusk.magic.2 a:.45

layer tiny_wonders
  each i in 0..7
    circle 2.5 at:471+i*23,365+sin(i*73)*33 fill:dusk.magic.3
      fx glow 6 color:dusk.magic.2
  star 4 r:9 inner:.22 at:614,346 fill:dusk.magic.3
  star 4 r:6 inner:.22 at:486,414 fill:dusk.magic.3
  star 4 r:5 inner:.22 at:251,458 fill:dusk.cream.2
  each i in 0..12
    ellipse 5,2 at:200+i*34,668+sin(i*38)*12 fill:dusk.moss.3 a:.7
  curve 204,651 198,633 189,626 stroke:dusk.moss.3,4
  curve 206,653 211,632 220,625 stroke:dusk.moss.3,4
  curve 639,645 645,626 657,621 stroke:dusk.moss.3,4
  curve 638,647 633,630 627,625 stroke:dusk.moss.3,4
