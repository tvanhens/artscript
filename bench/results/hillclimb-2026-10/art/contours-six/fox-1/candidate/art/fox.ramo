@target fox-and-mushroom.png 800x800

palette woods
  ramp night #102d38 #346263 5
  ramp fox #e48242 5
  ramp cream #fff0cf 5
  ramp mint #79eac4 5
  ramp moss #305853 5
  color ink #25343b
  color blush #e59b7b

layer backdrop
  rect 800x800 at:400,400 fill:grad(down woods.night.0 woods.night.2)
  circle 245 at:467,386 fill:woods.mint.2 a:.06 blur:24
  path "M70 640 Q105 420 91 115 Q116 88 130 110 Q124 405 166 643 Z" fill:woods.night.1
  path "M646 639 Q690 356 667 99 Q688 70 710 99 Q689 379 739 652 Z" fill:woods.night.1
  curve 106,266 173,204 204,133 stroke:woods.night.1,16
  curve 695,315 624,258 598,181 stroke:woods.night.1,18
  ellipse 327,73 at:403,660 fill:woods.moss.1
  ellipse 239,30 at:407,672 fill:woods.night.0 a:.6 blur:12

layer mushroom_halo
  ellipse 100,70 at:584,495 fill:woods.mint.2 a:.18 blur:24
  ellipse 111,23 at:580,650 fill:woods.mint.2 a:.18 blur:16

layer fox_tail
  path "M344 610 C278 556 199 542 170 473 C153 435 161 395 187 373 C186 440 251 442 290 465 C364 506 400 576 365 629 Z" fill:grad(right woods.fox.1 woods.fox.2) stroke:woods.ink,5 name:tail
    path "M151 357 C172 405 202 413 225 430 L209 441 L227 453 L205 458 L218 474 C181 461 154 436 151 405 Z" fill:woods.cream.2
    curve 226,481 267,494 301,533 stroke:woods.fox.3,6

layer fox_body
  path "M311 451 C281 476 275 524 267 574 C260 612 270 652 302 660 L421 660 C452 645 445 605 426 568 C415 543 414 487 389 460 Z" fill:grad(right woods.fox.1 woods.fox.3) stroke:woods.ink,5 name:body
    path "M333 470 C312 503 311 532 325 557 L315 552 L323 573 L313 569 C319 612 343 633 365 633 C398 617 407 581 395 542 C386 511 379 487 369 473 Z" fill:woods.cream.2
  path "M311 572 Q304 612 310 650 Q323 662 344 651 L345 596" fill:woods.fox.2 stroke:woods.ink,4
  path "M383 580 L388 650 Q404 664 422 650 Q426 621 412 598" fill:woods.fox.3 stroke:woods.ink,4
  ellipse 30,13 at:321,653 fill:woods.fox.3 stroke:woods.ink,4
  ellipse 30,13 at:407,653 fill:woods.fox.3 stroke:woods.ink,4
  curve 322,649 322,657 stroke:woods.fox.1,2
  curve 334,649 334,657 stroke:woods.fox.1,2
  curve 406,649 406,657 stroke:woods.fox.1,2
  curve 418,649 418,657 stroke:woods.fox.1,2

layer fox_head
  path "M270 371 C250 343 245 288 257 251 C293 265 319 288 329 313 L383 313 C403 281 429 262 451 257 C463 298 450 344 431 373 Z" fill:woods.fox.2 stroke:woods.ink,5 name:ears
    path "M267 278 Q266 321 283 342 L307 320 Q293 295 267 278 Z" fill:woods.ink
    path "M437 283 Q409 301 402 323 L426 343 Q441 317 437 283 Z" fill:woods.ink
    path "M278 302 L281 329 L294 320 Z" fill:woods.blush
    path "M429 306 L414 323 L425 332 Z" fill:woods.blush
  path "M277 332 C305 302 385 302 420 336 Q439 354 440 381 L456 398 L440 401 L449 414 L430 416 C415 453 384 477 358 480 C330 476 295 457 276 426 L255 422 L266 411 L249 400 L267 391 Q263 354 277 332 Z" fill:grad(right woods.fox.2 woods.fox.3) stroke:woods.ink,5 name:head
    path "M252 393 C282 385 311 398 354 431 C389 404 425 383 457 392 L451 440 L401 477 L351 490 L291 462 Z" fill:woods.cream.2
    ellipse 19,9 at:296,412 fill:woods.blush a:.65
    ellipse 19,9 at:413,411 fill:woods.blush a:.65
    curve 293,387 305,380 317,387 stroke:woods.ink,5
    curve 390,386 402,379 414,386 stroke:woods.ink,5
    path "M341 426 Q355 420 369 426 Q366 440 355 442 Q345 440 341 426 Z" fill:woods.ink
    curve 355,441 355,449 344,454 stroke:woods.ink,3
    curve 355,449 365,454 373,448 stroke:woods.ink,3
    curve 425,357 430,369 429,379 stroke:woods.mint.3,4 a:.7
  curve 333,329 347,339 361,326 stroke:woods.fox.1,3

layer mushroom
  path "M567 517 C575 553 562 603 548 635 Q549 655 579 657 Q610 658 617 641 C596 603 593 560 602 521 Z" fill:grad(right woods.mint.1 woods.cream.3) stroke:woods.ink,4 name:stem
    curve 586,555 582,600 582,636 stroke:woods.mint.2,4
  path "M482 508 C493 474 535 433 576 434 C620 429 666 465 681 503 Q685 519 664 527 C612 545 532 540 491 526 Q478 521 482 508 Z" fill:grad(down woods.mint.3 woods.mint.1) stroke:woods.ink,4 name:cap
    path "M479 509 Q580 529 685 505 L689 544 L478 548 Z" fill:woods.mint.4
    ellipse 15,9 at:531,477 rot:-25 fill:woods.cream.3
    ellipse 20,11 at:580,457 fill:woods.cream.3
    ellipse 14,8 at:630,479 rot:25 fill:woods.cream.3
    ellipse 8,5 at:567,494 fill:woods.cream.3
    fx glow 12 color:woods.mint.2 a:.45
  curve 501,521 541,530 580,533 626,531 660,521 stroke:woods.mint.0,2 a:.55

layer forest_details
  curve 192,660 184,629 174,618 stroke:woods.moss.3,4
  curve 192,660 201,634 215,626 stroke:woods.moss.3,4
  curve 475,668 465,642 452,635 stroke:woods.moss.3,4
  curve 475,668 487,640 501,634 stroke:woods.moss.3,4
  ellipse 13,5 at:174,626 rot:40 fill:woods.moss.3
  ellipse 13,5 at:206,637 rot:-40 fill:woods.moss.3
  ellipse 11,5 at:459,645 rot:40 fill:woods.moss.3
  ellipse 12,5 at:492,643 rot:-40 fill:woods.moss.3
  circle 3 at:491,395 fill:woods.mint.4
    fx glow 6 color:woods.mint.2
  circle 2 at:647,377 fill:woods.mint.4
    fx glow 6 color:woods.mint.2
  circle 3 at:697,563 fill:woods.mint.4
    fx glow 6 color:woods.mint.2
  star 4 r:8 inner:.2 at:534,365 fill:woods.mint.3
  star 4 r:6 inner:.2 at:666,426 fill:woods.mint.3
  circle 2 at:220,338 fill:woods.mint.3 a:.6
  circle 2 at:388,223 fill:woods.mint.3 a:.6
  circle 2 at:156,535 fill:woods.mint.3 a:.6
