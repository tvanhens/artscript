@target fox-and-mushroom.png 800x800

palette dusk
  ramp night #172c40 5
  ramp moss #36666a 5
  ramp fox #e98a47 5
  ramp cream #ffe6bb 5
  ramp magic #80f6cc 5
  color ink #273345
  color blush #d77e6d
  color star #b6d6c8

layer backdrop
  rect 800x800 at:400,400 fill:grad(down dusk.night.0 dusk.night.2)
  circle 245 at:415,366 fill:dusk.moss a:.13
  path "M65 595 Q100 410 87 150 Q110 110 126 150 L146 600 Z" fill:dusk.night.0 a:.42
  path "M654 608 L678 126 Q698 105 715 130 L731 612 Z" fill:dusk.night.0 a:.42
  curve 120,268 187,213 215,166 stroke:dusk.night.0,15 a:.4
  curve 692,310 617,251 604,210 stroke:dusk.night.0,14 a:.4

layer clearing
  ellipse 310,77 at:400,660 fill:dusk.night.0
  ellipse 290,61 at:400,646 fill:grad(down dusk.moss.2 dusk.moss.0)
  ellipse 110,23 at:574,635 fill:dusk.magic a:.22 blur:17
  ellipse 134,22 at:321,657 fill:dusk.ink a:.5 blur:9

layer mushroom_glow
  ellipse 112,109 at:578,474 fill:dusk.magic a:.11 blur:25
  ellipse 76,66 at:578,475 fill:dusk.magic a:.16 blur:17

layer fox_tail
  path "M319 647 C198 683 128 627 145 546 C149 519 167 491 191 479 C182 541 245 512 285 550 C314 576 332 609 319 647 Z" fill:grad(down dusk.fox.3 dusk.fox.1) stroke:dusk.ink,5 name:tail
    path "M135 473 L206 463 L214 526 L198 541 L179 535 L175 555 L153 553 L135 564 Z" fill:dusk.cream.3
    curve 172,594 201,623 247,628 stroke:dusk.fox.4,5

layer fox_body
  path "M289 446 C247 473 239 537 245 597 L236 642 Q253 672 293 659 L375 660 Q411 654 404 628 C405 545 383 479 348 452 Z" fill:grad(right dusk.fox.1 dusk.fox.3) stroke:dusk.ink,5 name:body
  path "M305 461 Q345 449 367 488 Q393 549 366 610 L282 608 Q269 532 305 461 Z" fill:grad(down dusk.cream.3 dusk.cream.1) name:bib
  path "M285 552 Q269 593 280 641 Q292 654 309 643 L314 579" fill:dusk.fox.2 stroke:dusk.ink,4
  path "M349 560 Q339 606 347 645 Q363 658 381 646 L380 583" fill:dusk.fox.3 stroke:dusk.ink,4
  ellipse 28,12 at:292,650 fill:dusk.fox.3 stroke:dusk.ink,3
  ellipse 27,12 at:367,651 fill:dusk.fox.3 stroke:dusk.ink,3
  curve 291,650 291,656 stroke:dusk.fox.0,2
  curve 366,651 366,657 stroke:dusk.fox.0,2

layer fox_head
  path "M233 366 Q205 312 218 237 Q267 249 300 304 Z" fill:dusk.fox.2 stroke:dusk.ink,5 name:left_ear
    path "M231 267 Q234 312 249 333 L279 305 Z" fill:dusk.ink
    path "M239 284 L247 312 L260 309 Z" fill:dusk.blush
  path "M340 310 Q370 257 417 244 Q428 316 397 372 Z" fill:dusk.fox.3 stroke:dusk.ink,5 name:right_ear
    path "M365 312 L404 271 Q406 315 391 335 Z" fill:dusk.ink
    path "M382 309 L397 285 L393 319 Z" fill:dusk.blush
  path "M223 348 Q248 299 312 302 Q381 299 406 352 L424 388 L406 391 L418 412 L395 415 Q375 469 321 478 Q262 479 238 437 L215 424 L228 410 L211 394 Z" fill:grad(right dusk.fox.2 dusk.fox.3) stroke:dusk.ink,5 name:head
    path "M209 389 Q256 371 300 422 Q314 438 326 437 Q361 383 428 387 L429 484 L213 484 Z" fill:dusk.cream.3
    ellipse 21,11 at:257,411 fill:dusk.blush a:.52
    ellipse 21,11 at:384,407 fill:dusk.blush a:.52
    ellipse 24,48 at:397,356 fill:dusk.magic a:.14 blur:13
  curve 255,390 265,382 277,388 stroke:dusk.ink,5 name:left_eye
  curve 357,387 368,379 379,385 stroke:dusk.ink,5 name:right_eye
  path "M306 416 Q321 409 335 416 Q333 430 322 432 Q312 430 306 416 Z" fill:dusk.ink name:nose
  curve 322,431 322,442 312,447 stroke:dusk.ink,3
  curve 322,442 333,447 339,441 stroke:dusk.ink,3
  curve 305,319 315,332 327,318 stroke:dusk.fox.4,4

layer mushroom
  path "M564 485 Q567 553 549 622 Q572 644 601 623 Q585 553 592 485 Z" fill:grad(right dusk.magic.2 dusk.cream.4) stroke:dusk.moss.0,4 name:stem
    curve 579,530 576,574 570,614 stroke:dusk.magic.4,5
  ellipse 97,25 at:578,491 fill:dusk.magic.1 stroke:dusk.moss.0,4 name:gills
  curve 499,491 551,499 575,503 stroke:dusk.magic.3,2
  curve 655,491 609,499 584,503 stroke:dusk.magic.3,2
  path "M476 481 C494 452 510 401 563 393 C622 383 652 432 680 478 Q644 501 578 490 Q520 503 476 481 Z" fill:grad(down dusk.magic.3 dusk.magic.1) stroke:dusk.moss.0,4 name:cap
    ellipse 18,11 at:550,417 rot:-16 fill:dusk.cream.4
    ellipse 13,9 at:609,426 rot:25 fill:dusk.cream.4
    ellipse 11,7 at:516,451 rot:-29 fill:dusk.magic.4
    ellipse 18,10 at:578,460 fill:dusk.magic.4
    ellipse 12,7 at:647,461 rot:25 fill:dusk.magic.4
    curve 512,430 538,408 566,404 stroke:dusk.magic.4,4
  curve 490,485 534,491 577,485 625,489 667,480 stroke:dusk.magic.4,4
    fx glow 7 color:dusk.magic

layer forest_details
  curve 172,652 165,629 152,620 stroke:dusk.moss.3,4
  curve 176,653 183,630 194,624 stroke:dusk.moss.3,4
  curve 643,646 653,619 668,610 stroke:dusk.moss.3,4
  curve 651,646 679,635 692,639 stroke:dusk.moss.3,4
  ellipse 14,5 at:659,619 rot:-44 fill:dusk.moss.3
  ellipse 13,5 at:678,635 rot:-10 fill:dusk.moss.3
  ellipse 10,4 at:163,631 rot:48 fill:dusk.moss.3
  ellipse 9,4 at:186,635 rot:-45 fill:dusk.moss.3
  ellipse 8,3 at:434,661 fill:dusk.magic.1
  ellipse 6,2 at:209,676 fill:dusk.moss.3
  ellipse 9,3 at:515,674 fill:dusk.moss.3

layer fireflies
  circle 3 at:464,368 fill:dusk.magic.4
    fx glow 8 color:dusk.magic
  circle 2 at:642,342 fill:dusk.magic.4
    fx glow 7 color:dusk.magic
  circle 3 at:704,542 fill:dusk.magic.4
    fx glow 7 color:dusk.magic
  circle 2 at:455,552 fill:dusk.magic.4
    fx glow 6 color:dusk.magic
  circle 2 at:164,393 fill:dusk.star a:.6
  circle 2 at:526,274 fill:dusk.star a:.5
  circle 2 at:320,190 fill:dusk.star a:.5
  path "M466 306 L469 315 L478 318 L469 321 L466 330 L463 321 L454 318 L463 315 Z" fill:dusk.star a:.7
