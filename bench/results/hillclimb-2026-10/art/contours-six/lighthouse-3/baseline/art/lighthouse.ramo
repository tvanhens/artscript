@target lighthouse-at-dusk.png 1200x900 bg:#f7f0e4

palette dusk
  color paper #f7f0e4
  color violet #77758f
  color rose #d59da1
  color peach #efbd99
  color sea #657f91
  color deep #344c64
  color rock #575970
  color earth #958579
  color grass #7a8173
  color chalk #eee5d2
  color shade #9b9dab
  color red #9c635f
  color ink #384051
  color gold #ffda8c

brush wash rag:4 reach:4
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 35 + seeded(m), 4);
    float fine = hash12(m.dev + seeded(m));
    float edge = m.edge + (n-.5)*rag;
    float pool = exp(-abs(edge)/3.5);
    float density = .76 + .19*n + .05*fine;
    float3 pigment = m.paint.rgb * (1 - .15*pool - .08*(n-.5));
    return float4(pigment, cover(edge,m)*density);
  }
  """

layer atmosphere brush:wash
  rect 1080x740 at:600,440 fill:grad(down dusk.violet dusk.rose dusk.peach) a:.65 name:sky
  ellipse 330,66 at:746,425 fill:dusk.peach a:.42 name:horizon_glow
  curve 96,228 272,205 433,231 581,202 783,227 1089,193 stroke:dusk.violet,49 a:.22 name:cloud_high
  curve 110,318 318,342 475,319 672,347 892,313 1101,328 stroke:dusk.rose,36 a:.35 name:cloud_low
  curve 81,162 273,142 389,158 stroke:dusk.paper,19 a:.35 name:cloud_light

layer ocean brush:wash
  rect 1080x330 at:600,645 fill:grad(down dusk.sea dusk.deep) a:.79 name:water
  curve 65,487 320,483 574,488 812,480 1136,486 stroke:dusk.violet,4 a:.45 name:horizon
  each i in 0..44
    let yy = 504+i*6.8
    let xx = rand(100 1100)
    curve xx,yy xx+rand(15 55),yy-2 xx+rand(65 120),yy+1 stroke:dusk.chalk,rand(1 4) a:rand(.12 .4) seed:100+i name:ripple
  each i in 0..16
    let yy = 520+i*15
    let xx = rand(730 980)
    curve xx,yy xx+rand(30 100),yy-3 stroke:dusk.peach,rand(2 5) a:.25 seed:200+i name:reflection
  curve 1030,487 1073,474 1114,481 1135,493 closed fill:dusk.violet a:.4 name:distant_headland

layer headland brush:wash
  curve 62,546 159,514 238,475 332,448 438,424 503,440 550,467 534,499 561,533 539,575 559,608 520,653 514,702 467,764 384,809 62,809 closed tension:.1 fill:grad(down dusk.earth dusk.rock dusk.deep) name:cliff
    curve 344,472 390,495 378,563 411,599 374,670 398,735 stroke:dusk.deep,30 a:.44 name:ravine_one
    curve 466,471 451,540 479,573 454,631 438,701 stroke:dusk.ink,21 a:.44 name:ravine_two
    curve 254,521 268,582 244,633 275,705 239,786 stroke:dusk.chalk,24 a:.24 name:rock_face_light
    curve 503,526 492,594 508,627 470,693 stroke:dusk.earth,14 a:.54 name:rock_face_edge
    each i in 0..35
      let xx = rand(95 500)
      let yy = rand(540 790)
      curve xx,yy xx+rand(-14 18),yy+rand(15 45) stroke:dusk.ink,rand(1 4) a:.22 seed:300+i name:fissure
  curve 63,545 170,503 265,465 365,434 438,424 503,440 548,465 496,478 418,468 342,482 244,512 161,551 63,587 closed tension:.25 fill:dusk.grass name:grassy_cap
  curve 95,551 224,492 355,461 428,453 stroke:dusk.chalk,[12 9 6 4] a:.52 name:footpath
  curve 68,775 183,755 235,780 303,793 364,809 64,809 closed fill:dusk.deep a:.55 name:foreground

layer lighthouse brush:wash
  curve 398,447 408,297 443,297 460,448 closed tension:0 fill:dusk.chalk name:tower
    curve 433,294 443,300 459,449 432,449 closed fill:dusk.shade a:.67 name:tower_shadow
    curve 405,391 451,385 452,401 404,408 closed fill:dusk.red a:.72 name:stripe
    rect 8x18 at:424,339 fill:dusk.ink a:.8 name:upper_window
    rect 11x22 at:424,433 r:4 fill:dusk.ink name:door
  curve 391,303 459,303 stroke:dusk.ink,6 name:balcony_base
  curve 393,290 393,302 457,302 457,290 stroke:dusk.ink,2 name:railing
  rect 41x32 at:425,278 fill:dusk.gold name:lantern
  rect 7x32 at:408,278 fill:dusk.ink name:lantern_left
  rect 7x32 at:443,278 fill:dusk.ink name:lantern_right
  curve 401,261 409,249 425,244 443,251 451,262 closed tension:.1 fill:dusk.ink name:roof
  curve 425,244 425,234 stroke:dusk.ink,3 name:finial
  curve 390,452 464,452 stroke:dusk.earth,8 name:foundation
  rect 56x33 at:357,437 fill:dusk.chalk name:keeper_cottage
  curve 320,422 353,404 391,422 closed tension:0 fill:dusk.red name:cottage_roof
  rect 8x14 at:354,445 fill:dusk.ink name:cottage_door

layer beacon brush:wash
  curve 447,271 1044,211 1045,321 447,284 closed tension:0 fill:dusk.gold a:.12 name:beam
  ellipse 43,32 at:425,277 fill:dusk.gold a:.23 name:halo
  ellipse 16,10 at:425,277 fill:dusk.gold a:.8 name:lamp
  ellipse 6,5 at:424,276 fill:dusk.paper name:lamp_core

layer surf brush:wash
  curve 545,605 565,633 546,672 521,710 488,743 458,769 stroke:dusk.chalk,[3 9 6 13 5 2] a:.7 name:breaking_wave
  curve 578,680 568,716 526,757 489,779 stroke:dusk.chalk,[2 5 8 2] a:.52 name:outer_surf
  curve 673,743 711,736 750,742 stroke:dusk.chalk,4 a:.4 name:sea_foam
  curve 756,354 765,350 774,355 783,351 790,354 stroke:dusk.ink,2 a:.65 name:gull_one
  curve 811,377 819,374 826,378 stroke:dusk.ink,1.7 a:.5 name:gull_two
