@target treasure-chest.png 512x512 bg:none scale:1,2
@target treasure-chest.svg 512x512 bg:none

palette treasure
  color ink #362032
  color deep #542a31
  color wood #aa5031
  color amber #df8241
  color gold #efac24
  color light #ffdc65
  color gleam #fff3b0
  color shade #ba681d

def coin size:40x30
  ellipse 20,13 at:0,4 fill:treasure.shade stroke:treasure.ink,3
  ellipse 20,12 fill:treasure.gold stroke:treasure.ink,3
    ellipse 14,8 fill:treasure.light stroke:treasure.shade,2
    curve -7,-4 0,-6 7,-4 fill:none stroke:treasure.gleam,3
  curve -12,8 -12,12 fill:none stroke:treasure.light,2
  curve 0,11 0,15 fill:none stroke:treasure.light,2
  curve 12,8 12,11 fill:none stroke:treasure.light,2

def sparkle size:40
  path "M0 -22 Q4 -4 17 0 Q4 4 0 22 Q-4 4 -17 0 Q-4 -4 0 -22Z" fill:treasure.gleam stroke:treasure.gold,2

layer ground_shadow
  ellipse 183,22 at:262,441 fill:treasure.ink a:.19 blur:7

layer open_lid
  path "M108 242 L99 153 Q100 99 160 81 L339 59 Q377 60 389 100 L409 203 L343 260Z" fill:treasure.gold stroke:treasure.ink,9 name:lid
    path "M125 222 L119 153 Q120 115 164 103 L336 82 Q355 81 367 111 L384 190 L336 232Z" fill:treasure.deep stroke:treasure.ink,6
    path "M133 153 Q145 123 172 120 L331 98 Q345 97 352 116 L363 160 L151 190Z" fill:treasure.wood
    curve 163,126 174,174 fill:none stroke:treasure.deep,5
    curve 224,116 235,166 fill:none stroke:treasure.deep,5
    curve 287,107 299,157 fill:none stroke:treasure.deep,5
    path "M102 147 Q107 100 159 84 L176 82 Q128 103 125 148 L134 229 L112 235Z" fill:treasure.light
    curve 158,91 335,68 fill:none stroke:treasure.gleam,5
  circle 5 at:116,156 fill:treasure.shade
  circle 5 at:376,133 fill:treasure.shade

layer treasure_heap
  path "M111 278 Q95 236 144 222 Q156 189 202 201 Q224 168 255 196 Q285 171 319 194 Q358 177 378 212 Q411 211 419 245 L377 310Z" fill:treasure.shade stroke:treasure.ink,7 name:heap
  coin at:163,225 rot:-17
  coin at:207,207 rot:12
  coin at:252,204 rot:-12
  coin at:294,207 rot:19
  coin at:341,211 rot:-16
  coin at:380,234 rot:24
  coin at:136,250 rot:8
  coin at:184,247 rot:-7
  coin at:229,235 rot:18
  coin at:276,237 rot:-13
  coin at:323,241 rot:5
  coin at:362,265 rot:-16
  coin at:204,274 rot:4
  coin at:252,267 rot:14
  coin at:305,274 rot:-9

layer chest_body
  path "M104 272 L343 294 L416 249 L402 386 Q397 402 382 408 L310 450 L122 414 Q106 410 105 392Z" fill:treasure.wood stroke:treasure.ink,9 name:body
    path "M343 294 L416 249 L402 386 Q397 402 382 408 L310 450 L321 322Z" fill:treasure.deep
    path "M105 279 L343 301 L335 334 L105 308Z" fill:treasure.amber
    curve 117,348 328,382 fill:none stroke:treasure.deep,6
    curve 117,391 318,427 fill:none stroke:treasure.deep,6
    curve 353,336 403,306 fill:none stroke:treasure.ink,5
    curve 346,384 401,353 fill:none stroke:treasure.ink,5
    curve 149,328 186,335 207,333 fill:none stroke:treasure.amber,4
    curve 226,391 257,396 282,395 fill:none stroke:treasure.amber,4
  path "M102 266 L343 287 L418 242 L419 265 L346 313 L103 289Z" fill:treasure.gold stroke:treasure.ink,7 name:rim
    curve 111,272 341,294 408,253 fill:none stroke:treasure.gleam,5
  path "M122 292 L148 295 L152 414 L126 410Z" fill:treasure.gold stroke:treasure.ink,5
    curve 130,302 134,399 fill:none stroke:treasure.light,6
  path "M295 309 L322 312 L310 443 L282 437Z" fill:treasure.gold stroke:treasure.ink,5
    curve 302,322 291,425 fill:none stroke:treasure.light,6
  path "M384 285 L405 272 L393 385 L372 398Z" fill:treasure.gold stroke:treasure.ink,5
  path "M117 397 L310 431 L393 385 L391 405 L311 452 L121 418Z" fill:treasure.gold stroke:treasure.ink,6
  each pt in [135,310 139,394 307,328 296,419 393,295 382,379]
    circle 4 at:pt fill:treasure.shade stroke:treasure.ink,2
  path "M211 305 L253 310 L251 356 Q230 372 211 350Z" fill:treasure.light stroke:treasure.ink,6 name:lock
    path "M216 314 L246 318 L244 348 Q230 358 218 345Z" fill:treasure.gold
    circle 6 at:230,329 fill:treasure.ink
    path "M227 332 L234 333 L236 344 L225 343Z" fill:treasure.ink

layer spilled_coins
  coin at:369,424 rot:-8
  coin at:412,414 rot:12
  coin at:408,404 rot:12
  coin at:445,440 rot:-18 scale:.8
  coin at:102,434 rot:8
  coin at:131,449 rot:-8 scale:.85
  coin at:353,305 rot:57
  coin at:371,331 rot:72 scale:.85

layer glints
  sparkle at:272,173 scale:.8
  sparkle at:431,193 scale:.85
  sparkle at:75,302 scale:.6
  sparkle at:337,247 scale:.48
  circle 4 at:410,158 fill:treasure.light
  circle 3 at:85,331 fill:treasure.light
