@target fox-and-mushroom.png 800x800 bg:wood.night

palette wood
  color night #122b36
  color ink #402f38
  ramp orange #e98743 5
  ramp cream #fff0d4 5
  ramp mint #a2f5ce 5
  ramp moss #306760 5
  color pink #ef9a86
  color far #1c3b46

layer forest
  ellipse 310,310 at:400,390 fill:radial(wood.far wood.night) name:backdrop
  path "M99 590 Q132 370 120 175 Q150 324 164 590 Z" fill:wood.far
  path "M650 590 Q661 368 690 155 Q687 391 717 590 Z" fill:wood.far
  curve 128,305 186,250 205,204 stroke:wood.far,14
  curve 682,344 625,275 613,227 stroke:wood.far,14
  ellipse 304,64 at:402,640 fill:wood.moss.0 name:ground
  ellipse 183,21 at:341,658 fill:wood.night a:.6 blur:6
  ellipse 110,24 at:590,630 fill:wood.mint a:.17 blur:18

layer fox_tail
  path "M340 640 C222 670 126 635 133 550 C136 504 181 472 222 481 C196 520 228 542 274 540 C339 538 390 586 340 640 Z" fill:wood.orange stroke:wood.ink,5 name:tail
    path "M123 478 L234 470 C194 518 226 539 246 541 C217 564 211 577 208 597 C174 576 149 575 128 580 Z" fill:wood.cream
    path "M133 610 Q232 661 340 602 L367 666 L127 672 Z" fill:wood.orange.1

layer fox_body
  path "M307 435 C268 470 258 550 268 604 C271 645 311 657 361 648 C415 646 436 619 421 570 L399 462 Z" fill:wood.orange stroke:wood.ink,5 name:body
    ellipse 49,85 at:351,551 fill:wood.cream
    ellipse 31,95 at:418,542 fill:wood.mint a:.2
  path "M307 535 Q295 581 305 628 Q319 642 336 628 L336 559" fill:wood.orange stroke:wood.ink,4 name:left_paw
  path "M370 552 L366 628 Q383 642 402 628 Q411 589 397 543" fill:wood.orange stroke:wood.ink,4 name:right_paw
  curve 317,625 317,632 stroke:wood.ink,2
  curve 386,625 386,632 stroke:wood.ink,2

layer fox_head
  path "M257 358 Q232 305 247 236 Q291 247 324 295 L377 296 Q411 247 449 238 Q463 306 438 361 Z" fill:wood.orange stroke:wood.ink,5 name:ears
  path "M260 307 L258 260 Q285 275 302 303 Z" fill:wood.ink
  path "M398 305 Q419 274 438 262 L433 316 Z" fill:wood.ink
  path "M261 350 Q286 298 350 305 Q413 300 438 350 L458 382 L438 389 L445 405 L418 409 Q398 457 350 470 Q299 458 273 414 L249 410 L258 393 L240 385 Z" fill:wood.orange stroke:wood.ink,5 name:head
    path "M246 369 Q290 367 350 413 Q403 370 459 365 L465 471 L238 481 Z" fill:wood.cream
    path "M415 306 L462 309 L465 465 L413 469 Q434 405 415 306 Z" fill:wood.mint a:.17
  curve 282,369 294,378 307,370 stroke:wood.ink,5 name:eye_left
  curve 388,370 401,378 413,367 stroke:wood.ink,5 name:eye_right
  ellipse 14,7 at:283,395 fill:wood.pink a:.65
  ellipse 14,7 at:413,394 fill:wood.pink a:.65
  path "M338 409 Q350 403 362 409 Q361 420 350 424 Q339 419 338 409 Z" fill:wood.ink name:nose
  curve 350,423 350,432 340,437 stroke:wood.ink,2.5
  curve 350,432 361,436 369,430 stroke:wood.ink,2.5

layer mushroom_glow
  ellipse 91,69 at:585,482 fill:wood.mint a:.15 blur:27

layer mushroom
  path "M565 485 Q575 548 556 615 Q580 633 610 615 Q590 558 605 485 Z" fill:grad(right wood.cream.2 wood.mint.3) stroke:wood.moss.1,4 name:stem
    curve 589,522 584,565 585,606 stroke:wood.mint.1,3
  path "M484 486 C505 471 517 405 571 392 C624 379 664 443 683 475 Q688 491 669 499 Q580 521 492 503 Q478 500 484 486 Z" fill:grad(down wood.mint.2 wood.mint.4) stroke:wood.moss.1,4 name:cap
    ellipse 88,14 at:584,497 fill:wood.mint.1
    ellipse 22,12 at:560,418 rot:-20 fill:wood.cream.4
    ellipse 17,10 at:615,433 rot:26 fill:wood.cream.4
    ellipse 11,8 at:523,458 rot:-35 fill:wood.cream.4
    ellipse 13,8 at:651,470 rot:24 fill:wood.cream.4
    fx glow 12 color:wood.mint a:.5
  curve 510,498 550,505 576,507 stroke:wood.mint.4,3

layer forest_floor
  curve 176,648 166,628 168,611 stroke:wood.moss.2,4
  curve 176,648 185,625 195,620 stroke:wood.moss.2,4
  curve 640,641 646,615 660,604 stroke:wood.moss.2,4
  curve 648,639 672,623 679,625 stroke:wood.moss.2,4
  ellipse 12,5 at:479,654 rot:-20 fill:wood.moss.2
  ellipse 10,4 at:526,647 rot:20 fill:wood.mint.1
  ellipse 8,4 at:227,667 fill:wood.moss.2

layer fireflies
  circle 3 at:510,348 fill:wood.mint.4
    fx glow 7 color:wood.mint
  circle 2 at:666,373 fill:wood.mint.4
    fx glow 6 color:wood.mint
  circle 2.5 at:478,559 fill:wood.mint.4
    fx glow 6 color:wood.mint
  circle 2 at:199,413 fill:wood.mint.3
    fx glow 5 color:wood.mint
  path "M591 301 L594 309 L602 312 L594 315 L591 323 L588 315 L580 312 L588 309 Z" fill:wood.mint.3
