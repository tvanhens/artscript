    path "M246 390 Q280 375 314 406 Q337 430 351 437 Q371 427 389 406 Q423 375 455 388 L469 461 L353 492 L240 450 Z" fill:wood.cream.2
    path "M429 345 Q451 378 433 418 L422 409 Q434 373 416 353 Z" fill:wood.magic.2 a:.25
  curve 286,391 296,383 307,389 stroke:wood.ink,5
  curve 389,389 400,383 410,391 stroke:wood.ink,5
  ellipse 14,7 at:288,410 fill:wood.pink a:.65
  ellipse 14,7 at:410,410 fill:wood.pink a:.65
  path "M338 422 Q350 416 363 422 Q360 434 351 435 Q342 434 338 422 Z" fill:wood.ink
  curve 351,435 351,444 342,448 334,444 stroke:wood.ink,3
  curve 351,444 360,448 369,443 stroke:wood.ink,3
  curve 326,313 337,302 336,318 stroke:wood.fur.3,5

layer mushroom_light
  ellipse 80,79 at:560,526 fill:wood.magic.2 a:.12 blur:26

