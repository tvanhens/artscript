@target fox-and-mushroom.png 800x800 bg:wood.night

palette wood
  color night #102d36
  color trees #193e46
  color distant #24505a
  color ink #362f37
  ramp moss #32736b 5
  ramp fur #e98140 5
  ramp cream #ffe5b7 5
  ramp magic #8df2cd 5
  color pink #e99a88

layer forest
  circle 330 at:400,384 fill:grad(down wood.trees wood.night)
  path "M110 610 Q156 385 132 158 Q171 196 174 350 L201 272 L185 397 Q178 511 205 610 Z" fill:wood.trees
  path "M633 615 Q660 388 623 174 Q674 215 682 395 L713 330 L690 441 L712 615 Z" fill:wood.trees
