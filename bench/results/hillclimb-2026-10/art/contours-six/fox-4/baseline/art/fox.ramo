  curve 500,519 535,529 559,530 598,520 stroke:wood.magic.3,3
  path "M472 509 C483 480 507 440 547 436 C588 429 626 466 648 507 Q615 526 560 516 Q507 529 472 509 Z" fill:grad(down wood.magic.1 wood.magic.3) stroke:wood.magic.4,4 name:cap
