  path "M309 528 Q299 570 309 609 Q326 625 345 610 L346 551" fill:wood.fur.2 stroke:wood.ink,5
  path "M379 546 L380 611 Q399 625 417 609 L414 563" fill:wood.fur.3 stroke:wood.ink,5
