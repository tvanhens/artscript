@target treasure-chest.png 512x512 bg:none
@target treasure-chest.svg 512x512 bg:none

palette treasure
  color ink #302036
  color wood #ad4e27
  color woodlight #dc8040
  color wooddark #69302b
  color gold #ffc83d
  color goldlight #fff1a0
  color golddark #bd741b
  color cavity #392331
  color gleam #fff9d2
  color shadow #231c38

def coin size:44x28
  ellipse 22,12 at:0,5 fill:treasure.golddark stroke:treasure.ink,3
  ellipse 22,12 fill:treasure.gold stroke:treasure.ink,3
    ellipse 15,7 fill:none stroke:treasure.goldlight,2
    curve -7,-5 3,-7 10,-4 stroke:treasure.gleam,2
  curve -12,10 -12,15 stroke:treasure.gold,2
  curve 2,12 2,16 stroke:treasure.gold,2

def sparkle size:40
  path "M0 -20 Q3 -3 16 0 Q3 3 0 20 Q-3 3 -16 0 Q-3 -3 0 -20Z" fill:treasure.gleam stroke:treasure.golddark,2

layer ground_shadow
  ellipse 190,25 at:260,437 fill:treasure.shadow a:.2 blur:7

layer open_lid
  path "M108 242 L97 169 Q97 115 148 95 L326 65 Q370 66 388 112 L403 193 L342 239Z" fill:treasure.gold stroke:treasure.ink,9 name:lid
    path "M119 221 L113 165 Q115 126 152 113 L322 84 Q351 85 367 121 L380 183 L337 218Z" fill:treasure.wooddark stroke:treasure.ink,5
    path "M124 164 Q122 133 157 122 L322 94 Q345 94 359 124 L369 175 L142 214Z" fill:treasure.wood
    curve 139,151 338,116 stroke:treasure.woodlight,5
    curve 145,180 357,141 stroke:treasure.wooddark,4
    path "M159 113 L178 109 L195 204 L176 209Z" fill:treasure.gold stroke:treasure.ink,4
    path "M303 87 L322 84 L345 180 L325 187Z" fill:treasure.gold stroke:treasure.ink,4
    curve 111,164 111,151 120,132 stroke:treasure.goldlight,5

layer chest_box
  path "M101 260 L334 223 L413 264 L397 406 L317 447 L117 399Z" fill:treasure.golddark stroke:treasure.ink,9 name:box
  path "M113 278 L319 315 L315 431 L128 389Z" fill:treasure.wood stroke:treasure.ink,5 name:front
    path "M113 278 L319 315 L319 351 L117 311Z" fill:treasure.woodlight
    curve 121,325 314,365 stroke:treasure.wooddark,4
    curve 124,362 313,403 stroke:treasure.wooddark,4
    curve 156,315 180,317 207,325 stroke:treasure.wood,3
    curve 195,379 218,381 247,390 stroke:treasure.woodlight,3
  path "M332 314 L399 279 L385 397 L327 429Z" fill:treasure.wooddark stroke:treasure.ink,4
    curve 330,360 392,326 stroke:treasure.wood,4
    curve 330,398 388,365 stroke:treasure.wood,4
  path "M100 260 L333 222 L413 263 L321 318Z" fill:treasure.cavity stroke:treasure.ink,7 name:opening

layer overflowing_gold
  each row in 0..4
    each col in 0..6
      coin at:135+col*36+mod(row 2)*14,261-row*16+col*3 rot:-9
  coin at:212,196 rot:24
  coin at:257,184 rot:-12
  coin at:300,205 rot:14
  coin at:338,237 rot:-22
  coin at:369,256 rot:13
  coin at:151,250 rot:-18
  coin at:185,279 rot:18
  coin at:247,284 rot:-20
  coin at:292,293 rot:16

layer metal_fittings
  path "M105 272 L322 311 L410 264 L408 281 L324 331 L107 289Z" fill:treasure.gold stroke:treasure.ink,5 name:rim
    curve 116,276 321,315 399,274 stroke:treasure.goldlight,4
  path "M124 293 L145 297 L157 397 L135 392Z" fill:treasure.gold stroke:treasure.ink,4
    curve 130,300 140,378 stroke:treasure.goldlight,3
  path "M285 323 L307 328 L305 431 L282 426Z" fill:treasure.gold stroke:treasure.ink,4
    curve 290,333 289,411 stroke:treasure.goldlight,3
  path "M120 385 L316 427 L392 390 L391 407 L318 447 L120 404Z" fill:treasure.gold stroke:treasure.ink,5
  path "M206 306 L244 313 L242 362 Q226 376 210 357Z" fill:treasure.gold stroke:treasure.ink,5 name:lock
    curve 215,315 236,319 stroke:treasure.goldlight,4
    circle 6 at:226,338 fill:treasure.ink
    path "M223 339 L220 351 L230 353 L229 339Z" fill:treasure.ink
  each pos in [136,308 147,383 295,342 293,414 339,426 380,403]
    circle 4 at:pos fill:treasure.golddark stroke:treasure.ink,1.5

layer spilled_coins
  coin at:105,423 rot:-12
  coin at:150,445 rot:8
  coin at:372,444 rot:-8
  coin at:404,421 rot:15
  coin at:384,412 rot:-5
  coin at:397,399 rot:12

layer magic_sparkles
  sparkle at:201,151 scale:.75
  sparkle at:316,164 scale:.65
  sparkle at:423,217 scale:.9
  sparkle at:80,322 scale:.65
  circle 4 at:388,204 fill:treasure.gleam
  circle 3 at:176,182 fill:treasure.goldlight
