@target treasure-chest.png 512x512 scale:1,2 bg:none
@target treasure-chest.svg 512x512 bg:none

palette loot
  color ink #39233b
  color dark #281e32
  color cream #fff4be
  ramp wood #a44f2c 5
  ramp gold #efb52e 5

def coin size:20x16
  ellipse 19,10 at:0,4 fill:loot.gold.1 stroke:loot.ink,2.5
  ellipse 19,10 fill:grad(down loot.gold.4 loot.gold.2) stroke:loot.gold.0,2
    ellipse 13,6 fill:none stroke:loot.gold.1,1.5
    curve -7,-4 0,-6 7,-4 stroke:loot.cream,2
  curve -12,5 -12,9 stroke:loot.gold.3,2
  curve 0,8 0,12 stroke:loot.gold.3,2
  curve 11,6 11,10 stroke:loot.gold.3,2

def gleam size:30
  path "M0 -19 L4 -4 L15 0 L4 4 L0 19 L-4 4 L-15 0 L-4 -4 Z" fill:loot.cream

layer ground_shadow
  ellipse 185,23 at:264,435 fill:loot.dark a:.22 blur:7

layer open_lid
  path "M106 242 L91 147 Q88 110 121 95 L319 58 Q345 55 363 80 L414 174 L359 250 Z" fill:grad(down loot.gold.4 loot.gold.1) stroke:loot.ink,8 name:lid
  path "M121 218 L109 145 Q106 125 130 115 L322 79 Q335 76 346 94 L389 169 L348 226 Z" fill:grad(down loot.wood.1 loot.wood.0) stroke:loot.ink,5
  path "M139 199 L129 145 Q127 137 141 132 L319 99 Q325 97 331 107 L365 166 L338 203 Z" fill:loot.dark stroke:loot.wood.2,5
  curve 104,141 126,127 326,89 343,98 stroke:loot.cream,3
  path "M151 107 L173 103 L195 218 L172 222 Z" fill:grad(right loot.gold.3 loot.gold.1) stroke:loot.ink,4
  path "M290 80 L310 76 L362 196 L340 201 Z" fill:grad(right loot.gold.3 loot.gold.1) stroke:loot.ink,4
  each pos in [158,119 176,203 302,91 344,187]
    circle 4 at:pos fill:loot.gold.0 stroke:loot.gold.4,1.5

layer chest_shell
  path "M100 255 L326 220 L413 267 L386 401 Q280 454 123 404 Z" fill:loot.wood.0 stroke:loot.ink,9 name:body
  path "M100 255 L325 221 L410 266 L193 314 Z" fill:loot.dark stroke:loot.ink,5

layer overflowing_coins
  each row in 0..4
    each col in 0..7
      coin at:136+col*32+mod(row 2)*12,245-row*17-col*3 rot:-9
  coin at:210,167 rot:-24
  coin at:250,158 rot:13
  coin at:291,169 rot:-14
  coin at:178,185 rot:15
  coin at:324,188 rot:20
  coin at:365,224 rot:26
  coin at:145,255 rot:-23

layer front_wood
  path "M104 275 L324 297 L306 430 L124 405 Z" fill:grad(down loot.wood.3 loot.wood.1) stroke:loot.ink,7 name:front
    curve 106,321 210,337 321,344 stroke:loot.wood.0,4
    curve 111,363 209,380 316,384 stroke:loot.wood.0,4
    curve 140,300 183,307 209,306 stroke:loot.wood.4,3
    curve 172,350 194,347 237,357 stroke:loot.wood.1,3
    curve 145,385 188,395 227,397 stroke:loot.wood.3,3
    ellipse 14,4 at:261,368 fill:none stroke:loot.wood.0,2
  path "M324 297 L410 266 L386 401 L306 430 Z" fill:grad(right loot.wood.1 loot.wood.0) stroke:loot.ink,7
    curve 319,343 404,313 stroke:loot.ink,3
    curve 314,385 396,354 stroke:loot.ink,3
    curve 346,319 378,307 stroke:loot.wood.3,3

layer gold_hardware
  path "M102 265 L325 287 L412 256 L411 279 L325 311 L105 289 Z" fill:grad(down loot.gold.4 loot.gold.1) stroke:loot.ink,5
  curve 112,271 325,294 401,267 stroke:loot.cream,3
  path "M121 289 L147 293 L162 409 L134 405 Z" fill:grad(right loot.gold.4 loot.gold.1) stroke:loot.ink,4
  path "M274 306 L299 309 L286 430 L261 424 Z" fill:grad(right loot.gold.3 loot.gold.1) stroke:loot.ink,4
  path "M376 291 L395 284 L373 404 L353 411 Z" fill:grad(right loot.gold.2 loot.gold.0) stroke:loot.ink,4
  path "M128 390 L306 414 L386 386 L383 405 L306 437 L130 412 Z" fill:grad(down loot.gold.3 loot.gold.1) stroke:loot.ink,5
  each pos in [137,306 148,390 286,322 274,407 385,302 366,391]
    circle 4 at:pos fill:loot.gold.0 stroke:loot.gold.4,1.5
  path "M202 295 L247 300 L245 344 Q224 359 204 342 Z" fill:grad(down loot.gold.4 loot.gold.1) stroke:loot.ink,5
  rect 31x39 r:9 at:225,333 fill:grad(down loot.gold.3 loot.gold.1) stroke:loot.ink,4
  circle 5 at:225,329 fill:loot.dark
  path "M222 330 L220 341 L229 341 L227 330 Z" fill:loot.dark

layer spilled_treasure
  coin at:338,436 rot:-7
  coin at:377,427 rot:9
  coin at:401,444 rot:-9
  coin at:112,432 rot:8
  coin at:145,445 rot:-10
  coin at:92,405 rot:-24
  coin at:362,416 rot:14
  coin at:330,327 rot:70
  coin at:352,357 rot:58

layer magic_sparkles
  gleam at:103,200 scale:.8
  gleam at:280,131 scale:.75
  gleam at:420,215 scale:1.1
  gleam at:435,369 scale:.6
  gleam at:189,218 scale:.55
  circle 3 at:393,179 fill:loot.cream
  circle 3 at:77,235 fill:loot.gold.3
  circle 3 at:307,147 fill:loot.gold.4
