@target lighthouse.png 1200x900 bg:dusk.paper

palette dusk
  color paper #f5eddf
  ramp sky #77748f #efc4b2 5
  ramp sea #3d566f #a4abb6 5
  ramp rock #323b51 #b49994 5
  ramp grass #515e59 #a5a184 5
  ramp wall #8e93a3 #fff0d4 5
  ramp roof #333d50 #a56c69 5
  ramp gold #d99c64 #fff1b6 5

brush wash rag:4 reach:4
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 45 + seeded(m), 4);
    float grain = vnoise(m.p * 1.8 + seeded(m));
    float edge = m.edge + (n - .5) * rag;
    float pool = (1 - smoothstep(0, 9, m.edge)) * .14;
    float bloom = smoothstep(.45, .8, n) * .14;
    float3 pigment = m.paint.rgb * ( .91 + n * .13 - pool);
    return float4(pigment, cover(edge, m) * (.79 + grain * .17 - bloom));
  }
  """

layer sky_washes brush:wash
  rect 1090x780 at:600,440 r:25 fill:grad(down dusk.sky.0 dusk.sky.3 dusk.sky.4) name:sky
  curve 85,255 280,228 485,270 720,227 1105,247 stroke:dusk.sky.0,[12 65 25 48 3] a:.19 name:cloudbank
  curve 110,330 350,309 540,337 795,292 1080,316 stroke:dusk.sky.4,[4 42 16 37 5] a:.5 name:peach_cloud
  curve 100,150 330,162 485,130 790,160 1100,115 stroke:dusk.sky.1,[8 36 15 45 5] a:.28 name:high_cloud

layer sea_washes brush:wash
  path "M57 460 Q280 448 460 460 Q810 445 1143 457 L1140 824 Q900 840 590 821 L58 828 Z" fill:grad(down dusk.sea.4 dusk.sea.1 dusk.sea.0) name:ocean
  curve 70,465 330,462 625,469 885,460 1130,466 stroke:dusk.sky.4,5 a:.55 name:horizon
  each i in 0..32
    let x = rand(95 1080)
    let y = rand(490 812)
    curve x,y x+rand(25 65),y-2 x+rand(80 125),y+1 stroke:dusk.sea.4,rand(1 5) a:rand(.12 .4) seed:i name:ripple
  path "M65 496 Q180 440 277 468 L382 502 L476 515 L62 531 Z" fill:dusk.sea.2 a:.5 name:far_headland

layer cliff_washes brush:wash
  path "M59 664 Q164 635 245 579 L346 566 L423 510 L529 477 L610 484 L673 515 L690 561 L732 586 L702 633 L741 665 L682 701 L648 750 L557 778 L510 829 L59 830 Z" fill:grad(down dusk.rock.3 dusk.rock.0) name:cliff
    path "M430 523 L470 557 L437 600 L483 635 L435 711 L385 815 L470 825 L529 743 L550 645 L514 568 L544 488 Z" fill:dusk.rock.1 a:.65 name:cleft
    path "M605 498 L625 553 L599 600 L627 650 L573 747 L646 713 L682 660 L657 583 L669 533 Z" fill:dusk.rock.0 a:.65 name:seaward_shadow
    each i in 0..18
      let x = rand(135 665)
      let y = rand(570 790)
      curve x,y x-15,y+25 x-24,y+rand(45 95) stroke:dusk.rock.4,rand(3 15) a:.22 seed:i name:stone_mark
  path "M60 655 Q180 612 247 570 L342 555 L420 500 L530 471 L610 478 L668 508 L681 532 L625 526 L559 508 L471 535 L393 565 L309 589 L225 642 L60 704 Z" fill:dusk.grass.1 name:clifftop
  curve 100,657 242,596 365,565 463,515 572,493 652,519 stroke:dusk.grass.4,[6 18 12 20 10 3] a:.6 name:grass_light
  curve 165,690 293,623 394,591 486,528 567,507 stroke:dusk.wall.3,[11 16 8 7 2] a:.5 name:footpath

layer lantern_halo
  circle 68 at:573,294 fill:dusk.gold.3 a:.15 blur:25 name:halo

layer lighthouse_paint brush:wash
  path "M547 329 L599 329 L620 491 Q574 504 525 492 Z" fill:grad(right dusk.wall.4 dusk.wall.3 dusk.wall.0) name:tower
    path "M584 335 L600 335 L621 493 L586 500 Q603 425 584 335 Z" fill:dusk.sea.1 a:.3 name:tower_shadow
    path "M551 430 Q557 421 563 430 L562 447 L551 449 Z" fill:dusk.roof.0 name:lower_window
    path "M561 365 L570 363 L570 378 L560 380 Z" fill:dusk.roof.0 name:upper_window
    path "M551 489 L551 468 Q560 456 568 468 L568 495 Z" fill:dusk.roof.0 name:door
  path "M536 322 L609 322 L607 336 L539 336 Z" fill:dusk.roof.0 name:gallery_base
  rect 51x37 at:573,300 fill:dusk.gold.3 name:lantern_glass
  curve 548,282 548,317 599,317 599,283 stroke:dusk.roof.0,4 name:lantern_frame
  curve 565,282 565,318 stroke:dusk.roof.1,3 name:mullion
  curve 584,281 584,318 stroke:dusk.roof.1,3 name:mullion_right
  path "M533 282 Q548 269 570 256 L576 256 Q595 270 614 282 Z" fill:dusk.roof.0 name:lantern_roof
  curve 572,254 572,243 stroke:dusk.roof.0,3 name:finial
  curve 532,309 533,324 612,324 612,309 stroke:dusk.roof.0,2 name:railing
  each i in 0..6
    curve 535+i*15,312 535+i*15,325 stroke:dusk.roof.0,1.7 seed:i name:rail
  path "M618 467 L682 465 L686 498 L616 498 Z" fill:dusk.wall.3 name:keepers_house
  path "M608 469 L642 445 L691 466 Z" fill:dusk.roof.2 name:cottage_roof
  rect 10x16 at:664,485 fill:dusk.roof.0 name:cottage_window

layer foam brush:wash
  curve 745,654 762,678 717,718 684,733 668,766 608,790 stroke:dusk.paper,[2 7 4 11 6 2] a:.7 name:surf
  curve 767,682 750,722 704,747 stroke:dusk.sea.4,[2 6 1] a:.7 name:outer_surf
  each i in 0..3
    let x = 836+i*63
    let y = 365+i*11
    curve x-11,y+4 x,y x+9,y+3 x+18,y-1 stroke:dusk.roof.0,1.7 a:.65 seed:i name:gull
