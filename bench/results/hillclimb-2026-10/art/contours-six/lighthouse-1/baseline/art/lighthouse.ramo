@target lighthouse.png 1200x900 bg:dusk.paper

palette dusk
  color paper #f4eddd
  color violet #696585
  color rose #ce999e
  color peach #ecc0a0
  color sea #5b7f89
  color deep #334f66
  color rock #55596a
  color earth #948176
  color grass #6f7c6d
  color ivory #eee3cd
  color shadow #9ba5af
  color roof #6e505c
  color ink #354254
  color gold #ffcf7c

brush wash rag:3 reach:3
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 38 + seeded(m), 4);
    float grain = hash12(m.dev + seeded(m));
    float edge = m.edge + (n - .5) * rag;
    float pool = exp(-abs(edge) / 3.5);
    float bloom = smoothstep(.48, .78, n);
    float3 pigment = m.paint.rgb * (0.88 + .16*n - .12*pool);
    pigment = mix(pigment, float3(.97,.94,.88), bloom*.18);
    return float4(pigment, cover(edge,m) * (.76 + .19*n - .07*grain));
  }
  """

layer sky brush:wash
  curve 57,76 265,56 521,67 789,59 1137,81 1146,490 860,503 520,492 56,500 closed fill:grad(down dusk.violet dusk.rose dusk.peach) name:skywash
  curve 81,177 295,135 460,159 643,139 830,167 1108,148 stroke:dusk.violet,42 a:.18 name:cloud_high
  curve 91,294 266,308 400,279 589,299 750,276 981,290 1121,264 stroke:dusk.rose,35 a:.3 name:cloud_low
  curve 103,392 385,373 646,387 910,371 1115,388 stroke:dusk.peach,44 a:.32 name:afterglow

layer ocean brush:wash
  curve 58,463 305,458 628,467 914,458 1142,466 1148,824 918,842 664,827 374,840 59,820 closed fill:grad(down dusk.sea dusk.deep) name:sea_wash
  curve 71,481 247,472 444,481 610,477 807,484 1118,472 stroke:dusk.violet,12 a:.28 name:horizon
  each i in 0..44
    let x = rand(85 1100)
    let y = rand(494 817)
    curve x,y x+rand(15 55),y-2 x+rand(70 120),y+1 stroke:dusk.ivory,rand(1 4) a:rand(.1 .35) seed:i name:ripple

layer distant_land brush:wash
  curve 59,465 114,448 178,453 245,435 306,455 399,466 closed fill:dusk.violet a:.4 name:far_headland

layer cliffs brush:wash
  curve 59,587 163,557 267,545 347,511 435,492 546,501 645,531 697,561 678,594 712,632 676,675 700,703 642,758 574,786 527,836 60,830 closed fill:dusk.rock name:cliff
    curve 281,548 365,530 405,561 377,620 417,669 374,742 392,839 195,846 closed fill:dusk.earth a:.6 name:ochre_face
    curve 506,518 544,569 525,631 570,686 546,774 587,816 683,715 660,647 689,568 closed fill:dusk.deep a:.65 name:shadow_face
    curve 327,561 299,620 322,679 288,751 stroke:dusk.ivory,8 a:.3 name:rock_light
    curve 465,571 449,624 478,681 449,762 stroke:dusk.ink,12 a:.4 name:fissure
    each i in 0..23
      let x = rand(96 636)
      let y = rand(585 799)
      curve x,y x+rand(-18 20),y+35 x-8,y+rand(48 88) stroke:dusk.deep,rand(2 8) a:.25 seed:i name:rock_marks
  curve 58,584 176,548 272,537 356,499 438,480 529,491 598,510 657,538 695,561 618,556 531,534 442,526 348,548 271,569 161,583 59,620 closed fill:dusk.grass name:grassy_cap
  curve 68,581 207,560 331,521 434,504 505,508 568,530 stroke:dusk.peach,10 a:.4 name:cliff_rim
  curve 154,570 293,551 396,530 483,518 530,519 stroke:dusk.ivory,9 a:.57 name:footpath

layer lighthouse brush:wash
  curve 490,510 502,319 541,317 557,514 closed fill:dusk.ivory name:tower
    curve 524,314 545,316 559,520 529,519 closed fill:dusk.shadow a:.65 name:tower_shade
    curve 497,384 550,379 551,399 495,405 closed fill:dusk.roof a:.65 name:paint_band
  rect 70x10 at:523,320 fill:dusk.ink name:balcony_floor
  curve 489,308 490,295 557,295 558,309 stroke:dusk.ink,2 fill:none name:balcony_rail
  each i in 0..6
    curve 491+i*13,295 491+i*13,317 stroke:dusk.ink,1.6 name:railing
  rect 43x35 at:523,286 fill:dusk.gold name:lantern
  rect 8x35 at:505,286 fill:dusk.ink name:lantern_left
  rect 5x35 at:541,286 fill:dusk.ink name:lantern_right
  curve 523,266 523,302 stroke:dusk.ink,2 name:lantern_mullion
  curve 493,266 522,243 552,266 closed fill:dusk.roof name:roof
  curve 523,243 523,231 stroke:dusk.ink,3 name:finial
  rect 10x22 at:522,354 fill:dusk.ink name:upper_window
  rect 11x20 at:523,431 fill:dusk.ink name:lower_window
  rect 17x30 at:523,495 r:7,7,0,0 fill:dusk.ink name:door
  curve 558,485 560,456 603,456 610,489 closed fill:dusk.ivory name:keeper_cottage
  curve 552,458 578,439 610,457 closed fill:dusk.roof name:cottage_roof
  rect 8x12 at:590,473 fill:dusk.ink name:cottage_window

layer beacon brush:wash
  curve 529,283 1006,187 1093,266 closed fill:grad(right fade(dusk.gold .3) fade(dusk.gold 0)) name:beam
  ellipse 38,29 at:524,283 fill:dusk.gold a:.18 name:halo
  ellipse 12,10 at:522,283 fill:dusk.ivory a:.85 name:lamp

layer surf brush:wash
  curve 695,630 738,657 724,696 685,726 646,761 584,787 stroke:dusk.ivory,12 a:.6 name:breaking_surf
  curve 741,710 716,743 662,777 618,799 stroke:dusk.ivory,5 a:.45 name:outer_surf
  curve 797,761 842,752 891,761 953,756 stroke:dusk.ivory,4 a:.35 name:near_wave

layer birds brush:wash
  curve 837,333 846,329 854,335 864,330 873,333 stroke:dusk.ink,2 a:.7 name:gull_one
  curve 901,311 908,308 914,312 920,309 927,310 stroke:dusk.ink,1.5 a:.6 name:gull_two
