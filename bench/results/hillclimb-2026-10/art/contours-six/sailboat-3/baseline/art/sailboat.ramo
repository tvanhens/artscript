@target sailboat.png 1000x1000 bg:book.paper

use std/brushes { bristle }

palette book
  color paper #f4ecd6
  color sky #b9d9d8
  color cloud #f7efd9
  color sea #498eae
  color deep #275e80
  color teal #76b9bf
  color foam #dce8d7
  color red #ce483c
  color scarlet #e86748
  color wine #8b343d
  color cream #f4dfac
  color gold #d6b67c
  color timber #6b5146

brush gouache grain:.12
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / float2(12, 5) + seeded(m), 3);
    float tooth = hash12(m.p * 1.3 + seeded(m));
    float3 c = m.paint.rgb * (1.0 + (n-.5)*grain + (tooth-.5)*.065);
    return float4(c, cover(m.edge + (n-.5)*1.6, m));
  }
  """

layer atmosphere brush:gouache
  rect 900x900 at:500,500 r:8 fill:book.sky name:painted_page
    rect 900x510 at:0,235 fill:grad(down book.teal book.sea) name:water
    path "M-450 -104 Q-280 -128 -100 -101 T450 -110 L450 -450 L-450 -450 Z" fill:grad(down book.sky book.cloud) a:.4 name:haze
  path "M130 247 Q160 230 195 237 Q212 209 247 221 Q274 214 297 239 Q338 238 358 254 Q245 268 130 257Z" fill:book.cloud a:.72 name:cloud_left
  path "M667 174 Q712 146 752 165 Q788 137 823 170 Q859 169 881 188 Q775 198 667 185Z" fill:book.cloud a:.65 name:cloud_right
  circle 48 at:774,291 fill:book.cloud a:.65 name:sun

layer distant_water brush:gouache
  each i in 0..65
    let x = rand(85 915)
    let y = rand(440 905)
    curve x,y x+rand(10 28),y-3 x+rand(32 65),y stroke:mix(book.teal book.foam rand(.05 .5)),rand(2 6) brush:bristle name:wavelet
  curve 91,489 234,477 370,485 stroke:book.foam,5 a:.4 brush:bristle name:horizon_glint
  curve 658,465 771,457 905,466 stroke:book.foam,4 a:.4 brush:bristle name:far_glint

layer reflection brush:gouache
  each i in 0..16
    let y = 722+i*9
    let x = 477+sin(i*51)*28
    curve x-65,y x,y+3 x+85-i*2,y-1 stroke:mix(book.red book.sea i/22),8-i*.3 a:.5 brush:bristle name:red_ripples
  path "M261 672 Q453 650 731 704 Q682 758 505 760 Q342 747 261 703Z" fill:book.deep a:.45 name:boat_shadow

layer boat brush:gouache
  path "M288 612 Q430 582 584 615 L737 685 Q623 721 490 711 L297 657Z" fill:book.wine name:far_hull
  path "M288 612 Q430 594 580 626 L737 685 Q624 704 490 681 L308 639Z" fill:book.cream name:deck
  path "M340 622 Q429 609 524 631 L638 673 Q553 686 459 663 L341 640Z" fill:book.timber name:cockpit
  path "M363 629 Q439 621 515 640 L587 667 Q509 666 436 647 L361 640Z" fill:book.wine name:cockpit_inner
  path "M303 640 Q461 668 525 673 Q630 693 737 685 Q704 742 639 759 Q449 751 332 699Z" fill:book.red name:hull
    path "M300 668 Q471 713 640 719 L743 686 L740 777 L325 735Z" fill:book.wine a:.65 name:lower_shade
    curve 343,661 460,692 591,707 stroke:book.scarlet,18 brush:bristle name:paint_light
    curve 358,688 464,717 569,730 stroke:book.scarlet,5 a:.6 brush:bristle name:lower_glint
  path "M737 685 Q713 734 639 759 L622 699Z" fill:book.scarlet name:bow_facet
    curve 716,702 697,726 662,744 stroke:book.red,12 brush:bristle name:bow_shade
  curve 305,641 475,677 623,701 737,685 stroke:book.cream,7 name:gunwale
  curve 331,697 478,742 638,757 stroke:book.deep,5 name:waterline
  curve 487,638 481,210 stroke:book.timber,10 name:mast
  curve 481,215 484,629 stroke:book.gold,3 name:mast_light
  curve 479,216 315,623 stroke:book.timber,1.6 a:.7 name:rear_stay
  curve 486,231 729,680 stroke:book.timber,1.6 a:.65 name:forestay
  curve 482,590 297,565 stroke:book.timber,7 name:boom
  path "M467 242 Q382 332 300 543 Q373 563 469 577 Q447 425 467 242Z" fill:book.cream name:main_sail
    path "M467 242 Q411 412 440 573 L478 587 L480 244Z" fill:book.gold a:.75 name:leech_shade
    curve 449,282 375,410 328,532 stroke:book.cloud,28 a:.65 brush:bristle name:canvas_light
    curve 431,344 389,435 369,548 stroke:book.gold,2 a:.65 name:seam_one
    curve 407,420 385,481 377,552 stroke:book.cloud,4 name:seam_light
    curve 309,535 379,550 462,568 stroke:book.gold,3 name:foot_seam
  path "M498 264 Q572 398 697 624 Q605 593 504 599 Q526 428 498 264Z" fill:book.cloud name:jib
    path "M498 264 Q541 450 528 599 L502 601 Q525 416 498 264Z" fill:book.gold a:.64 name:jib_shadow
    curve 521,324 588,457 659,581 stroke:book.cream,16 brush:bristle name:jib_wash
    curve 535,365 567,475 584,598 stroke:book.gold,2 a:.5 name:jib_seam
  path "M482 211 L481 177 Q508 169 538 182 L515 193 L537 205 Q507 196 482 211Z" fill:book.red name:pennant
  curve 483,178 482,217 stroke:book.timber,4 name:finial
  curve 470,580 439,650 stroke:book.gold,2 name:sheet

layer wake brush:gouache
  curve 736,709 770,718 745,738 695,755 stroke:book.foam,[2 7 5 1] brush:bristle name:bow_wave
  curve 329,704 301,708 263,699 211,710 stroke:book.foam,[2 6 5 1] brush:bristle name:stern_wake
  curve 360,753 459,777 583,777 stroke:book.teal,[2 8 2] brush:bristle name:near_wave
  curve 643,801 716,790 787,804 stroke:book.foam,[1 5 1] brush:bristle name:foreground_wave
  curve 153,821 232,811 300,826 stroke:book.teal,[2 7 1] brush:bristle name:foreground_blue
