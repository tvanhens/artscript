@target fern.png 1000x1300
@target fern.svg 1000x1300

palette botanical
  color ivory #f3ebd9
  color ink #414637
  color vein #73725b
  ramp paper #e9dfca #f7f0e2 5

# A pointed, softly toothed pinnule, with a forked venation.
def pinnule length:29 width:8
  group scale:length/29,width/8
    curve 0,0 4,-4 8,-4.5 10,-6.7 14,-6 17,-7 21,-4.9 29,-1 23,2 20,4.8 16,4 13,5.9 9,4 6,4.5 3,2 closed fill:botanical.ivory stroke:botanical.ink,.72 name:blade
      curve 0,0 10,-.2 20,-.8 28,-1 fill:none stroke:botanical.vein,.55 name:midvein
      each k in 0..4
        let x = 6+k*4
        curve x,0 x+2,-2 x+3,-4.6 fill:none stroke:botanical.vein,.36 name:veins_upper
        curve x,0 x+1,2 x+3,3.5 fill:none stroke:botanical.vein,.36 name:veins_lower

def pinna span:230
  group scale:span/230
    each j in 0..12
      let u = j/12
      let x = 12+j*17
      let y = -x*.27-x*x*.00065
      let l = 43*powder(u)+8
      pinnule length:l width:7.4*(1-u*.6) at:x,y rot:-64+u*15 name:upper
      pinnule length:l*.93 width:7.4*(1-u*.6) at:x+6,y-2 rot:41+u*8 name:lower
    curve 0,0 60,-18 120,-42 180,-70 230,-98 fill:none stroke:botanical.ink,[1.05 .9 .65 .4 .15] name:rachis
    pinnule length:30 width:4 at:207,-87 rot:-24 name:point

fn powder(u) = sin(27+u*142)*(1-u*.5)
fn stemx(q) = 409+145*q+31*sin(q*150)
fn stemy(q) = 1050-865*q

layer paper
  rect 1000x1300 at:500,650 fill:fbm(simplex(2 seed:17)) -> botanical.paper a:.45 name:paper_fibers
  rect 1000x1300 at:500,650 fill:botanical.ivory a:.65 name:paper_tone

layer frond
  each i in 0..17
    let q = .08+i*.052
    let span = 263*sin(30+q*145)*(1-q*.42)
    pinna span:span at:stemx(q),stemy(q) rot:-8-q*10 name:right_pinna
    pinna span:span*.93 at:stemx(q+.018),stemy(q+.018) scale:-1,1 rot:10+q*8 name:left_pinna
  curve 386,1145 409,1050 456,855 509,635 551,414 575,236 582,167 fill:none stroke:botanical.ink,[2.5 2.3 1.9 1.5 1 .6 .12] name:main_stem
  curve 389,1143 413,1050 460,855 512,635 553,414 fill:none stroke:botanical.vein,[.5 .6 .4 .25 .1] name:stem_highlight
  pinnule length:40 width:5 at:579,203 rot:-85 name:terminal_leaf
