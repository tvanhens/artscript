@target health-potion.png 64x64 bg:none

palette potion
  color ink #261c35
  color glass #709ca9
  color light #b4e1df
  color gleam #effff1
  color deep #700d39
  color red #c51e46
  color bright #f34458
  color pink #ff8b8c
  color cork #b97542
  color corklight #e6ad65
  color corkdark #75412f

# All contours follow whole-pixel steps; no smooth curves or soft shading.
layer glass_body
  path "M24 14H40V24H44V28H48V34H52V50H48V56H42V60H22V56H16V50H12V34H16V28H20V24H24Z" fill:potion.ink name:bottle
    path "M26 16H38V26H42V30H46V36H50V48H46V54H40V58H24V54H18V48H14V36H18V30H22V26H26Z" fill:potion.glass
    path "M26 18H30V28H24V32H20V38H16V46H18V34H22V30H28V26H30V18Z" fill:potion.light
    path "M40 30H44V36H48V48H44V54H38V56H28V54H24V52H42V48H46V38H42V34H40Z" fill:potion.light

layer elixir
  path "M18 36H24V34H34V36H46V40H48V48H44V54H38V56H26V54H20V50H16V40H18Z" fill:potion.deep name:liquid
    path "M18 38H26V36H34V38H46V46H42V50H36V52H24V50H20V46H18Z" fill:potion.red
    path "M18 38H26V36H34V38H44V40H30V38H24V40H18Z" fill:potion.pink
    path "M20 40H26V42H36V40H44V44H40V48H34V50H24V48H20Z" fill:potion.bright
    rect 4x4 at:25,45 fill:potion.pink
    rect 2x2 at:35,41 fill:potion.pink

layer reflections
  path "M20 30H24V34H22V40H20V46H18V36H20Z" fill:potion.gleam name:shine
  rect 2x4 at:21,49 fill:potion.light
  rect 2x8 at:47,42 fill:potion.light
  rect 8x2 at:32,57 fill:potion.glass

layer stopper
  path "M24 4H40V8H42V16H38V20H26V16H22V8H24Z" fill:potion.ink name:cork
    path "M26 6H38V10H40V14H36V18H28V14H24V10H26Z" fill:potion.cork
    path "M26 6H38V10H26Z" fill:potion.corklight
    rect 4x6 at:28,11 fill:potion.corklight
    path "M36 10H40V14H36V18H28V16H34V14H36Z" fill:potion.corkdark
    rect 2x2 at:33,11 fill:potion.corkdark
  path "M22 18H42V20H44V24H42V26H22V24H20V20H22Z" fill:potion.ink name:rim
    path "M22 20H42V24H22Z" fill:potion.glass
    rect 14x2 at:29,21 fill:potion.gleam
    rect 4x2 at:40,23 fill:potion.light
