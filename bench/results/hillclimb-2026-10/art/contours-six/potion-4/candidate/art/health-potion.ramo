    rect 4x8 at:38,13 fill:potion.corkshade
    rect 2x2 at:28,12 fill:potion.corkshade
    rect 2x2 at:33,9 fill:potion.cork
  rect 20x4 at:32,18 fill:potion.ink name:rim
  rect 16x2 at:32,17 fill:potion.pale
  rect 4x2 at:37,17 fill:potion.glass
