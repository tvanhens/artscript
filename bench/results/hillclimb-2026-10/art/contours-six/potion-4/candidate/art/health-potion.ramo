    rect 4x2 at:23,38 fill:potion.pink
    rect 2x2 at:39,46 fill:potion.bright

layer reflections
  rect 2x6 at:21,33 fill:potion.white
  rect 2x8 at:19,42 fill:potion.pale
  rect 4x2 at:22,49 fill:potion.pale
  rect 8x2 at:32,56 fill:potion.pale
  rect 2x4 at:46,46 fill:potion.glass
  rect 2x6 at:28,23 fill:potion.white

layer stopper_layer
