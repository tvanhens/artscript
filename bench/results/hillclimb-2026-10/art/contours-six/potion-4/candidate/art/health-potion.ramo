@target health-potion.png 64x64 bg:none

palette potion
  color ink #251c35
  color glass #77a5b6
  color pale #bde4df
  color white #f4ffe9
  color deep #791936
  color red #cc2546
  color bright #fa5260
  color pink #ff9b94
  color cork #bd7850
  color corkshade #784532
  color corklight #e7af6b

layer bottle_layer
  path "M24 15H40V25H44V29H48V35H52V49H50V53H46V57H40V59H24V57H18V53H14V49H12V35H16V29H20V25H24Z" fill:potion.ink name:bottle
