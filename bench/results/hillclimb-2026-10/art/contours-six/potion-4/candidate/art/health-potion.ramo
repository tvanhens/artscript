    path "M38 27H42V31H46V37H49V48H45V36H42V32H38Z" fill:potion.deep

layer liquid_layer
  path "M19 35H25V37H39V35H45V39H47V47H45V51H41V53H37V55H27V53H23V51H19V47H17V39H19Z" fill:potion.deep name:liquid
