@target sailboat.png 1000x850 bg:book.paper

use std/brushes { bristle }

palette book
  color paper #f3e9d2
  ramp sky #b8d5d2 5
  ramp sea #368ba7 5
  ramp red #c34a35 5
  ramp cream #f5dfac 5
  ramp wood #956644 5
  color ink #354957
  color mist #dce7d9

# Opaque gouache with paper tooth and small irregular edges.
brush gouache grain:.13 rag:1.3 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 23 + seeded(m), 3);
    float tooth = hash12(floor(m.dev / 1.2) + seeded(m));
    float streak = vnoise(float2(m.uv.x / 45, m.uv.y / 2.8) + seeded(m));
    float3 c = m.paint.rgb * (1 + (n-.5)*grain + (streak-.5)*.045);
    return float4(c, cover(m.edge + (n-.5)*rag, m) * (.94 + .06*tooth));
  }
  """

layer sky_wash brush:gouache
  rect 922x772 at:500,425 r:8 fill:grad(down book.sky.2 book.cream.4) name:sky
  circle 49 at:772,176 fill:book.cream.4 a:.7 name:sun
  path "M107 235 C151 223 163 239 199 226 C221 213 227 192 260 199 C295 204 297 226 336 222 C366 219 392 235 409 243 C302 254 202 260 107 247Z" fill:book.mist a:.65 name:cloud_left
  path "M556 119 C587 101 613 119 637 114 C667 104 686 125 724 125 C669 138 596 141 549 133Z" fill:book.mist a:.6 name:cloud_high
  path "M41 378 C149 361 182 382 266 367 C340 349 419 374 497 362 C609 350 692 379 792 357 C863 344 914 354 960 361 L960 435 L41 435Z" fill:book.sky.1 a:.4 name:distant_shore

layer ocean brush:gouache
  path "M40 395 C211 385 330 404 492 391 C653 382 797 400 960 388 L960 810 L40 810Z" fill:grad(down book.sea.3 book.sea.1) name:water
    each i in 0..100
      let x = rand(45 955)
      let y = rand(407 800)
      let w = rand(14 66)*(y/700)
      curve x,y x+w*.5,y-3 x+w,y+1 stroke:mix(book.sea.4 book.sky.3 rand(0 1)),rand(2 7) a:rand(.14 .48) brush:bristle(strength:.3) name:glints
    each i in 0..45
      let x = rand(55 925)
      let y = rand(460 799)
      curve x,y x+24,y-4 x+64,y+1 stroke:book.sea.0,rand(3 8) a:.18 brush:bristle(strength:.4) name:troughs

layer reflection brush:gouache
  each i in 0..15
    let y = 646+i*8
    let x = 475+sin(i*72)*28
    curve x-65+i*2,y x,y-3 x+95-i*3,y+2 stroke:book.red.2,9-i*.3 a:.3-i*.014 brush:bristle(strength:.45) name:red_reflection
  path "M261 606 C369 591 492 608 635 619 C709 623 772 614 804 632 C737 658 575 671 409 647 C346 638 298 630 261 606Z" fill:book.sea.0 a:.42 name:boat_shadow

layer rigging_back brush:gouache
  curve 342,555 492,152 746,608 stroke:book.wood.1,2 name:stays
  curve 492,151 507,571 stroke:book.wood.1,9 name:mast
  curve 490,152 501,567 stroke:book.cream.3,3 name:mast_light
  path "M491 154 C510 139 524 158 551 146 L539 165 C519 174 509 156 493 170Z" fill:book.red.2 name:pennant

layer canvas_sails brush:gouache
  path "M482 182 C447 246 359 332 301 475 C353 484 423 507 491 524 C464 410 466 292 482 182Z" fill:grad(right book.red.3 book.red.1) name:main_sail
    path "M477 205 C436 302 381 396 335 467 L359 478 C405 360 450 270 477 205Z" fill:book.red.4 a:.36 name:lit_panel
    path "M482 231 C461 342 468 433 491 524 L458 514 C451 426 459 322 482 231Z" fill:book.red.0 a:.4 name:leech_shadow
    curve 449,265 408,366 380,490 stroke:book.cream.2,1.6 a:.4 name:seam_one
    curve 407,323 376,407 350,480 stroke:book.cream.2,1.4 a:.3 name:seam_two
    curve 313,469 399,486 483,515 stroke:book.red.4,4 a:.6 name:foot_light
  path "M507 201 C548 281 643 404 710 535 C645 527 577 535 523 548 C540 422 526 301 507 201Z" fill:grad(right book.cream.4 book.cream.2) name:jib
    path "M508 214 C548 363 573 446 685 527 L710 535 C640 402 558 292 508 214Z" fill:book.cream.1 a:.28 name:curved_panel
    curve 523,261 564,401 619,530 stroke:book.wood.2,1.5 a:.25 name:jib_seam
    curve 530,539 606,523 699,529 stroke:book.cream.4,4 name:jib_hem
  curve 302,480 494,529 stroke:book.wood.1,7 name:boom
  curve 310,478 490,524 stroke:book.cream.3,2 name:boom_light
  curve 312,482 386,562 stroke:book.cream.2,2 name:sheet

layer hull_paint brush:gouache
  path "M302 556 C397 546 519 560 584 573 L748 611 L624 633 C500 624 383 600 302 556Z" fill:book.wood.3 name:deck
    path "M326 558 L584 583 L702 609 L620 618 C495 604 393 583 326 558Z" fill:book.cream.2 name:deck_inlay
    curve 347,561 490,585 668,613 stroke:book.wood.2,2 name:deck_seam
  path "M302 556 C409 591 529 614 624 623 L748 611 C714 638 672 677 617 682 C484 672 376 628 323 594Z" fill:grad(down book.red.3 book.red.1) name:hull
    path "M624 623 L748 611 C713 643 670 678 617 682Z" fill:book.red.0 a:.65 name:bow_plane
    path "M322 584 C416 626 523 650 625 655 L688 645 L655 670 L613 680 C478 668 378 627 322 584Z" fill:book.red.1 a:.6 name:keel_shadow
    curve 330,590 449,629 575,650 stroke:book.red.4,9 a:.4 brush:bristle(strength:.35) name:hull_brushlight
    curve 335,601 450,641 574,662 stroke:book.red.0,2 a:.35 name:plank_seam
  curve 306,557 438,597 623,625 744,612 stroke:book.cream.3,7 name:gunwale
  curve 311,565 443,605 621,633 730,621 stroke:book.red.0,3 name:rail_shadow
  path "M422 582 L440 567 L501 578 L510 599 L477 604Z" fill:book.wood.0 name:cockpit
  path "M430 579 L442 571 L495 582 L499 588Z" fill:book.wood.3 name:seat
  curve 502,532 505,591 stroke:book.wood.1,8 name:mast_base
  curve 499,534 501,587 stroke:book.cream.3,2 name:mast_base_light
  curve 700,586 706,615 stroke:book.wood.1,3 name:bow_post
  curve 331,542 335,567 stroke:book.wood.1,3 name:stern_post

layer foreground_foam brush:gouache
  curve 271,612 317,630 375,637 stroke:book.mist,5 brush:bristle(strength:.5) name:stern_wake
  curve 645,687 706,667 754,633 784,636 stroke:book.cream.4,[2 7 9 1] brush:bristle(strength:.4) name:bow_splash
  curve 388,687 463,700 550,702 stroke:book.sea.4,6 brush:bristle(strength:.4) name:near_wave
  curve 149,726 212,719 273,728 stroke:book.sky.3,5 brush:bristle(strength:.45) name:front_wave_left
  curve 695,753 767,744 839,750 stroke:book.sky.3,5 brush:bristle(strength:.45) name:front_wave_right

layer birds brush:gouache
  path "M182 322 Q195 309 207 320 Q216 306 231 310" stroke:book.ink,2.5 fill:none name:bird_one
  path "M771 290 Q782 281 791 290 Q800 279 811 283" stroke:book.ink,2 fill:none name:bird_two
