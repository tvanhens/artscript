@target treasure-chest.png 512x512 bg:none
@target treasure-chest.svg 512x512 bg:none

palette treasure
  color ink #382034
  color wood #a64d2b
  color woodlight #dd8545
  color wooddark #713629
  color gold #efad2c
  color goldlight #ffe58a
  color goldshade #b86b20
  color gleam #fff6c9
  color interior #4b2530
  color shadow #2d1c39

def coin tilt:0
  group rot:tilt
    ellipse 22,12 at:0,5 fill:treasure.goldshade stroke:treasure.ink,3
    ellipse 22,12 fill:treasure.gold stroke:treasure.ink,3
      ellipse 15,7 at:0,-1 fill:none stroke:treasure.goldlight,2
      curve -9,-4 -2,-7 7,-6 stroke:treasure.gleam,3

def sparkle s:1
  path "M0 -19 Q3 -3 14 0 Q3 3 0 19 Q-3 3 -14 0 Q-3 -3 0 -19Z" scale:s fill:treasure.gleam stroke:treasure.gold,2

layer ground_shadow
  ellipse 185,25 at:259,438 fill:treasure.shadow a:.22 blur:9

layer open_lid
  path "M112 249 L101 151 Q99 112 137 99 L312 65 Q345 59 364 87 L404 166 L359 238Z" fill:treasure.wood stroke:treasure.ink,9 name:lid
    path "M114 146 Q113 121 142 114 L314 80 Q332 76 347 96 L380 160 L149 210Z" fill:treasure.woodlight
    path "M137 148 L323 110 M149 176 L337 137" fill:none stroke:treasure.wooddark,5
    path "M153 105 L177 101 L219 215 L193 225Z" fill:treasure.gold stroke:treasure.ink,4
    path "M299 76 L319 72 L369 188 L346 199Z" fill:treasure.gold stroke:treasure.ink,4
    path "M159 107 L166 106 L204 213 L197 215Z" fill:treasure.goldlight
    path "M307 78 L314 77 L359 184 L352 188Z" fill:treasure.goldlight
  path "M115 224 L369 169 L405 199 L348 278 L121 280Z" fill:treasure.interior stroke:treasure.ink,8
  path "M127 227 L367 181 L386 198 L341 254 L132 266Z" fill:treasure.wooddark stroke:treasure.goldshade,5

layer treasure_heap
  path "M122 283 Q105 246 153 230 Q155 199 199 209 Q219 175 256 198 Q284 174 307 203 Q350 195 360 224 Q401 223 396 266 L345 313Z" fill:treasure.goldshade stroke:treasure.ink,6
  coin at:165,239 tilt:-13
  coin at:206,218 tilt:8
  coin at:252,208 tilt:-9
  coin at:297,219 tilt:14
  coin at:339,234 tilt:-11
  coin at:372,251 tilt:15
  coin at:141,266 tilt:-18
  coin at:186,258 tilt:10
  coin at:230,244 tilt:-7
  coin at:276,245 tilt:12
  coin at:319,264 tilt:-13
  coin at:356,281 tilt:8
  coin at:214,284 tilt:-5
  coin at:267,278 tilt:15

layer chest_body
  path "M105 280 L304 309 L410 263 L390 398 Q388 411 375 417 L292 455 L124 415 Q110 412 109 395Z" fill:treasure.wood stroke:treasure.ink,9 name:body
    path "M304 311 L410 263 L390 398 Q388 411 375 417 L292 455Z" fill:treasure.wooddark
    path "M113 302 L299 330 L296 351 L114 321Z" fill:treasure.woodlight
    path "M116 352 L298 386 M120 386 L295 424 M305 359 L400 316 M301 398 L395 356" fill:none stroke:treasure.ink,4 a:.6
    path "M138 326 Q163 318 187 334 M218 368 Q243 363 265 379 M149 381 Q163 389 180 385" fill:none stroke:treasure.wooddark,3
    path "M137 289 L165 293 L169 425 L139 419Z" fill:treasure.gold stroke:treasure.ink,5
    path "M260 305 L286 310 L278 451 L250 444Z" fill:treasure.gold stroke:treasure.ink,5
    path "M373 280 L396 270 L376 418 L351 430Z" fill:treasure.goldshade stroke:treasure.ink,5
    path "M144 300 L152 301 L157 418 L148 416Z" fill:treasure.goldlight
    path "M266 317 L275 318 L267 439 L260 437Z" fill:treasure.goldlight
    circle 4 at:152,345 fill:treasure.ink
    circle 4 at:264,365 fill:treasure.ink
    circle 4 at:153,404 fill:treasure.ink
    circle 4 at:263,426 fill:treasure.ink
  path "M103 274 L305 300 L412 253 L412 279 L305 326 L104 297Z" fill:treasure.gold stroke:treasure.ink,7
  curve 112,280 304,307 401,264 stroke:treasure.goldlight,5
  path "M205 307 L244 313 L242 357 Q226 371 209 353Z" fill:treasure.goldshade stroke:treasure.ink,5
  path "M210 310 L237 315 L235 349 Q224 358 215 348Z" fill:treasure.goldlight
  circle 6 at:224,331 fill:treasure.ink
  path "M221 333 L219 344 L228 345 L227 334Z" fill:treasure.ink

layer overflowing_coins
  coin at:122,282 tilt:22
  coin at:161,294 tilt:-16
  coin at:186,312 tilt:67
  coin at:342,305 tilt:-65
  coin at:369,333 tilt:-54
  coin at:408,415 tilt:-10
  coin at:375,442 tilt:9
  coin at:333,459 tilt:-4
  coin at:101,423 tilt:16
  coin at:139,447 tilt:-9
  coin at:397,436 tilt:-12
  coin at:109,447 tilt:5

layer magic_glints
  sparkle at:214,192 s:.8
  sparkle at:326,216 s:.7
  sparkle at:428,203 s:1
  sparkle at:78,237 s:.7
  sparkle at:414,365 s:.5
  sparkle at:285,263 s:.55
