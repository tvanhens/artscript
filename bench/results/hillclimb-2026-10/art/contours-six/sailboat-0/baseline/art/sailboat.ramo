@target sailboat.png 1000x1000 bg:#f4e9cf

use std/brushes { bristle }

palette tale
  ramp sky #9bbfc8 #f5e5bf 5
  ramp sea #184d72 #96c6cc 7
  ramp red #7f3039 #fa9b68 7
  ramp wood #523d3b #e8b77d 5
  color cream #fff0ce
  color haze #789eaa

brush gouache strength:.13 reach:1
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 24 + seeded(m), 4);
    float grain = hash12(m.dev + seeded(m));
    float streak = vnoise(float2(m.p.x / 3, m.p.y / 65) + seeded(m));
    float3 col = m.paint.rgb * (0.91 + n * .16 + grain * .055 + streak * .035);
    float edge = m.edge + (n - .5) * 2.0;
    return float4(col, cover(edge, m) * (1 - strength * grain));
  }
  """

layer atmosphere brush:gouache
  rect 912x912 at:500,500 fill:grad(down tale.sky.0 tale.sky.4) name:painted_page
  circle 64 at:760,206 fill:tale.cream a:.65 name:sun
  path "M75 317 Q150 282 232 307 Q300 276 387 310 Q452 290 508 316 L508 337 L75 337 Z" fill:tale.cream a:.35 name:cloudbank
  path "M46 405 Q130 352 215 391 Q310 345 418 401 Q533 370 635 399 Q755 340 954 391 L954 477 L46 477 Z" fill:tale.haze a:.4 name:distant_land

layer ocean brush:gouache
  path "M44 419 Q287 411 508 424 Q748 414 956 421 L956 956 L44 956 Z" fill:grad(down tale.sea.5 tale.sea.1) name:water
    each i in 0..100
      let x = rand(50 950)
      let y = rand(437 956)
      let w = rand(20 95)
      curve x,y x+w*.45,y-4 x+w,y+2 stroke:pick([tale.sea.3 tale.sea.4 tale.sea.6]),rand(2 8) brush:bristle(strength:.35) a:rand(.15 .55) seed:100+i name:wave
  ellipse 225,39 at:519,755 fill:tale.sea.0 a:.45 name:boat_shadow
  each i in 0..15
    let y = 772+i*8
    let x = 410+rand(-45 45)
    curve x,y x+65,y+3 x+rand(95 155),y-2 stroke:tale.red.3,rand(3 9) a:.24 brush:bristle seed:300+i name:reflection

layer rigging brush:gouache
  curve 493,241 329,675 stroke:tale.wood.1,2 name:rear_stay
  curve 493,241 754,688 stroke:tale.wood.1,2 name:fore_stay
  curve 489,232 520,707 stroke:tale.wood.1,9 name:mast
  curve 486,233 516,692 stroke:tale.wood.4,3 name:mast_sun
  path "M488 237 Q531 227 554 244 L531 259 L491 253 Z" fill:tale.red.4 name:pennant

layer sails brush:gouache
  path "M478 275 Q414 365 315 573 Q393 568 504 619 Q487 453 478 275 Z" fill:grad(25deg tale.red.5 tale.red.2) name:main_sail
    path "M478 275 Q449 442 470 602 L507 621 Q486 416 478 275 Z" fill:tale.red.1 a:.48 name:fold_shadow
    path "M463 312 Q396 435 334 558 Q354 549 370 552 Q424 412 463 312 Z" fill:tale.red.6 a:.53 name:lit_edge
    curve 460,327 409,460 371,569 stroke:tale.red.2,2 a:.38 name:seam_one
    curve 468,372 454,482 454,598 stroke:tale.red.1,2 a:.26 name:seam_two
    curve 332,568 407,580 492,611 stroke:tale.cream,2 a:.65 name:hem
  path "M509 308 Q541 440 716 631 Q623 594 529 635 Q521 476 509 308 Z" fill:grad(30deg tale.red.6 tale.red.3) name:jib
    path "M509 308 Q551 489 716 631 Q682 608 654 608 Q562 481 509 308 Z" fill:tale.red.2 a:.5 name:jib_fold
    curve 527,392 564,513 610,612 stroke:tale.red.2,2 a:.38 name:jib_seam
    curve 536,627 620,606 700,626 stroke:tale.cream,2 a:.6 name:jib_hem
  curve 313,579 504,624 stroke:tale.wood.2,7 name:boom
  curve 320,577 502,619 stroke:tale.wood.4,2 name:boom_light
  curve 502,625 439,699 stroke:tale.wood.1,2 name:sheet
  curve 707,636 649,700 stroke:tale.wood.1,2 name:jib_sheet

layer hull brush:gouache
  path "M291 659 Q451 642 628 659 L760 686 Q648 762 493 752 Q365 737 291 659 Z" fill:tale.wood.4 name:deck
  path "M319 663 Q468 658 623 673 L700 687 Q576 725 454 703 Z" fill:tale.wood.0 name:cockpit
  path "M361 665 L402 662 L537 704 L497 707 Z" fill:tale.wood.3 name:rear_bench
  path "M531 663 L567 667 L659 697 L625 706 Z" fill:tale.wood.3 name:front_bench
  path "M291 659 Q435 724 606 708 Q708 701 760 686 L705 746 Q620 793 490 778 Q356 759 291 659 Z" fill:grad(down tale.red.4 tale.red.1) name:red_hull
    path "M293 679 Q407 763 541 761 Q646 770 730 724 L706 750 Q600 801 485 777 Q353 753 293 679 Z" fill:tale.red.0 a:.63 name:waterline_shadow
    curve 317,685 450,739 598,736 727,707 stroke:tale.red.5,7 a:.58 name:hull_glint
    curve 352,718 472,759 595,759 stroke:tale.red.2,2 a:.6 name:plank
  curve 294,661 421,708 578,718 696,704 759,685 stroke:tale.cream,7 name:gunwale
  curve 606,719 605,755 598,777 stroke:tale.red.0,3 a:.6 name:bow_joint
  curve 516,633 520,698 stroke:tale.wood.2,8 name:lower_mast
  ellipse 11,5 at:520,701 fill:tale.wood.4 name:mast_foot

layer wake brush:gouache
  curve 275,734 318,766 399,785 stroke:tale.sea.6,[2 12 2] brush:bristle name:stern_wake
  curve 704,756 663,785 581,798 472,795 stroke:tale.cream,[2 9 6 1] a:.8 brush:bristle name:bow_foam
  curve 236,787 328,813 416,811 stroke:tale.sea.5,[1 7 1] brush:bristle name:wake_outer
  curve 636,823 727,809 792,779 stroke:tale.sea.5,[1 6 1] brush:bristle name:ripple_right

layer seabirds brush:gouache
  path "M173 227 Q184 215 197 227 Q209 213 221 220" fill:none stroke:tale.wood.1,3 name:bird_one
  path "M231 192 Q240 183 251 193 Q261 183 271 187" fill:none stroke:tale.wood.1,2 name:bird_two
