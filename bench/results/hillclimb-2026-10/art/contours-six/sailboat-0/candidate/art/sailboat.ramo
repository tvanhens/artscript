@target sailboat.png 1000x800 bg:book.paper

use std/brushes { bristle }

palette book
  color paper #f7ecd4
  ramp sky #b7d7d8 5
  ramp sea #3789aa 5
  ramp red #c84438 5
  ramp cream #eddbaf 5
  ramp wood #916044 5
  color ink #354e60

brush gouache grain:.11 rag:1.8 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 27 + seeded(m), 4);
    float tooth = hash12(floor(m.dev));
    float3 c = m.paint.rgb * (0.91 + n * .17);
    c += (tooth - .5) * grain;
    float edge = m.edge + (n - .5) * rag;
    return float4(c, cover(edge,m));
  }
  """

layer sky brush:gouache
  rect 920x720 at:500,400 r:12 fill:grad(down book.sky.2 book.cream.4) name:skywash
  ellipse 64,61 at:763,176 fill:book.cream.4 a:.8 name:sun
  path "M95 219 C150 199 166 225 223 212 C249 173 300 180 315 212 C351 202 375 217 402 229 C302 236 177 238 95 231 Z" fill:book.paper a:.75 name:cloudleft
  path "M616 275 C658 253 686 267 708 258 C736 232 772 244 784 264 C817 258 849 273 882 281 C784 288 689 286 616 283 Z" fill:book.paper a:.65 name:cloudright
  path "M42 382 C136 353 186 371 248 353 C301 338 355 367 414 373 L466 401 L42 421 Z" fill:book.sky.1 a:.5 name:distantshore

layer water_layer brush:gouache
  path "M40 398 C204 382 292 414 444 397 C604 379 743 405 960 390 L960 760 L40 760 Z" fill:grad(down book.sea.3 book.sea.1) name:water
  each i in 0..95
    let x = rand(69 923)
    let y = rand(417 735)
    let w = rand(12 63)
    curve x,y x+w*.45,y-3 x+w,y+1 stroke:pick([book.sea.3 book.sky.3 book.sea.0]),rand(2 7) a:rand(.18 .45) brush:bristle seed:i name:ripples

layer reflection brush:gouache
  each i in 0..16
    let y = 592+i*7
    let x = 501+sin(i*44)*25
    curve x-42+i*2,y x+16,y+2 x+73-i*2,y-1 stroke:book.red.2,rand(4 11) a:.22 brush:bristle seed:i name:redreflection
  ellipse 208,30 at:513,595 fill:book.sea.0 a:.28 name:boatshadow

layer rigging_back brush:gouache
  curve 459,166 318,522 stroke:book.wood.1,2 name:backstay
  curve 459,166 720,551 stroke:book.wood.2,2 name:forestay

layer hull_layer brush:gouache
  path "M285 510 Q466 473 720 546 Q679 588 610 628 Q411 622 307 555 Z" fill:book.red.2 name:hull
    path "M284 538 Q465 577 720 546 L610 638 Q402 618 300 571 Z" fill:book.red.1 name:lower
    path "M325 549 Q421 584 578 601" fill:none stroke:book.red.3,13 a:.65 name:paintlight
    each i in 0..9
      curve 329+i*24,565+i*3 355+i*24,576+i*3 stroke:book.red.3,3 a:.25 brush:bristle seed:i
  path "M286 510 Q443 470 720 546 Q578 581 421 548 Z" fill:book.cream.2 name:deck
  path "M332 514 Q411 498 492 518 L566 541 Q474 548 418 532 Z" fill:book.wood.0 name:cockpit
  path "M351 515 L413 511 L478 531 L420 532 Z" fill:book.wood.3 name:seat
  curve 287,510 420,548 576,565 719,546 stroke:book.red.4,7 name:gunwale
  curve 719,547 674,583 610,628 stroke:book.red.0,5 name:bowedge

layer spars brush:gouache
  curve 454,163 467,532 stroke:book.wood.1,9 name:mast
  curve 452,163 463,523 stroke:book.cream.3,3 name:mastlight
  curve 319,465 456,486 620,511 stroke:book.wood.2,8 name:boom

layer sails brush:gouache
  path "M445 183 C401 251 318 336 299 448 Q361 483 449 478 C457 372 451 276 445 183 Z" fill:grad(right book.red.3 book.red.2) name:mainsail
    path "M440 205 C420 304 412 394 440 476 L457 481 L452 235 Z" fill:book.red.1 a:.55 name:fold
    path "M420 234 C374 307 332 372 322 440" fill:none stroke:book.red.4,16 a:.48 name:litcloth
    curve 354,345 391,360 445,364 stroke:book.cream.2,1.5 a:.42 name:seam
    curve 314,416 372,433 445,434 stroke:book.cream.2,1.5 a:.42 name:bottomseam
  path "M473 220 C517 317 598 414 679 511 Q578 477 478 488 C488 402 482 303 473 220 Z" fill:grad(right book.cream.4 book.cream.2) name:jib
    path "M483 271 Q516 399 656 500 Q589 461 479 485 Z" fill:book.cream.1 a:.3 name:bellyshade
    curve 498,357 544,393 579,414 stroke:book.wood.3,1.5 a:.35 name:seam
  path "M454 166 Q481 150 510 167 L492 180 L515 189 Q480 183 455 193 Z" fill:book.red.2 name:pennant

layer finishing brush:gouache
  curve 319,469 336,505 358,522 stroke:book.cream.4,2 name:sheet
  curve 479,490 520,540 548,551 stroke:book.wood.2,2 name:jibsheet
  curve 287,565 333,586 398,595 stroke:book.sky.4,[2 9 1] brush:bristle name:sternfoam
  curve 618,630 661,611 703,578 742,573 stroke:book.paper,[2 9 7 1] brush:bristle name:bowfoam
  curve 697,629 747,616 795,619 stroke:book.sky.4,[1 5 1] brush:bristle name:wake
  curve 240,611 285,621 320,620 stroke:book.sky.3,[1 5 1] brush:bristle name:nearwave
  curve 730,343 740,337 751,343 stroke:book.ink,2 name:birdone
  curve 781,323 788,318 796,323 stroke:book.ink,1.7 name:birdtwo
