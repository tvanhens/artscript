@target botanical/fern.png 1000x1400 bg:botanical.paper
@target botanical/fern.svg 1000x1400 bg:botanical.paper

palette botanical
  color paper #f5efdf
  ramp fiber #e9dfc9 #fcf7eb 5
  color ink #363c32
  color fine #666957
  color wash #e5e3d0

# Slender, asymmetric pinnules with fine branching venation.
def pinnule length:32 width:7
  group scale:width/7,length/32
    path "M0 0 C-3 -5 -6 -8 -5 -12 C-8 -15 -7 -19 -5 -21 C-7 -24 -4 -28 0 -32 C3 -27 7 -24 5 -21 C8 -17 6 -14 5 -12 C6 -7 3 -3 0 0Z" fill:botanical.paper stroke:botanical.ink,.72 name:contour
    path "M0 -1 Q1 -16 0 -30" stroke:botanical.fine,.56 fill:none name:midvein
    each k in 0..4
      let y = -6-k*5
      curve 0,y -2,y-2 -4,y-5 stroke:botanical.fine,.4 fill:none name:vein_left
      curve 0,y 2,y-2 4,y-4 stroke:botanical.fine,.4 fill:none name:vein_right

def pinna length:230 fullness:1
  let count = floor(length/16)
  each j in 0..count
    let u = (j+.6)/(count+1)
    let x = u*length
    let bend = -12*u*u
    let blade = (12+26*sqrt(sin(180*u)))*fullness
    pinnule blade 5.5*fullness at:x,bend rot:31+u*20 name:upper
    pinnule blade*.88 5.2*fullness at:x+4,bend rot:139-u*12 name:lower
  curve 0,0 length*.48,-2 length,-13 stroke:botanical.ink,[1.25 .8 .15] fill:none name:rachilla
  pinnule 20 3.6 at:length-4,-12 rot:78 name:tip

layer paper_texture
  rect 1000x1400 at:500,700 fill:botanical.paper name:sheet
    fx grain .026 scale:.65

