@target fern.png 1000x1250 bg:botanical.paper
@target fern.svg 1000x1250 bg:botanical.paper

palette botanical
  color paper #f4eddd
  color fiber #d8cbb4
  color ink #393e32
  color fine #686a55
  color wash #e8e5d5

# A pinnule, drawn as a toothed pen contour with a branching midrib.
def pinnule length:30 breadth:7
  group scale:breadth/7,length/30
    path "M0 0 C-3 -2 -5 -5 -5 -8 L-6.6 -10 L-5.1 -11.5 L-6.2 -15 L-4.8 -16 L-5 -20 L-3.5 -20.5 Q-2.5 -26 0 -30 Q3 -26 3.5 -22 L5 -20 L4.1 -18 L5.7 -15 L4.5 -13 L6 -10 L4.8 -8 Q5 -3 0 0 Z" fill:botanical.wash stroke:botanical.ink,.65 name:blade
    curve 0,0 .3,-12 0,-28 stroke:botanical.fine,.55 name:vein
    each k in 0..4
      let y = -5-k*4.7
      curve 0,y -2.4,y-2 -4.6,y-4 stroke:botanical.fine,.35 name:left_veins
      curve 0,y 2.3,y-2.2 4.5,y-4.2 stroke:botanical.fine,.35 name:right_veins

# Each pinna has two ranks of increasingly small pinnules.
def pinna length:200 bend:65
  curve 0,0 length*.35,-bend*.48 length*.72,-bend*.83 length,-bend stroke:botanical.ink,[1.1 .9 .6 .15] name:axis
  each j in 0..12
    let u = (j+.6)/12.8
    let x = length*u
    let y = -bend*(1.35*u-.35*u*u)
    let h = (11+length*.16)*(1-u*.88)
    pinnule h h*.22 at:x,y rot:18+u*39 name:upper
    pinnule h*.83 h*.2 at:x+2,y+1 rot:151-u*25 name:lower
  pinnule 15 3 at:length*.94,-bend*.97 rot:62 name:point

layer paper_surface
  rect 1000x1250 at:500,625 fill:botanical.paper name:paper
    fx grain .025 scale:.7
  each i in 0..1100
    ellipse .35,.8 at:rand(4 996),rand(4 1246) fill:botanical.fiber a:.14 name:paper_fibers

layer fern_frond
  curve 366,1115 400,995 442,850 503,654 568,458 625,286 665,149 stroke:botanical.ink,[2.8 2.7 2.4 1.9 1.3 .8 .1] name:rachis
  curve 369,1114 405,990 446,850 507,655 stroke:botanical.fine,.65 name:stipe_ridge
  each i in 0..21
    let progress = i/21
    let y = 914-735*progress
    let x = 422+241*progress
    let span = 210*(1-progress)*(.72+.65*sin(progress*150))
    pinna span span*.38 at:x,y scale:-1,1 rot:8-progress*16 name:left_pinna
    pinna span*.93 span*.48 at:x+3,y-16 rot:-8-progress*10 name:right_pinna
  pinnule 39 6 at:659,176 rot:12 name:terminal
