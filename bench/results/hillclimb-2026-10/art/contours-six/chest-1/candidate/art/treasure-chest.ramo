@target treasure-chest.png 512x512 bg:none scale:1,2
@target treasure-chest.svg 512x512 bg:none

palette treasure
  ramp wood #a54c28 5
  ramp gold #f5b82e 5
  color ink #352132
  color hollow #42222a
  color cream #fff3b2

def coin size:48x34
  ellipse 24,15 at:0,5 fill:treasure.gold.1 stroke:treasure.ink,3
  ellipse 24,15 fill:treasure.gold.3 stroke:treasure.ink,3
    ellipse 17,10 fill:treasure.gold.2 stroke:treasure.gold.1,2
    curve -8,-5 1,-8 10,-5 stroke:treasure.cream,3
    curve 0,-5 0,5 stroke:treasure.gold.4,4

layer raised_lid
  path "M104 244 L92 157 Q92 97 151 87 L344 65 Q396 62 413 119 L430 207 Z" fill:treasure.gold.2 stroke:treasure.ink,9 name:lid
    path "M117 227 L110 158 Q109 116 153 106 L343 85 Q377 81 391 126 L405 195 Z" fill:treasure.wood.1 stroke:treasure.ink,5
    path "M127 190 L119 149 Q125 124 151 121 L346 98 Q365 100 375 123 L387 160 Z" fill:treasure.wood.2
    curve 123,160 378,130 stroke:treasure.ink,4
    curve 130,196 389,163 stroke:treasure.ink,4
    path "M157 96 L183 93 L202 226 L177 230 Z" fill:treasure.gold.3 stroke:treasure.ink,5
    path "M330 77 L354 78 L382 210 L358 215 Z" fill:treasure.gold.3 stroke:treasure.ink,5
    curve 167,109 182,206 stroke:treasure.cream,4
    curve 341,94 364,190 stroke:treasure.cream,4

layer opening
  path "M86 258 L159 209 L421 205 L449 272 L369 323 L106 306 Z" fill:treasure.gold.2 stroke:treasure.ink,8 name:rim
  path "M110 257 L171 227 L403 224 L421 265 L361 299 L123 288 Z" fill:treasure.hollow stroke:treasure.ink,4

layer bounty
  coin at:179,228 rot:-17
  coin at:231,222 rot:10
  coin at:286,218 rot:-12
  coin at:339,221 rot:8
  coin at:383,237 rot:23
  coin at:149,252 rot:-18
  coin at:204,251 rot:9
  coin at:257,245 rot:-10
  coin at:309,246 rot:14
  coin at:357,259 rot:-6
  coin at:188,278 rot:-13
  coin at:241,272 rot:5
  coin at:294,277 rot:-13
  coin at:335,284 rot:12
  coin at:270,194 rot:-24
  coin at:325,188 rot:20
  coin at:220,192 rot:-9

layer chest
  path "M103 294 L369 314 L442 270 L423 394 Q420 406 407 413 L352 447 L122 415 Q109 414 108 399 Z" fill:treasure.wood.2 stroke:treasure.ink,9 name:body
    path "M369 314 L442 270 L423 399 L352 447 Z" fill:treasure.wood.1 stroke:treasure.ink,5
    path "M109 304 L367 326 L360 347 L111 324 Z" fill:treasure.wood.3
    curve 114,352 361,376 431,330 stroke:treasure.ink,4
    curve 116,389 356,416 427,373 stroke:treasure.ink,4
    curve 184,338 227,345 262,344 stroke:treasure.wood.1,3
    curve 142,377 173,375 199,383 stroke:treasure.wood.1,3
    path "M137 298 L166 300 L169 420 L139 417 Z" fill:treasure.gold.2 stroke:treasure.ink,5
    path "M319 310 L348 312 L337 442 L307 438 Z" fill:treasure.gold.2 stroke:treasure.ink,5
    curve 145,315 148,402 stroke:treasure.gold.4,5
    curve 327,328 319,426 stroke:treasure.gold.4,5
  path "M102 289 L369 309 L444 265 L443 287 L371 333 L104 313 Z" fill:treasure.gold.3 stroke:treasure.ink,7 name:lip
  curve 114,298 363,319 stroke:treasure.cream,4
  path "M229 317 L275 321 L272 369 Q249 387 229 364 Z" fill:treasure.gold.2 stroke:treasure.ink,6 name:lock
    path "M237 326 L266 329 L264 346 L237 343 Z" fill:treasure.gold.4
    circle 6 at:250,351 fill:treasure.ink
    path "M247 352 L244 365 L254 366 L252 352 Z" fill:treasure.ink
  each pos in [151,335 153,397 332,346 324,420]
    circle 4 at:pos fill:treasure.ink
    circle 1.5 at:pos-(1,1) fill:treasure.gold.4

layer spilled_gold
  coin at:393,308 rot:62
  coin at:414,348 rot:74
  coin at:434,406 rot:-12
  coin at:387,445 rot:8
  coin at:431,449 rot:-11
  coin at:87,421 rot:13
  coin at:116,445 rot:-9
  coin at:165,454 rot:5

layer sparkles
  path "M74 179 Q76 198 91 202 Q76 205 74 224 Q71 205 57 202 Q71 198 74 179 Z" fill:treasure.cream stroke:treasure.gold.2,3
  path "M439 131 Q442 153 459 157 Q442 161 439 183 Q435 161 420 157 Q435 153 439 131 Z" fill:treasure.cream stroke:treasure.gold.2,3
  star 4 r:14 inner:.24 at:348,166 fill:treasure.cream
  circle 4 at:103,111 fill:treasure.gold.3
  circle 5 at:460,235 fill:treasure.gold.3
