@target fox-and-mushroom.png 768x768

palette woods
  ramp night #142e3c #35605f 5
  ramp moss #28544f #73a384 5
  ramp fur #d76132 #ffbb65 5
  ramp cream #d9cba6 #fff5d5 5
  ramp magic #44bcae #ddffe2 5
  color ink #253340
  color blush #dc8262

layer backdrop
  rect 768x768 at:384,384 fill:grad(down woods.night.0 woods.night.2)
  circle 200 at:477,333 fill:woods.magic.1 a:.09 blur:20
  path "M64 584 Q110 382 88 83 L120 69 Q137 352 114 590Z" fill:woods.night.1
  path "M636 592 Q607 349 656 82 L690 74 Q652 354 697 600Z" fill:woods.night.1
  curve 113,290 167,226 193,130 stroke:woods.night.1,17
  curve 645,236 587,185 571,119 stroke:woods.night.1,14
  ellipse 318,70 at:384,636 fill:woods.night.0
  ellipse 287,49 at:384,618 fill:grad(down woods.moss.1 woods.night.1)
  ellipse 116,24 at:524,605 fill:woods.magic.1 a:.18 blur:14

layer woodland_details
  each pos in [153,552 184,577 604,556 632,594 116,608]
    group at:pos
      curve 0,22 -4,0 -17,-15 stroke:woods.moss.2,3
      ellipse 11,5 at:-12,-8 rot:38 fill:woods.moss.2
      ellipse 10,5 at:4,3 rot:-35 fill:woods.moss.3
  each pos in [184,166 241,118 483,136 568,250 152,408 610,425 420,229]
    circle 2 at:pos fill:woods.magic.3 a:.65

layer tail_layer
  path "M319 596 C252 635 153 601 158 526 C160 482 197 457 225 444 C211 489 247 502 286 509 C331 515 365 557 319 596Z" fill:grad(right woods.fur.1 woods.fur.3) stroke:woods.ink,5 name:tail
    path "M155 529 C164 486 198 461 226 444 C215 473 227 491 246 500 L222 504 L221 524 L202 517 L191 539 L177 527 L165 548Z" fill:woods.cream.3
    curve 204,562 244,588 292,580 stroke:woods.fur.0,4 a:.5

layer body_layer
  path "M295 411 C252 452 243 517 254 580 C269 620 372 623 397 584 C414 533 386 453 354 419Z" fill:grad(right woods.fur.2 woods.fur.4) stroke:woods.ink,5 name:body
    path "M321 430 C285 464 280 507 300 547 L319 537 L332 552 L348 534 L363 543 C381 492 358 453 343 432Z" fill:grad(down woods.cream.3 woods.cream.1)
    ellipse 27,58 at:278,548 fill:woods.fur.1
  ellipse 35,17 at:284,597 fill:woods.fur.1 stroke:woods.ink,4
  ellipse 32,17 at:371,597 fill:woods.fur.3 stroke:woods.ink,4
  curve 314,529 312,573 309,596 stroke:woods.ink,4
  curve 348,529 346,575 345,597 stroke:woods.ink,4
  curve 274,592 274,600 stroke:woods.fur.0,2
  curve 365,592 365,600 stroke:woods.fur.1,2

layer head_layer
  path "M237 342 Q210 295 225 238 Q269 247 300 286 L349 281 Q377 244 416 235 Q427 295 398 343Z" fill:grad(right woods.fur.2 woods.fur.4) stroke:woods.ink,5 name:ears
    path "M239 312 Q229 279 235 258 Q266 270 281 295Z" fill:woods.ink
    path "M366 294 Q386 264 406 255 Q410 285 394 313Z" fill:woods.ink
    path "M243 298 L244 272 L267 294Z" fill:woods.blush
    path "M380 292 L399 268 L396 300Z" fill:woods.blush
  path "M236 322 Q265 284 319 287 Q372 282 401 321 L420 358 L404 357 L415 380 L397 378 Q378 428 325 441 Q267 433 244 390 L226 389 L237 369 L219 371Z" fill:grad(right woods.fur.2 woods.fur.4) stroke:woods.ink,5 name:head
    path "M226 355 Q266 354 300 388 Q321 404 326 425 Q327 400 354 382 Q380 357 416 349 L424 401 L356 449 L296 449 L239 413Z" fill:grad(down woods.cream.4 woods.cream.2)
    ellipse 11,6 at:266,382 fill:woods.blush a:.65
    ellipse 11,6 at:383,378 fill:woods.blush a:.65
    curve 261,352 273,346 285,352 fill:none stroke:woods.ink,5
    curve 355,349 367,343 379,349 fill:none stroke:woods.ink,5
    path "M313 391 Q326 385 338 391 Q339 397 326 403 Q315 400 313 391Z" fill:woods.ink
    curve 326,402 326,411 317,416 stroke:woods.ink,3
    curve 326,411 335,415 342,410 stroke:woods.ink,3
    curve 303,308 317,303 330,304 stroke:woods.fur.4,4

layer mushroom_layer
  ellipse 72,13 at:535,604 fill:woods.night.0 a:.6 blur:6
  path "M516 510 Q526 555 506 593 Q525 611 553 597 Q543 554 553 508Z" fill:grad(right woods.magic.1 woods.magic.4) stroke:woods.magic.1,3 name:stem
    curve 534,530 530,562 532,589 stroke:woods.magic.0,3 a:.35
  ellipse 88,21 at:536,508 fill:woods.magic.3 name:gills
    each x in [-61 -44 -26 -5 15 34 53]
      curve 0,-17 x,16 stroke:woods.magic.0,2 a:.65
    fx glow 13 color:woods.magic.2 a:.65
  path "M440 499 C456 476 462 420 510 406 C557 386 591 429 603 460 Q609 483 629 496 C597 516 567 503 540 509 C503 517 474 512 440 509 Q434 505 440 499Z" fill:grad(down woods.magic.1 woods.magic.3) stroke:woods.magic.3,4 name:cap
    ellipse 22,11 at:508,433 rot:-22 fill:woods.magic.4
    ellipse 15,9 at:558,443 rot:25 fill:woods.magic.4
    ellipse 11,7 at:477,472 rot:-35 fill:woods.magic.3
    ellipse 18,8 at:578,482 rot:14 fill:woods.magic.4
    ellipse 8,5 at:535,475 fill:woods.magic.4
    fx glow 14 color:woods.magic.1 a:.65
  curve 451,502 480,505 512,502 stroke:woods.magic.4,3

layer foreground
  each pos in [211,625 414,620 462,628 594,622]
    group at:pos
      curve -12,0 -8,-13 0,0 5,-19 7,0 17,-9 stroke:woods.moss.3,3
  each pos in [466,367 565,343 612,393 453,548]
    group at:pos
      circle 3 fill:woods.magic.4
        fx glow 7 color:woods.magic.2
  group at:574,309
    curve -7,0 7,0 stroke:woods.magic.3,2
    curve 0,-7 0,7 stroke:woods.magic.3,2
  group at:432,439
    curve -5,0 5,0 stroke:woods.magic.3,2
    curve 0,-5 0,5 stroke:woods.magic.3,2
