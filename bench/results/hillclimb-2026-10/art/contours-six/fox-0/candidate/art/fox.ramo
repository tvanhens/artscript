@target fox-and-mushroom.png 800x800
@target fox-and-mushroom.svg 800x800

palette woods
  color night #132c3b
  color distant #20434c
  color bark #18353f
  color ground #284e50
  color moss #46746a
  color ink #422e36
  ramp fur #e98a46 5
  color cream #fff0cf
  color blush #e99b85
  color jade #75d6ae
  color glow #c9ffcb
  color darkjade #377c74

layer backdrop
  rect 800x800 at:400,400 fill:woods.night
  circle 308 at:400,373 fill:radial(woods.distant woods.night)
  path "M90 610 Q125 380 108 155 Q121 137 135 155 L151 335 L186 291 L194 305 L153 367 L164 610 Z" fill:woods.bark
  path "M640 600 L655 310 L617 252 L626 240 L659 277 L672 139 Q684 123 697 142 L688 399 L720 357 L729 371 L686 439 L687 610 Z" fill:woods.bark
  ellipse 310,83 at:400,632 fill:woods.ground
  ellipse 263,39 at:402,637 fill:woods.moss a:.27

layer ambient_light
  ellipse 128,128 at:566,459 fill:woods.jade a:.13 blur:22
  ellipse 120,32 at:560,624 fill:woods.jade a:.22 blur:12
  ellipse 185,24 at:331,647 fill:woods.night a:.55 blur:8

