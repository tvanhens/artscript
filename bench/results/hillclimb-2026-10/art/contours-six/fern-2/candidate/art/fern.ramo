@target fern.png 1000x1300 bg:botanical.paper
@target fern.svg 1000x1300 bg:botanical.paper

# Fine sepia pen contours, branching veins, and gently mottled ivory stock.
palette botanical
  color paper #f5eedc
  ramp stock #eae0ca #faf5e9 5
  color ink #494538
  color fine #77705c
  color wash #ece8d7

def pinnule length:28 width:6
  curve 0,0 length*.22,-width*.72 length*.48,-width length*.68,-width*.75 length,-1 length*.68,width*.48 length*.38,width*.62 length*.14,width*.4 closed fill:botanical.wash stroke:botanical.ink,.7 name:blade
    curve 0,0 length*.45,-.7 length*.9,-1 stroke:botanical.fine,.55 name:midvein
    each k in 1..5
      let x = length*k/6
      curve x,0 x+length*.1,-width*.34 x+length*.17,-width*.7 stroke:botanical.fine,.36 name:upper_veins
      curve x,0 x+length*.1,width*.25 x+length*.15,width*.46 stroke:botanical.fine,.32 name:lower_veins

def pinna length:210
  curve 0,0 length*.35,-6 length*.72,-15 length,-26 stroke:botanical.ink,[1.15 .85 .5 .15] name:branch
  each j in 0..12
    let u = (j+.6)/13
    let x = length*u
    let y = -26*u*u
    let l = (12+length*.155)*sin((1-u)*85)
    pinnule length:l width:l*.2 at:x,y rot:-57+u*12 name:upper
    pinnule length:l*.91 width:l*.18 at:x+3,y rot:53-u*14 name:lower
  pinnule length:23 width:3.5 at:length-16,-23 rot:-12 name:terminal

layer paper_surface
  rect 1000x1300 at:500,650 fill:fbm(simplex(125 seed:12)) -> botanical.stock a:.22 name:paper_texture
    fx grain .025 scale:.7

layer fern_frond
  # An arcing rachis carries progressively smaller, alternating pinnae.
  curve 399,1150 414,1010 440,830 475,630 517,430 566,246 602,136 stroke:botanical.ink,[2.7 2.5 2.1 1.8 1.4 .8 .15] name:rachis
  curve 403,1144 418,1009 444,830 479,630 521,430 stroke:botanical.fine,.5 name:rachis_edge
  each i in 0..16
    let u = i/16
    let y = 994-809*u
    let x = 416+150*u+28*u*u
    pinna length:225*(1-u*.88) at:x,y rot:-19-24*u name:right_pinna
    pinna length:215*(1-u*.88) at:x+4,y-19 scale:-1,1 rot:19+23*u name:left_pinna
  pinnule length:48 width:5 at:587,181 rot:-72 name:frond_tip
