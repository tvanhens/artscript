@target health-potion.png 64x64 bg:none

palette potion
  color ink #261d35
  color glass #6593a5
  color glass_light #b9e5e4
  color white #f0fff0
  color glass_dark #3f536f
  color red_dark #781e45
  color red_shadow #ad234a
  color red #e93650
  color red_light #ff7279
  color cork_dark #754039
  color cork #bc7850
  color cork_light #e9b575

layer bottle
  path "M23 14 H41 V24 H45 V28 H49 V34 H52 V48 H49 V54 H45 V58 H19 V54 H15 V48 H12 V34 H15 V28 H19 V24 H23 Z" fill:potion.ink name:flask
    path "M25 16 H39 V26 H43 V30 H47 V35 H50 V47 H47 V52 H43 V56 H21 V52 H17 V47 H14 V35 H17 V30 H21 V26 H25 Z" fill:potion.glass
    path "M25 18 H29 V28 H23 V32 H19 V38 H16 V35 H17 V30 H21 V26 H25 Z" fill:potion.glass_light
    path "M45 32 H47 V36 H50 V47 H47 V52 H43 V56 H23 V54 H41 V50 H45 Z" fill:potion.glass_dark
    path "M18 35 H22 V33 H42 V35 H46 V39 H48 V46 H45 V51 H41 V54 H23 V51 H19 V46 H16 V39 H18 Z" fill:potion.red_dark name:liquid
      path "M18 35 H22 V33 H42 V35 H46 V39 H45 V46 H41 V50 H23 V48 H19 V44 H18 Z" fill:potion.red
      path "M40 36 H46 V39 H48 V46 H45 V51 H41 V54 H23 V51 H39 V48 H42 V43 H44 V39 H40 Z" fill:potion.red_shadow
      rect 20x2 at:32,35 fill:potion.red_light
      rect 4x6 at:21,40 fill:potion.red_light
      rect 4x2 at:25,46 fill:potion.red_light
    rect 2x8 at:19,33 fill:potion.white
    rect 2x4 at:17,41 fill:potion.glass_light
    rect 6x2 at:25,53 fill:potion.glass_light
    rect 4x2 at:39,29 fill:potion.glass_light
    rect 2x4 at:27,22 fill:potion.white

layer stopper
  path "M24 6 H40 V8 H42 V14 H40 V18 H24 V14 H22 V8 H24 Z" fill:potion.ink name:cork
    path "M24 8 H40 V13 H38 V16 H26 V13 H24 Z" fill:potion.cork
    rect 14x2 at:32,9 fill:potion.cork_light
    rect 2x4 at:26,12 fill:potion.cork_light
    rect 4x4 at:36,14 fill:potion.cork_dark
    rect 2x2 at:32,12 fill:potion.cork_dark
  rect 22x6 at:32,18 fill:potion.ink name:rim
    rect 18x2 at:0,-1 fill:potion.glass_light
    rect 14x2 at:2,1 fill:potion.glass
