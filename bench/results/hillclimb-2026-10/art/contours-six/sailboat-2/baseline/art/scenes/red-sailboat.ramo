@target red-sailboat.png 1200x1000 bg:book.paper

use std/brushes { bristle }

palette book
  color paper #f5edda
  ramp sky #b9d7d7 5
  ramp sea #347eaa 5
  ramp teal #65aaa9 5
  ramp red #c94437 5
  ramp sail #eddeb4 5
  ramp wood #856044 5
  color ink #334854

brush gouache grain:.12 rag:1.8 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 19 + seeded(m), 4);
    float fiber = vnoise(m.p * float2(.45, 1.6) + seeded(m));
    float edge = cover(m.edge + (n-.5)*rag, m);
    float pool = (1-smoothstep(0, 7, m.edge))*.08;
    return float4(m.paint.rgb * (1 + (n-.5)*grain + (fiber-.5)*.05 - pool), edge);
  }
  """

layer sky_wash brush:gouache
  rect 1090x884 at:600,500 r:35 fill:grad(down book.sky.3 book.paper) name:sky
  circle 64 at:913,213 fill:book.sail.4 a:.8 name:sun
  path "M125 250 C167 222 204 233 239 243 C276 213 318 231 336 253 C381 250 405 261 425 276 C322 285 207 285 125 271 Z" fill:book.paper a:.77 name:cloud_left
  path "M695 158 C735 128 780 140 794 156 C837 143 871 163 885 177 C810 187 733 182 676 180 Z" fill:book.paper a:.68 name:cloud_high
  path "M65 467 Q196 422 326 461 Q442 420 570 459 Q711 418 848 454 Q998 411 1135 451 L1135 536 L65 536 Z" fill:book.teal.3 a:.6 name:distant_shore

layer water brush:gouache
  path "M65 477 Q300 465 595 479 Q888 468 1135 480 L1135 924 Q600 949 65 924 Z" fill:grad(down book.sea.3 book.sea.1) name:blue_water
    each i in 0..100
      let x = rand(10 1080)
      let y = rand(485 940)
      let w = rand(18 105)
      curve x,y x+w*.5,y-4 x+w,y+1 stroke:pick([book.teal.3 book.sea.4 book.sea.0 book.paper]),rand(2 8) a:rand(.12 .44) brush:bristle(strength:.35) seed:i name:ripple
  curve 114,535 235,528 351,536 stroke:book.sail.3,5 a:.5 name:far_glimmer
  curve 835,546 935,538 1066,548 stroke:book.sail.3,5 a:.5 name:east_glimmer

layer reflections brush:gouache
  ellipse 254,45 at:615,768 fill:book.sea.0 a:.35 name:boat_shadow
  each i in 0..15
    let y = 780+i*8
    let x = 505+rand(-38 38)+i*2
    curve x,y x+rand(80 145),y+3 x+rand(160 235),y-2 stroke:book.red,rand(3 9) a:.34-i*.016 brush:bristle(strength:.5) seed:i name:red_reflection

layer hull brush:gouache
  path "M347 655 Q513 660 829 604 L890 656 Q822 731 653 771 Q451 758 377 709 Z" fill:grad(down book.red.3 book.red.1) name:red_hull
    path "M376 700 Q528 730 681 721 Q812 695 891 652 L889 727 L649 793 L403 764 Z" fill:book.red.1 a:.63 name:lower_shadow
    curve 403,703 526,726 655,731 816,685 stroke:book.red.3,11 a:.5 name:paint_scumble
    curve 399,688 537,705 668,699 839,652 stroke:book.sail.3,5 a:.85 name:cream_stripe
  path "M347 655 Q504 597 829 604 L890 656 Q734 697 571 705 Q438 690 347 655 Z" fill:book.wood.1 name:deck_rim
  path "M370 653 Q534 613 819 618 L859 650 Q691 682 572 688 Q448 674 370 653 Z" fill:book.sail.2 name:deck
    each i in 0..7
      curve 397+i*47,633 450+i*47,675 stroke:book.wood.2,2 a:.48 seed:i name:plank
  path "M474 652 L583 631 L654 649 L548 675 Z" fill:book.wood.1 name:cockpit
  path "M491 651 L580 641 L629 651 L547 667 Z" fill:book.ink name:cockpit_inside
  curve 352,653 458,681 574,699 746,677 886,653 stroke:book.red.3,8 name:near_gunwale
  curve 355,649 507,610 686,602 827,608 stroke:book.red.3,7 name:far_gunwale
  circle 13 at:762,689 fill:book.sail.3 name:porthole_rim
    circle 8 fill:book.ink name:porthole_glass

layer rigging brush:gouache
  curve 582,215 375,649 stroke:book.wood.1,2 a:.8 name:back_stay
  curve 585,219 884,647 stroke:book.wood.1,2 a:.8 name:fore_stay
  curve 575,653 584,193 stroke:book.wood.1,12 name:mast
  curve 572,649 581,196 stroke:book.sail.3,3 name:mast_light
  path "M590 204 Q631 189 672 211 L651 223 L674 237 Q626 218 590 230 Z" fill:book.red name:pennant

layer sails brush:gouache
  path "M571 249 Q476 375 357 551 Q458 593 564 596 Q530 429 571 249 Z" fill:grad(right book.sail.4 book.sail.2) name:main_sail
    path "M570 253 Q531 432 562 595 Q538 583 510 582 Q512 419 570 253 Z" fill:book.wood.2 a:.24 name:leech_shadow
    path "M541 298 Q454 448 386 545 Q425 555 449 556 Q467 417 541 298 Z" fill:book.paper a:.7 name:sail_light
    curve 554,305 505,436 484,579 stroke:book.wood.2,2 a:.35 name:seam_one
    curve 504,354 454,446 405,560 stroke:book.wood.2,2 a:.3 name:seam_two
    curve 391,541 462,564 548,569 stroke:book.sail.1,2 a:.6 name:foot_seam
  path "M600 268 Q734 436 823 585 Q721 568 602 605 Q635 445 600 268 Z" fill:grad(right book.sail.3 book.sail.4) name:jib
    path "M601 274 Q645 452 606 600 L638 590 Q668 438 601 274 Z" fill:book.wood.2 a:.22 name:jib_fold
    curve 635,332 713,457 776,565 stroke:book.wood.2,2 a:.32 name:jib_seam
    curve 638,582 713,566 803,580 stroke:book.sail.1,2 a:.5 name:jib_hem
  curve 355,558 563,603 stroke:book.wood.2,8 name:boom
  curve 560,604 541,654 stroke:book.wood.1,2 name:sheet

layer bow_waves brush:gouache
  curve 811,750 862,724 903,700 946,707 stroke:book.sea.4,[2 9 6 1] brush:bristle(strength:.4) name:bow_foam
  curve 340,743 412,770 488,779 stroke:book.paper,[1 7 1] a:.85 brush:bristle(strength:.4) name:stern_foam
  curve 757,790 838,781 887,755 stroke:book.teal.4,[1 6 1] brush:bristle(strength:.4) name:near_wave
  curve 253,805 333,794 382,805 stroke:book.sea.4,[1 5 1] brush:bristle(strength:.4) name:left_wave
