@target lighthouse.png 1200x900 bg:d.paper

palette d
  color paper #f4eddf
  color violet #555675
  color rose #c9909c
  color peach #e8b69c
  color blue #637f94
  color deep #303f56
  color rock #686375
  color moss #6b7770
  color cream #e9dfc9
  color gold #ffd18a
  color rust #8d5c60

brush wash rag:3 reach:4 strength:.22
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 35 + seeded(m), 4);
    float grain = vnoise(m.p * 1.6 + seeded(m));
    float edge = m.edge + (n-.5)*rag;
    float pool = (1-smoothstep(0,7,m.edge))*.16;
    float bloom = smoothstep(.48,.78,n)*.13;
    float3 pigment = m.paint.rgb * (1-pool-strength*(grain-.4));
    return float4(pigment,cover(edge,m)*(.82 + n*.16-bloom));
  }
  """

layer painting
  rect 1090x790 at:600,450 fill:grad(down d.violet d.rose d.peach) brush:wash(rag:13 reach:9) name:sky
    ellipse 410,115 at:-190,230 fill:d.peach a:.48 brush:wash name:sunset
    each i in 0..13
      let x = rand(-520 520)
      let y = rand(-325 20)
      curve x,y x+75,y-12 x+170,y+5 x+235,y-5 stroke:d.violet,rand(12 40) a:.15 brush:wash seed:40+i name:cloud
  curve 58,492 205,479 319,485 435,474 591,483 763,478 1141,489 1141,841 58,841 closed fill:grad(down d.blue d.deep) brush:wash(rag:8 reach:6) name:sea
    each i in 0..82
      let y = rand(0 900)
      let x = rand(30 1150)
      curve x,y x+rand(15 65),y-3 x+rand(70 150),y+2 stroke:d.cream,rand(1 5) a:.14 brush:wash seed:200+i name:ripple
  curve 65,508 168,501 265,510 387,506 465,516 stroke:d.violet,12 a:.2 brush:wash name:far_shore
  curve 548,837 649,764 682,700 757,660 796,609 850,568 892,506 1015,484 1140,469 1140,841 closed fill:d.rock brush:wash(rag:8 reach:8) name:cliff
    curve 722,801 758,721 818,702 836,628 894,561 948,529 1012,515 1002,677 1094,839 closed fill:d.deep a:.72 brush:wash name:cliff_shadow
    curve 594,833 697,745 720,682 804,636 845,573 893,534 898,573 846,649 800,672 776,748 705,795 closed fill:d.peach a:.37 brush:wash name:cliff_light
    each i in 0..27
      let x = rand(730 1130)
      let y = rand(570 835)
      curve x,y x-15,y+31 x-9,y+rand(45 80) stroke:d.deep,rand(2 9) a:.3 brush:wash seed:500+i name:fissure
  curve 826,573 850,536 889,501 927,489 980,480 1040,476 1140,467 1140,513 1049,517 981,514 927,532 884,547 closed fill:d.moss brush:wash(rag:5 reach:6) name:grass
  curve 1133,489 1077,486 1027,493 984,502 950,517 stroke:d.cream,[8 13 5] a:.58 brush:wash name:footpath
  curve 970,283 545,333 219,407 210,441 544,374 969,302 closed fill:d.gold a:.12 brush:wash(rag:9 reach:10) name:beam
  ellipse 67,44 at:971,294 fill:d.gold a:.2 brush:wash name:halo
  curve 937,476 948,315 983,315 1001,477 982,484 952,482 closed fill:d.cream brush:wash(rag:1.5 reach:2) name:tower
    curve 973,316 984,314 1002,480 974,484 closed fill:d.violet a:.43 brush:wash name:tower_shade
    curve 944,382 990,378 994,401 942,408 closed fill:d.rust a:.85 brush:wash name:stripe
    path "M955 478 L956 453 Q964 441 972 452 L973 479 Z" fill:d.deep brush:wash name:door
    rect 7x16 at:966,345 fill:d.deep brush:wash name:window
    curve 949,419 951,439 stroke:d.peach,4 a:.7 brush:wash name:wall_mark
  curve 938,316 992,316 stroke:d.deep,7 brush:wash name:gallery_base
  curve 936,306 994,306 stroke:d.deep,2 brush:wash name:rail
  each i in 0..6
    curve 938+i*11,305 938+i*11,315 stroke:d.deep,1.8 brush:wash seed:700+i
  rect 36x30 at:966,290 fill:d.gold brush:wash name:lantern
  curve 948,277 948,303 984,303 984,277 stroke:d.deep,3 brush:wash name:lantern_frame
  curve 966,277 966,303 stroke:d.rust,2 brush:wash name:glass_bar
  curve 941,277 950,267 965,260 982,267 990,277 closed fill:d.deep brush:wash name:roof
  curve 965,262 965,249 stroke:d.deep,2 brush:wash name:finial
  ellipse 7,10 at:965,290 fill:d.cream brush:wash name:lamp
  curve 591,817 647,801 677,770 697,750 stroke:d.cream,[1 8 3 1] a:.63 brush:wash name:surf_one
  curve 494,832 565,806 607,781 647,759 stroke:d.cream,[1 4 5 1] a:.38 brush:wash name:surf_two
  each i in 0..5
    let x = 342+i*40
    let y = 293+rand(-30 30)
    curve x,y x+9,y+4 x+16,y+1 x+23,y+5 x+31,y+3 stroke:d.deep,1.6 a:.6 brush:wash seed:900+i

layer paper_texture
  rect 1200x900 at:600,450 fill:d.paper a:.09 name:tooth
    fx grain .11 scale:.7
