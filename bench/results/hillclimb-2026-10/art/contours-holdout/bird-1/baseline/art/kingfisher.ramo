@target kingfisher.png 1200x1000 bg:river.paper
@target kingfisher.svg 1200x1000 bg:river.paper

palette river
  color paper #f6e9ca
  color ink #102f42
  color blue #008dad
  color orange #ed7136

# Four inks, broad cut-paper silhouettes, and a diagonal plunge.
layer landscape
  circle 110 at:945,205 fill:river.orange name:sun
  path "M60 700 C270 610 390 730 610 670 C800 616 990 629 1140 570 L1140 940 L60 940 Z" fill:river.blue name:river_surface
  path "M60 800 C270 710 400 820 620 760 C860 690 1010 740 1140 690 L1140 940 L60 940 Z" fill:river.ink name:deep_water
  path "M60 884 C250 818 407 911 600 856 C800 799 970 849 1140 796 L1140 831 C935 883 801 837 610 891 C390 947 245 858 60 925 Z" fill:river.blue name:current
  path "M118 743 C244 708 333 747 435 731" fill:none stroke:river.paper,12 name:upper_ripple
  path "M811 768 C902 746 991 774 1084 747" fill:none stroke:river.paper,12 name:lower_ripple

layer distant_wing
  path "M529 359 C503 278 448 183 352 112 L376 242 L413 286 L401 197 L456 335 L476 285 L491 379 Z" fill:river.ink name:far_wing

layer bird_body
  path "M465 373 L298 329 L355 389 L312 391 L438 428 Z" fill:river.ink name:tail
  path "M423 338 C496 325 569 356 619 410 C647 436 674 465 682 506 C643 544 573 525 516 483 C468 449 430 401 423 338 Z" fill:river.blue name:back
  path "M446 403 C486 416 509 436 544 451 C591 471 631 462 657 479 L680 506 C644 549 574 531 516 487 C482 461 462 435 446 403 Z" fill:river.orange name:breast
  path "M560 414 C580 380 630 385 657 416 C677 437 683 468 682 506 L636 501 C606 477 577 454 560 414 Z" fill:river.blue name:head
  path "M622 468 L657 458 L764 627 L670 529 Z" fill:river.ink name:beak
  path "M604 455 L623 448 L654 486 L639 497 L610 478 Z" fill:river.paper name:cheek
  path "M568 420 L582 411 L603 429 L587 438 Z" fill:river.paper name:collar
  circle 10 at:637,442 fill:river.ink name:eye

layer near_wing
  path "M526 421 C469 397 424 350 387 290 C354 236 333 168 340 92 C375 122 402 148 431 180 C475 228 521 302 550 373 C562 401 553 421 526 421 Z" fill:river.ink name:wing
  path "M359 130 C414 174 479 263 513 342 C461 309 404 233 359 130 Z" fill:river.blue name:wing_panel
  path "M377 203 L472 347 L444 324 Z" fill:river.paper name:feather_one
  path "M413 274 L490 375 L464 359 Z" fill:river.paper name:feather_two

layer river_details
  ellipse 77,10 at:785,690 fill:river.paper name:impact_ring
  ellipse 49,5 at:785,690 fill:river.blue name:ring_center
  path "M757 659 L738 623 L763 644 Z" fill:river.paper name:spray_left
  path "M802 652 L819 613 L818 650 Z" fill:river.paper name:spray_right
  path "M878 881 L907 861 L937 881 L907 901 Z" fill:river.orange name:fish
  path "M936 881 L957 864 L957 898 Z" fill:river.orange name:fish_tail
  circle 3 at:894,879 fill:river.ink name:fish_eye

layer reeds
  path "M118 665 L115 514 L128 557 L130 657 Z" fill:river.ink name:reed_one
  path "M143 657 C145 580 176 542 198 528 C174 579 163 617 160 653 Z" fill:river.ink name:reed_two
  path "M1034 612 L1042 480 L1053 506 L1049 607 Z" fill:river.ink name:reed_three
