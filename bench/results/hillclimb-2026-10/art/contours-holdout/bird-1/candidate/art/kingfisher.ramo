@target kingfisher.png 1000x1000 bg:river.paper
@target kingfisher.svg 1000x1000 bg:river.paper

palette river
  color paper #f5eacf
  color ink #123d49
  color blue #008f9a
  color orange #ec692f

# Four-color screenprint: swept wings and a spear-like diving silhouette.
layer setting
  circle 78 at:804,180 fill:river.orange name:sun
  path "M50 749 C200 698 316 805 478 757 C660 703 768 742 950 703 L950 950 L50 950 Z" fill:river.blue name:river_surface
  path "M50 840 C223 782 326 901 512 835 C696 770 805 832 950 792 L950 847 C791 888 693 829 522 888 C334 951 211 838 50 895 Z" fill:river.ink name:river_current
  path "M76 774 C191 747 263 786 342 791" stroke:river.paper,10 fill:none name:near_ripple
  path "M608 918 C733 875 814 917 921 881" stroke:river.paper,10 fill:none name:far_ripple

layer far_wing
  path "M475 427 C526 313 582 233 685 157 C665 230 632 291 599 338 L661 292 C638 353 590 405 548 454 Z" fill:river.ink name:raised_wing
  path "M504 416 C547 321 593 263 650 217 C625 278 581 348 543 410 Z" fill:river.blue name:wing_panel

layer tail
  path "M423 411 L280 349 L319 409 L286 403 L405 475 Z" fill:river.ink name:tail_fan
  path "M404 425 L316 378 L362 424 L414 450 Z" fill:river.blue name:tail_stripe

layer body
  path "M387 389 C436 374 502 389 552 433 C595 470 622 516 606 550 C590 579 548 585 511 562 C460 531 424 471 387 389 Z" fill:river.blue name:back
  path "M398 413 C427 465 454 512 510 554 C546 580 581 573 598 549 C569 541 550 513 528 488 C488 445 451 421 398 413 Z" fill:river.orange name:breast
  path "M423 389 C353 341 295 258 182 161 C188 237 217 305 256 356 L199 324 C235 391 287 431 329 448 L287 447 C347 490 404 491 464 477 C484 452 466 416 423 389 Z" fill:river.ink name:near_wing
  path "M222 218 C277 264 339 348 412 399 C434 414 445 433 443 451 C369 430 283 341 222 218 Z" fill:river.blue name:wing_coverts
  path "M271 328 C311 369 345 400 386 420 L369 437 C329 417 295 378 271 328 Z" fill:river.paper name:feather_flash

layer head
  path "M535 450 C570 438 610 453 634 486 C650 507 654 529 641 553 L608 579 C579 572 552 549 537 525 C523 501 522 471 535 450 Z" fill:river.blue name:head_crown
  path "M547 505 C580 508 602 519 622 543 L608 575 C578 569 555 547 547 505 Z" fill:river.paper name:collar
  path "M574 483 C596 481 621 495 635 513 L654 537 L630 553 C617 530 590 515 565 514 Z" fill:river.ink name:eye_mask
  path "M635 520 L774 688 L626 553 Z" fill:river.ink name:bill
  path "M641 540 L743 650 L633 551 Z" fill:river.orange name:bill_seam
  circle 9 at:606,508 fill:river.paper name:eye_ring
  circle 5 at:608,510 fill:river.ink name:eye
  path "M547 470 L570 469 M569 480 L587 483" stroke:river.paper,6 fill:none name:crown_marks

layer water_marks
  path "M733 738 C752 732 777 732 798 738" stroke:river.paper,9 fill:none name:target_ripple
  path "M700 760 C744 747 792 750 828 760" stroke:river.paper,7 fill:none name:outer_ripple
  path "M100 671 L139 630 L131 680 Z" fill:river.ink name:reed_one
  path "M113 702 L160 667 L145 714 Z" fill:river.ink name:reed_two
