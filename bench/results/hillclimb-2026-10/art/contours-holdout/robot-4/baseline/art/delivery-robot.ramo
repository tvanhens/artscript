@target delivery-robot.png 512x512 bg:none
@target delivery-robot.svg 512x512 bg:none

palette bot
  ramp mint #69d7be 5
  ramp cream #f2f5de 5
  ramp orange #f1ae61 5
  color ink #243e50
  color screen #20394b
  color eyes #a6ffe3
  color white #ffffff
  color tire #344b5c
  color pink #ef9191

layer antenna
  curve 259,110 267,73 stroke:bot.ink,10
  circle 15 at:269,64 fill:bot.orange stroke:bot.ink,7 name:beacon
    circle 5 at:-4,-5 fill:bot.cream.4

layer wheels
  rect 65x87 r:25 at:178,414 rot:5 fill:bot.tire stroke:bot.ink,8 name:left_wheel
    rect 11x53 r:5 at:-15,-1 fill:bot.cream.1
  rect 65x87 r:25 at:341,414 rot:-5 fill:bot.tire stroke:bot.ink,8 name:right_wheel
    rect 11x53 r:5 at:15,-1 fill:bot.cream.1
  rect 146x29 r:12 at:257,422 fill:bot.ink

layer chassis
  rect 205x178 r:53 at:257,329 fill:bot.mint stroke:bot.ink,8 name:body
    rect 214x49 r:20 at:0,71 fill:bot.mint.1
    rect 19x104 r:9 at:-83,-7 fill:bot.mint.3
  rect 140x24 r:12 at:257,263 fill:bot.cream stroke:bot.ink,7

layer head_parts
  rect 34x61 r:15 at:132,183 fill:bot.orange stroke:bot.ink,7
  rect 34x61 r:15 at:380,183 fill:bot.orange stroke:bot.ink,7
  rect 242x161 r:55 at:256,179 fill:bot.cream stroke:bot.ink,8 name:head
    rect 250x43 r:18 at:0,74 fill:bot.mint.2
    curve -90,-49 -66,-64 -29,-64 stroke:bot.white,9
  rect 193x108 r:36 at:256,184 fill:bot.screen stroke:bot.ink,5 name:face
    curve -77,-32 -58,-39 -23,-39 stroke:bot.cream.2,5 a:.3
    curve -53,-1 -48,-10 -39,-13 -30,-10 -26,-1 stroke:bot.eyes,9 name:left_eye
    curve 26,-1 30,-10 39,-13 48,-10 53,-1 stroke:bot.eyes,9 name:right_eye
    curve -18,17 -10,25 0,28 10,25 18,17 stroke:bot.eyes,6 name:smile
    ellipse 11,5 at:-64,20 fill:bot.pink
    ellipse 11,5 at:64,20 fill:bot.pink

layer parcel
  rect 136x105 r:13 at:257,347 rot:-5 fill:bot.orange stroke:bot.ink,7 name:package
    rect 144x19 at:0,43 fill:bot.orange.1
    rect 25x109 at:0,0 fill:bot.cream
    rect 144x12 at:0,-44 fill:bot.orange.3
    rect 25x19 at:0,-44 fill:bot.cream.4
    rect 32x23 r:4 at:39,20 fill:bot.cream.4
    curve 29,20 45,20 stroke:bot.orange.1,4

layer arms
  curve 165,291 138,317 153,347 stroke:bot.ink,32
  curve 165,291 138,317 153,347 stroke:bot.mint,19
  ellipse 23,19 at:167,350 rot:25 fill:bot.cream stroke:bot.ink,7 name:left_hand
    curve -7,-5 2,1 stroke:bot.mint.1,4
  curve 350,291 377,317 361,347 stroke:bot.ink,32
  curve 350,291 377,317 361,347 stroke:bot.mint,19
  ellipse 23,19 at:347,350 rot:-25 fill:bot.cream stroke:bot.ink,7 name:right_hand
    curve 7,-5 -2,1 stroke:bot.mint.1,4

layer details
  rect 35x9 r:4 at:257,408 fill:bot.ink
  circle 4 at:244,408 fill:bot.eyes
  circle 4 at:257,408 fill:bot.eyes
