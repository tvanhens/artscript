@target delivery-robot.png 512x512 bg:none
@target delivery-robot.svg 512x512 bg:none

palette bot
  color ink #203c49
  color screen #173443
  color eye #b9fff0
  color white #f5fff7
  color mint #86dfc4
  color shade #46b49f
  color deep #278f83
  color tire #304754
  color hub #7795a0
  color orange #f5ae60
  color orange_dark #d98043
  color tape #ffe0a0
  color blush #f6a18c

layer aerial
  path "M250 123 L245 82" fill:none stroke:bot.ink,10 name:antenna
  circle 15 at:244,70 fill:bot.orange stroke:bot.ink,7 name:beacon
    circle 5 at:-4,-5 fill:bot.tape

layer wheels
  rect 68x93 r:29 at:169,403 fill:bot.tire stroke:bot.ink,8 name:left_wheel
    rect 15x60 r:7 at:-14,-2 fill:bot.hub
  rect 68x93 r:29 at:346,403 fill:bot.tire stroke:bot.ink,8 name:right_wheel
    rect 15x60 r:7 at:13,-2 fill:bot.hub

layer arms
  path "M151 266 C111 268 95 301 108 334" fill:none stroke:bot.ink,32 name:left_arm_edge
  path "M151 266 C111 268 95 301 108 334" fill:none stroke:bot.shade,18 name:left_arm
  path "M365 263 C402 266 412 288 402 310" fill:none stroke:bot.ink,32 name:right_arm_edge
  path "M365 263 C402 266 412 288 402 310" fill:none stroke:bot.mint,18 name:right_arm

layer chassis
  path "M157 229 Q148 227 145 248 L132 365 Q131 396 163 404 L344 404 Q377 398 376 369 L365 250 Q363 230 346 229 Z" fill:bot.mint stroke:bot.ink,8 name:body
    path "M339 220 L385 225 L388 421 L129 421 L127 374 L327 374 Q350 366 347 341 Z" fill:bot.shade
    path "M151 256 L145 346" fill:none stroke:bot.white,9
  rect 240x29 r:14 at:254,389 fill:bot.deep stroke:bot.ink,7 name:bumper

layer head
  rect 254x156 r:48 at:254,186 fill:bot.mint stroke:bot.ink,8 name:head_shell
    path "M-121 -29 Q-112 -71 -65 -69 L68 -69" fill:none stroke:bot.white,9
    rect 40x160 at:115,12 fill:bot.shade
  rect 209x105 r:32 at:254,189 fill:bot.screen stroke:bot.ink,6 name:face
    path "M-70 -26 Q-56 -36 -30 -36 L45 -36" fill:none stroke:bot.hub,4 a:.4
    path "M-62 0 Q-48 -25 -34 0" fill:none stroke:bot.eye,9 name:left_eye
    path "M30 0 Q44 -25 58 0" fill:none stroke:bot.eye,9 name:right_eye
    path "M-17 18 Q0 36 17 18" fill:none stroke:bot.eye,6 name:smile
    ellipse 12,6 at:-73,20 fill:bot.blush
    ellipse 12,6 at:70,20 fill:bot.blush

layer parcel
  group at:254,319 rot:-5
    rect 149x109 r:10 fill:bot.orange stroke:bot.ink,7 name:box
      rect 150x25 at:0,45 fill:bot.orange_dark
      rect 28x115 at:0,0 fill:bot.tape
      path "M-68 -43 L-22 -43" fill:none stroke:bot.tape,5
    rect 39x28 r:4 at:44,18 fill:bot.white name:label
      path "M-11 0 L11 0 M5 -6 L11 0 L5 6" fill:none stroke:bot.deep,4

layer hands
  rect 39x47 r:16 at:166,323 rot:-12 fill:bot.mint stroke:bot.ink,7 name:left_hand
    path "M-8 -9 L4 -9" fill:none stroke:bot.white,5
  rect 39x47 r:16 at:343,312 rot:10 fill:bot.mint stroke:bot.ink,7 name:right_hand
    path "M-8 -9 L4 -9" fill:none stroke:bot.white,5

layer accents
  path "M400 153 L400 128 M388 140 L412 140" fill:none stroke:bot.orange,7 name:spark
  circle 5 at:109,213 fill:bot.shade name:dot
