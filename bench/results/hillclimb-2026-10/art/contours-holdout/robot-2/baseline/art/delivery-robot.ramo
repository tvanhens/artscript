@target delivery-robot.png 512x512 bg:none scale:1,2
@target delivery-robot.svg 512x512 bg:none

# Rounded toy-like vector icon, lit from the upper left.
palette bot
  color ink #233f50
  color white #fff9e9
  color mint #c9f2df
  color teal #48bda7
  color shade #279889
  color screen #203d50
  color glow #a9f6de
  color coral #ff8d73
  color box #efb86c
  color boxlight #ffda99
  color boxshade #d7944d
  color tape #fff0c6

def wheel
  rect 47x72 r:21 fill:bot.ink
    rect 12x49 r:6 at:-9,-2 fill:bot.screen
    curve -12,-18 -12,12 stroke:bot.teal,5

def eye
  curve -11,3 -8,-5 0,-9 8,-5 11,3 stroke:bot.glow,8

layer antenna
  curve 246,126 239,85 stroke:bot.ink,10 name:antenna_stem
  circle 17 at:237,76 fill:bot.coral stroke:bot.ink,7 name:antenna_tip
    circle 5 at:-5,-5 fill:bot.white

layer chassis
  wheel at:177,425 name:wheel_left
  wheel at:334,425 name:wheel_right
  rect 176x43 r:18 at:256,397 fill:bot.shade stroke:bot.ink,7 name:bumper
  rect 221x183 r:48 at:256,319 fill:bot.teal stroke:bot.ink,8 name:body
    rect 190x151 r:44 at:-20,-27 fill:bot.mint
    curve -83,-48 -83,-18 stroke:bot.white,9

layer arms
  curve 151,286 125,307 137,353 164,358 fill:none stroke:bot.ink,28 name:arm_left
  curve 151,286 125,307 137,353 164,358 fill:none stroke:bot.teal,15
  curve 360,286 388,307 376,353 350,358 fill:none stroke:bot.ink,28 name:arm_right
  curve 360,286 388,307 376,353 350,358 fill:none stroke:bot.teal,15

layer head
  rect 26x48 r:12 at:139,194 fill:bot.teal stroke:bot.ink,7
  rect 26x48 r:12 at:373,194 fill:bot.teal stroke:bot.ink,7
  rect 225x151 r:48 at:256,192 fill:bot.mint stroke:bot.ink,8 name:head_shell
    rect 221x144 r:46 at:-10,-15 fill:bot.white
    curve -84,-40 -71,-55 -37,-57 stroke:bot.white,9
  rect 180x100 r:35 at:256,195 fill:bot.screen stroke:bot.ink,5 name:face
    path "M -83 -29 Q -76 -46 -53 -46 L 54 -46 Q 74 -46 80 -26 L -83 -5 Z" fill:bot.white a:.08
  eye at:220,184 name:eye_left
  eye at:290,184 name:eye_right
  curve 239,210 255,219 271,210 stroke:bot.glow,6 name:smile
  ellipse 10,5 at:192,209 fill:bot.coral
  ellipse 10,5 at:320,209 fill:bot.coral

layer parcel
  rect 156x119 r:12 at:256,341 fill:bot.box stroke:bot.ink,7 name:package
    rect 25x124 at:67,0 fill:bot.boxshade
    rect 156x27 at:0,-46 fill:bot.boxlight
    rect 25x58 at:0,-32 fill:bot.tape
    path "M -12 -11 L 0 -18 L 12 -11 L 12 -61 L -12 -61 Z" fill:bot.tape
    rect 57x31 r:6 at:-23,24 fill:bot.white
    curve -40,24 -13,24 stroke:bot.ink,4
    curve -21,17 -13,24 -21,31 stroke:bot.ink,4
    curve -64,-39 -64,-23 stroke:bot.white,5
  rect 32x37 r:14 at:176,355 rot:-10 fill:bot.mint stroke:bot.ink,6 name:hand_left
  rect 32x37 r:14 at:336,355 rot:10 fill:bot.mint stroke:bot.ink,6 name:hand_right

assert inside(@head_shell canvas margin:24)
assert level(@eye_left @eye_right)
assert inside(@wheel_left canvas margin:24)
assert inside(@wheel_right canvas margin:24)
