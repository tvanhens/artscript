@target delivery-robot.png 512x512 bg:none
@target delivery-robot.svg 512x512 bg:none

palette bot
  color ink #233d50
  color tire #344f62
  color hub #91b9bf
  color mint #8fe0cc
  color light #d8fff0
  color shade #4cb9ac
  color screen #19394b
  color eye #8effdd
  color white #f6fff7
  color orange #f6b363
  color boxshade #db8747
  color tape #ffe1a2
  color blush #ff9f91

layer antenna
  curve 250,136 245,100 stroke:bot.ink,12
  circle 16 at:244,89 fill:bot.orange stroke:bot.ink,7
    circle 5 at:-5,-5 fill:bot.tape

layer wheels
  rect 65x89 r:25 at:170,409 fill:bot.tire stroke:bot.ink,8 name:left_wheel
    rect 15x55 r:7 at:-12,0 fill:bot.hub
  rect 65x89 r:25 at:340,409 fill:bot.tire stroke:bot.ink,8 name:right_wheel
    rect 15x55 r:7 at:12,0 fill:bot.hub

layer arms
  curve 146,292 111,314 110,345 stroke:bot.ink,28
  curve 146,292 111,314 110,345 stroke:bot.shade,13
  circle 21 at:112,347 fill:bot.mint stroke:bot.ink,7
  curve 368,281 397,258 401,222 stroke:bot.ink,28
  curve 368,281 397,258 401,222 stroke:bot.shade,13
  rect 39x43 r:17 at:402,212 rot:12 fill:bot.mint stroke:bot.ink,7
    curve -8,-5 8,-5 stroke:bot.light,5

layer chassis
  rect 240x197 r:53 at:256,311 fill:bot.mint stroke:bot.ink,9 name:body
    rect 250x57 r:24 at:0,83 fill:bot.shade
    curve -95,-56 -84,-75 -57,-80 stroke:bot.light,9
    rect 173x11 r:5 at:0,74 fill:bot.ink
  rect 128x23 r:10 at:256,411 fill:bot.mint stroke:bot.ink,7

layer head_shell
  rect 261x166 r:55 at:251,202 fill:bot.mint stroke:bot.ink,9 name:head
    rect 280x38 r:15 at:0,75 fill:bot.shade
    curve -103,-39 -91,-58 -66,-62 stroke:bot.light,8
  rect 211x114 r:37 at:251,202 fill:bot.screen stroke:bot.ink,6 name:face
    curve -75,-35 -35,-40 19,-40 stroke:bot.hub,5 a:.3
    rect 18x31 r:9 at:-43,-5 fill:bot.eye
    rect 18x31 r:9 at:43,-5 fill:bot.eye
    path "M-23 22 Q0 47 23 22" fill:none stroke:bot.eye,8
    ellipse 12,6 at:-70,21 fill:bot.blush
    ellipse 12,6 at:70,21 fill:bot.blush

layer parcel
  rect 136x96 r:12 at:259,339 rot:-5 fill:bot.orange stroke:bot.ink,7 name:package
    rect 145x23 at:0,39 fill:bot.boxshade
    rect 25x100 at:0,0 fill:bot.tape
    curve -64,-23 64,-23 stroke:bot.boxshade,4
    rect 25x19 at:0,-38 fill:bot.tape
    rect 28x20 r:3 at:37,17 fill:bot.white
    curve 30,17 43,17 stroke:bot.ink,3

layer fingers
  rect 35x30 r:12 at:185,346 rot:-12 fill:bot.mint stroke:bot.ink,6
    curve -3,-6 -3,6 stroke:bot.shade,4
  rect 35x30 r:12 at:332,333 rot:-4 fill:bot.mint stroke:bot.ink,6
    curve 3,-6 3,6 stroke:bot.shade,4
