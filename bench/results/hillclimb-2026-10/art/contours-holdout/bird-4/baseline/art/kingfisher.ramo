@target kingfisher.png 1000x1000 bg:bird.paper
@target kingfisher.svg 1000x1000 bg:bird.paper

palette bird
  color paper #f5ebd5
  color ink #102f40
  color blue #008c9d
  color orange #ec672d

# Four spot colors, cut-paper silhouettes, no shading.
layer river
  path "M50 735 C245 635 379 790 565 731 C722 682 826 703 950 645 L950 950 L50 950 Z" fill:bird.blue name:water
  path "M50 829 C242 722 388 888 589 813 C735 758 840 788 950 745 L950 789 C798 833 745 807 603 860 C379 940 251 787 50 876 Z" fill:bird.ink name:current
  path "M114 916 C265 853 345 939 467 917" fill:none stroke:bird.paper,12 cap:round name:low_ripple
  path "M697 894 C772 870 825 888 891 858" fill:none stroke:bird.paper,12 cap:round name:far_ripple
  path "M549 764 C613 746 661 754 700 769" fill:none stroke:bird.paper,10 name:surface_ripple

layer distant_bank
  path "M68 649 L68 538 L84 538 L84 586 L112 559 L123 570 L84 610 L84 649 Z" fill:bird.ink name:reed_one
  path "M125 638 L125 594 L140 594 L140 638 Z" fill:bird.orange name:reed_two

layer bird_tail
  path "M438 422 L248 386 L326 462 L482 492 Z" fill:bird.ink name:tail
  path "M441 430 L285 404 L351 443 L470 470 Z" fill:bird.blue name:tail_stripe

layer far_wing
  path "M467 448 C393 403 344 303 365 175 C402 214 446 283 489 351 L555 444 Z" fill:bird.ink name:raised_wing
  path "M387 230 L423 315 L477 384 L462 400 C413 357 388 303 387 230 Z" fill:bird.blue name:far_feather

layer body
  path "M393 406 C474 365 553 398 608 454 L674 526 L616 577 C539 567 444 503 393 406 Z" fill:bird.orange name:breast
  path "M393 406 C468 378 544 402 589 442 L637 483 L600 510 C530 482 470 451 393 406 Z" fill:bird.blue name:back
  path "M570 465 L632 482 L657 520 L618 544 L576 508 Z" fill:bird.paper name:collar

layer near_wing
  path "M544 459 C481 441 421 406 385 352 C336 278 304 174 184 109 C193 205 229 293 278 360 C344 449 433 490 544 459 Z" fill:bird.blue name:wing
  path "M201 141 C236 251 296 365 398 418 C325 396 267 349 235 293 C212 248 201 190 201 141 Z" fill:bird.ink name:flight_feathers
  path "M230 184 C271 266 312 322 358 356 L342 365 C284 322 246 254 230 184 Z" fill:bird.paper name:feather_cut_one
  path "M275 214 C311 274 346 317 386 342 L372 352 C327 322 294 271 275 214 Z" fill:bird.paper name:feather_cut_two
  path "M325 254 C352 289 380 315 410 330 L397 342 C363 322 340 291 325 254 Z" fill:bird.paper name:feather_cut_three

layer head
  path "M588 451 C625 426 669 448 691 477 C708 499 710 528 696 550 L655 575 L613 542 L594 500 Z" fill:bird.blue name:head_shape
  path "M610 492 C638 474 669 486 689 510 L709 537 L675 553 L645 528 Z" fill:bird.ink name:mask_band
  path "M687 517 L807 675 L669 550 Z" fill:bird.ink name:beak
  path "M691 539 L775 638 L677 552 Z" fill:bird.orange name:beak_split
  path "M612 526 L643 533 L666 558 L651 575 L624 553 Z" fill:bird.paper name:cheek
  circle 10 at:660,511 fill:bird.paper name:eye_ring
  circle 6 at:662,513 fill:bird.ink name:eye

layer dive_marks
  path "M749 693 L763 717 L739 708 Z" fill:bird.orange name:splash_one
  path "M790 716 L811 696 L807 725 Z" fill:bird.paper name:splash_two
  ellipse 49,7 at:782,749 fill:bird.ink name:impact_ripple
  ellipse 23,4 at:782,747 fill:bird.paper name:impact_glint
