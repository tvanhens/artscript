@target cozy-teapot.png 1000x800 bg:tea.paper

palette tea
  color paper #f4e8cf
  color wall #e7d6b9
  color cream #fff3d5
  color sage #80917a
  color green #627c69
  color dark #3c5b50
  color light #b7c2a0
  color yellow #e7af35
  color flesh #f5cf62
  color pith #fae9ae
  color gold #bb7f2f
  color rose #c28f7d
  color fold #aa7568
  color shadow #765e50

brush gouache grain:.1 rag:1.2 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 12 + seeded(m), 3);
    float grit = hash12(floor(m.dev));
    float streak = vnoise(float2(m.uv.x / 40, m.uv.y / 1.4) + seeded(m));
    float3 pigment = m.paint.rgb * (1 + (n-.5)*grain + (grit-.5)*.055 + (streak-.5)*.045);
    return float4(pigment, cover(m.edge + (n-.5)*rag, m));
  }
  """

layer backdrop brush:gouache
  rect 1000x800 at:500,400 fill:tea.paper brush:gouache(reach:0 rag:0) name:paper
  ellipse 380,280 at:492,331 fill:tea.wall a:.35 name:glow
  curve 70,590 231,538 515,552 874,570 939,698 777,748 223,741 65,683 closed fill:tea.rose name:cloth
    curve 70,619 280,581 563,602 902,624 stroke:tea.cream,3 a:.3 name:weave_one
    curve 101,664 310,622 604,654 921,677 stroke:tea.cream,3 a:.24 name:weave_two
    curve 248,548 300,629 322,743 stroke:tea.fold,9 a:.38 name:fold_one
    curve 745,556 720,641 756,746 stroke:tea.fold,12 a:.32 name:fold_two

layer grounding brush:gouache
  ellipse 260,36 at:473,642 fill:tea.shadow a:.24 name:pot_shadow
  ellipse 138,20 at:743,665 fill:tea.shadow a:.28 name:fruit_shadow
  ellipse 211,30 at:447,639 fill:tea.cream name:trivet
    ellipse 184,20 at:0,-3 fill:tea.wall name:trivet_inset

layer handle brush:gouache
  path "M 334 363 C 170 289 144 474 232 527 C 264 548 296 521 318 496" fill:none stroke:tea.dark,38 name:handle_back
  path "M 327 358 C 180 299 160 468 238 513 C 264 529 290 510 310 491" fill:none stroke:tea.sage,25 name:handle_paint
  path "M 273 355 C 204 355 185 421 205 458" fill:none stroke:tea.light,6 name:handle_light

layer spout_paint brush:gouache
  path "M 539 421 C 604 419 636 377 672 320 L 715 329 C 683 353 684 414 653 461 C 630 495 601 508 564 514 Z" fill:tea.green name:spout
    path "M 575 444 C 637 421 658 369 684 337" fill:none stroke:tea.light,17 name:upper_light
    path "M 593 492 C 654 471 661 428 676 392" fill:none stroke:tea.dark,13 a:.55 name:lower_shade
  ellipse 24,9 at:694,324 rot:12 fill:tea.dark name:spout_opening
  curve 672,318 694,321 716,329 stroke:tea.light,5 name:spout_lip

layer vessel brush:gouache
  path "M 353 348 C 311 363 275 435 280 513 C 286 605 338 634 449 636 C 559 638 614 602 613 518 C 612 436 572 365 533 348 Z" fill:tea.sage name:body
    path "M 505 357 C 554 409 584 500 554 570 C 536 613 472 637 418 646 L 642 651 L 638 353 Z" fill:tea.green name:body_shadow
    path "M 350 385 C 316 433 307 483 319 523" fill:none stroke:tea.light,29 name:body_light
    path "M 330 549 C 346 598 432 615 483 601" fill:none stroke:tea.light,10 a:.38 name:reflected_light
    each i in 0..5
      curve 365+i*32,500 375+i*32,484 385+i*32,500 stroke:tea.cream,4 a:.72 name:scallop
    curve 354,528 403,540 463,541 521,526 stroke:tea.cream,4 a:.7 name:decoration
    each i in 0..5
      ellipse 3,5 at:373+i*32,559 fill:tea.cream a:.65 name:dot
  ellipse 116,17 at:446,356 fill:tea.dark name:rim
  path "M 322 350 C 335 328 379 311 441 311 C 508 311 549 325 566 350 C 514 369 376 370 322 350 Z" fill:tea.sage name:lid
    curve 338,346 392,329 450,326 522,339 stroke:tea.light,10 name:lid_light
  curve 324,352 384,364 474,365 565,352 stroke:tea.dark,5 name:lid_seam
  ellipse 25,9 at:444,313 fill:tea.dark name:knob_base
  ellipse 21,18 at:443,298 fill:tea.green name:knob
    ellipse 11,5 at:-5,-8 fill:tea.light name:knob_light

layer lemon brush:gouache
  ellipse 66,44 at:773,609 rot:-18 fill:tea.gold name:lemon_back
  ellipse 66,44 at:771,600 rot:-18 fill:tea.yellow name:lemon_half
    ellipse 47,26 at:-8,-9 fill:tea.flesh name:lemon_highlight
  group slice at:701,631 rot:-16
    ellipse 72,54 at:0,8 fill:tea.gold name:rind_shadow
    ellipse 72,54 fill:tea.yellow name:rind
    ellipse 65,47 fill:tea.pith name:pith
    ellipse 58,40 fill:tea.flesh name:pulp
      each i in 0..9
        group ray rot:i*40
          path "M 4 0 L 52 -13 Q 61 0 52 13 Z" fill:tea.yellow a:.48 name:segment
          curve 7,0 28,0 57,0 stroke:tea.pith,3 name:membrane
          curve 22,5 36,6 46,5 stroke:tea.cream,2 a:.7 name:juice
      ellipse 7,5 fill:tea.pith name:center
      ellipse 3,6 at:22,-12 rot:35 fill:tea.pith name:seed_one
      ellipse 3,5 at:-20,12 rot:-30 fill:tea.pith name:seed_two
  curve 796,585 822,559 858,562 837,584 796,585 closed fill:tea.green name:leaf
    curve 797,583 824,572 850,565 stroke:tea.light,2 name:vein

layer steam brush:gouache
  path "M 421 263 C 388 230 459 206 434 171 C 416 146 425 128 442 113" fill:none stroke:tea.cream,[3 11 8 2] a:.85 name:steam_one
  path "M 475 267 C 504 240 462 218 487 187 C 506 164 498 147 487 139" fill:none stroke:tea.cream,[2 9 6 1] a:.7 name:steam_two
  path "M 691 296 C 676 273 709 257 701 236" fill:none stroke:tea.cream,[2 7 1] a:.75 name:steam_spout

assert inside(@body canvas margin:50)
assert inside(@rind canvas margin:50)
