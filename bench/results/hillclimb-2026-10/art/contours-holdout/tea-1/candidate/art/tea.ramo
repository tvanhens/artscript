@target tea.png 1000x850 bg:tea.paper

palette tea
  color paper #eee2cb
  color cream #fff3d9
  ramp teal #487e79 5
  ramp yellow #e5b83e 5
  ramp linen #c48970 5
  color shadow #927b66
  color leaf #6c7950

brush gouache grain:.14 rag:1.4 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 6 + seeded(m), 3);
    float b = vnoise(float2(m.p.x / 30, m.p.y / 1.7) + seeded(m));
    float3 col = m.paint.rgb * (1.0 - grain * .6 + n * grain) + (b - .5) * .035;
    return float4(col, cover(m.edge + (n - .5) * rag, m));
  }
  """

layer paper_texture
  rect 1000x850 at:500,425 fill:tea.paper brush:gouache(reach:0) name:paper

layer tabletop brush:gouache
  ellipse 402,104 at:499,647 fill:tea.linen.3 name:cloth
    curve -430,-20 0,-36 420,0 stroke:tea.linen.4,7 name:weave_a
    curve -430,24 0,10 420,40 stroke:tea.linen.4,5 name:weave_b
  ellipse 260,28 at:451,641 fill:tea.shadow a:.22 name:pot_shadow
  ellipse 116,21 at:741,670 fill:tea.shadow a:.23 name:fruit_shadow

layer handle_layer brush:gouache
  path "M325 387 C200 317 165 385 185 467 C198 520 253 549 310 514" fill:none stroke:tea.teal.1,37 name:handle
  path "M309 387 C224 347 191 390 207 453" fill:none stroke:tea.teal.3,10 name:handle_light

layer spout_layer brush:gouache
  path "M563 439 C617 432 637 383 657 345 C668 323 691 309 713 306 C695 332 692 367 683 405 C673 461 629 498 580 510 Z" fill:tea.teal.2 name:spout
    path "M625 439 C664 403 665 348 698 318" stroke:tea.teal.3,15 fill:none name:spout_light
  ellipse 18,7 at:703,310 rot:-26 fill:tea.teal.0 name:spout_mouth

layer vessel brush:gouache
  path "M340 353 C309 373 272 417 270 487 C267 568 312 622 400 638 C487 654 576 625 603 558 C629 493 603 411 556 369 C502 346 400 340 340 353 Z" fill:tea.teal.2 name:body
    path "M535 365 C600 453 602 549 543 598 C498 634 416 636 367 616 C487 665 619 625 631 511 L625 362 Z" fill:tea.teal.1 name:body_shadow
    path "M333 405 C302 444 297 501 311 536" fill:none stroke:tea.teal.3,23 name:body_light
    curve 330,556 361,589 405,602 stroke:tea.teal.3,8 fill:none name:reflection
    curve 377,438 406,449 433,440 463,451 493,440 523,450 stroke:tea.cream,4 fill:none name:painted_band
    each i in 0..5
      ellipse 5,13 at:380+i*30,474 rot:-25 fill:tea.cream seed:i
      ellipse 5,13 at:389+i*30,491 rot:35 fill:tea.cream seed:i+10
  ellipse 111,22 at:451,366 fill:tea.teal.0 name:lid_seam
  path "M330 359 C353 344 370 317 409 310 C457 299 517 315 547 347 L562 361 C501 382 391 380 330 359 Z" fill:tea.teal.3 name:lid
    curve 351,352 402,332 454,329 506,344 stroke:tea.teal.4,8 fill:none name:lid_glaze
  ellipse 25,13 at:442,311 fill:tea.teal.1 name:knob_base
  path "M425 309 C415 285 422 274 440 273 C461 272 472 289 459 309 Z" fill:tea.teal.2 name:knob
    ellipse 10,5 at:435,283 fill:tea.teal.4 name:knob_light

layer steam brush:gouache
  path "M423 247 C384 218 446 195 423 162 C400 130 420 107 443 94" fill:none stroke:tea.cream,[3 12 8 2] name:steam_left
  path "M472 263 C510 231 461 212 477 183 C493 154 517 145 499 120" fill:none stroke:tea.cream,[3 13 8 1] name:steam_right
  path "M460 201 C433 175 474 151 460 131" fill:none stroke:tea.cream,[2 7 1] a:.7 name:steam_middle

layer lemon brush:gouache
  path "M707 572 C720 543 770 539 804 557 C828 570 840 601 822 627 C802 653 749 660 717 636 C699 622 694 590 707 572 Z" fill:tea.yellow.2 name:lemon_half
    curve 754,550 794,565 815,588 stroke:tea.yellow.3,12 fill:none name:rind_light
  ellipse 65,57 at:718,611 rot:-18 fill:tea.yellow.1 name:cut_rind
  ellipse 59,51 at:716,608 rot:-18 fill:tea.cream name:pith
  ellipse 51,44 at:716,608 rot:-18 fill:tea.yellow.3 name:flesh
    each i in 0..9
      path "M0 0 L47 -15 Q53 0 45 17 Z" rot:i*40 fill:tea.yellow.2 stroke:tea.cream,3 seed:i
    ellipse 6,8 fill:tea.cream name:core
    ellipse 3,7 at:-20,-14 rot:-30 fill:tea.cream name:seed_one
    ellipse 3,7 at:18,16 rot:28 fill:tea.cream name:seed_two
  ellipse 61,18 at:776,677 rot:9 fill:tea.yellow.1 name:slice_rind
  ellipse 59,16 at:776,672 rot:9 fill:tea.cream name:slice_pith
  ellipse 51,12 at:776,671 rot:9 fill:tea.yellow.3 name:slice_flesh
    each i in 0..8
      curve 0,0 49*cos(i*45),11*sin(i*45) stroke:tea.cream,2 seed:i

layer leaves brush:gouache
  path "M818 638 Q850 584 891 607 Q879 646 818 638 Z" fill:tea.leaf name:leaf
  curve 820,636 848,625 879,612 stroke:tea.yellow.4,2 name:leaf_vein
  path "M806 650 Q839 635 853 665 Q825 681 806 650 Z" fill:tea.leaf name:small_leaf
