@target tea.png 1000x800 bg:tea.paper

palette tea
  color paper #f2e5ce
  color cream #fff4da
  color wall #dfcdb0
  color cloth #d2bca0
  color stripe #b58e75
  color shadow #957c65
  color rust #bd6349
  color dark #874734
  color peach #de936d
  color gold #e6af2f
  color yellow #f5ce50
  color pulp #f8df83
  color leaf #78846a

brush gouache amount:.12 rag:1.4 reach:1.5
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 19 + seeded(m), 3);
    float grain = hash12(floor(m.dev) + seeded(m));
    float streak = vnoise(float2(m.uv.x / 32, m.uv.y / 1.8) + seeded(m));
    float3 rgb = m.paint.rgb * (1 + (n-.5)*amount + (grain-.5)*.065 + (streak-.5)*.045);
    return float4(rgb, cover(m.edge + (n-.5)*rag, m));
  }
  """

layer paper_surface
  rect 996x796 at:500,400 fill:tea.paper brush:gouache name:paper
  ellipse 347,264 at:474,347 fill:tea.wall a:.38 brush:gouache name:warm_backdrop

layer linen brush:gouache
  curve 108,583 696,535 913,638 837,731 167,718 closed fill:tea.cloth name:napkin
    each i in 0..12
      curve 90,570+i*16 470,551+i*15 920,609+i*16 fill:none stroke:tea.stripe,2 a:.35 seed:30+i
    curve 176,702 575,680 850,706 fill:none stroke:tea.cream,3 a:.65 name:hem

layer grounding
  ellipse 227,27 at:431,625 fill:tea.shadow a:.25 blur:13 name:pot_shadow
  ellipse 114,18 at:735,661 fill:tea.shadow a:.24 blur:9 name:lemon_shadow

layer handle_layer brush:gouache
  path "M310 365 C165 283 143 431 196 493 C218 520 256 526 296 507" fill:none stroke:tea.dark,41 name:handle
  path "M306 356 C177 297 164 422 209 479 C231 501 254 503 282 494" fill:none stroke:tea.rust,27 name:handle_light
  path "M273 353 C209 333 187 368 190 408" fill:none stroke:tea.peach,7 name:handle_glint

layer spout_layer brush:gouache
  path "M551 418 C614 429 646 365 676 329 C689 315 710 310 723 321 C699 344 695 393 668 444 C644 493 607 513 563 513 Z" fill:tea.rust name:spout
    path "M584 452 C647 446 666 361 703 331 L720 319 C694 367 694 416 657 462 C633 493 597 504 566 506 Z" fill:tea.dark a:.5 name:spout_shade
    path "M581 431 C640 422 656 354 681 333" fill:none stroke:tea.peach,10 name:spout_glint
  ellipse 24,8 at:704,322 rot:-23 fill:tea.dark name:spout_mouth
  curve 682,328 702,320 721,316 fill:none stroke:tea.peach,5 name:spout_lip

layer pot_layer brush:gouache
  path "M327 346 C286 374 250 436 254 501 C258 580 311 623 426 628 C532 631 593 588 604 518 C617 445 580 379 534 347 Z" fill:tea.rust name:teapot
    path "M523 348 C560 428 566 532 506 579 C451 622 347 605 291 572 C321 628 462 656 552 606 C635 558 615 412 548 354 Z" fill:tea.dark a:.44 name:body_shadow
    path "M325 384 C291 413 280 457 284 488 C302 500 328 494 341 474 C331 442 346 407 365 382 Z" fill:tea.peach a:.7 name:body_light
    curve 300,536 337,560 389,567 fill:none stroke:tea.peach,11 a:.45 name:belly_stroke
    curve 312,594 417,614 517,591 fill:none stroke:tea.peach,5 a:.7 name:foot_reflection
    # A simple hand-painted botanical motif on the clay.
    curve 407,548 425,503 446,451 fill:none stroke:tea.cream,4 name:stem
    each i in 0..4
      ellipse 17,6 at:414+i*7,529-i*19 rot:32 fill:tea.cream seed:70+i
      ellipse 17,6 at:435+i*7,520-i*19 rot:-35 fill:tea.cream seed:80+i
  ellipse 105,17 at:430,352 fill:tea.dark name:neck
  path "M317 345 C334 318 371 303 423 303 C476 303 520 320 541 345 C492 364 365 363 317 345 Z" fill:tea.rust name:lid
    curve 333,341 420,350 525,342 fill:none stroke:tea.peach,7 name:lid_edge
    path "M337 333 C369 306 421 307 459 315" fill:none stroke:tea.peach,6 name:lid_glint
  ellipse 26,11 at:424,302 fill:tea.dark name:knob_base
  ellipse 20,18 at:422,289 fill:tea.rust name:knob
    ellipse 10,5 at:-4,-8 fill:tea.peach name:knob_light

layer steam_layer brush:gouache
  path "M410 246 C374 217 441 194 411 164 C383 135 409 117 425 104" fill:none stroke:tea.cream,[3 12 9 2] name:steam_one
  path "M461 261 C485 234 442 219 461 190 C481 161 470 146 462 137" fill:none stroke:tea.cream,[2 8 7 1] a:.8 name:steam_two
  path "M693 285 C673 265 704 247 698 228" fill:none stroke:tea.cream,[2 7 1] a:.7 name:steam_spout

layer lemon_back brush:gouache
  path "M712 587 C710 555 746 535 783 544 C814 549 838 573 835 594 C852 605 836 619 822 616 C796 644 745 638 724 611 C706 612 700 595 712 587 Z" fill:tea.gold name:lemon_half
    ellipse 44,28 at:766,571 rot:9 fill:tea.yellow name:lemon_light
  curve 788,550 808,524 846,526 822,549 788,550 closed fill:tea.leaf name:leaf
    curve 792,547 824,533 fill:none stroke:tea.cream,2 a:.5 name:vein

layer lemon_slice brush:gouache
  group slice at:719,632 rot:-17
    ellipse 72,49 at:0,8 fill:tea.gold name:rind_thickness
    ellipse 73,49 fill:tea.yellow name:rind
    ellipse 65,42 fill:tea.cream name:pith
    ellipse 59,37 fill:tea.pulp name:flesh
      each i in 0..9
        group at:0,0 rot:i*40
          path "M3 2 L44 -13 Q54 -4 49 10 Z" fill:tea.yellow a:.75 seed:100+i
          path "M10 1 L43 -6" fill:none stroke:tea.pulp,3 seed:120+i
      each i in 0..9
        curve 0,0 58*cos(i*40),36*sin(i*40) fill:none stroke:tea.cream,2.5 seed:150+i
      ellipse 7,5 fill:tea.cream name:core
      ellipse 4,2 at:23,-13 rot:-25 fill:tea.cream name:seed_one
      ellipse 4,2 at:-28,7 rot:20 fill:tea.cream name:seed_two

layer small_details brush:gouache
  ellipse 5,2 at:643,680 rot:13 fill:tea.gold name:crumb_one
  ellipse 3,2 at:660,688 fill:tea.pulp name:crumb_two
  curve 217,665 260,672 293,669 fill:none stroke:tea.cream,3 a:.6 name:linen_glint
