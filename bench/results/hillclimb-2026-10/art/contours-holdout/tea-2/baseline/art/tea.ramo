@target cozy-teapot.png 1000x800

use std/brushes { bristle }

palette tea
  color paper #f2e6cd
  color wall #e8d9bd
  color linen #d3b69b
  color thread #b58d74
  color shadow #957d63
  color green #739182
  color dark #3f6258
  color light #a9b8a0
  color pale #c7cfad
  color yellow #e8b530
  color gold #c58c23
  color flesh #f7d45c
  color pith #fff0b5
  color white #fff6df
  color leaf #65794c

brush gouache grain:.12
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 13 + seeded(m), 3);
    float tooth = hash12(floor(m.dev * .8));
    float streak = vnoise(float2(m.p.x / 36, m.p.y / 1.8) + seeded(m));
    float3 rgb = m.paint.rgb * (1.0 + (n-.5)*grain + (streak-.5)*.045 + (tooth-.5)*.055);
    return float4(rgb, cover(m.edge + (n-.5)*1.8, m));
  }
  """

layer paper_layer brush:gouache
  rect 1000x800 at:500,400 fill:tea.paper name:paper
  ellipse 410,295 at:488,370 fill:tea.wall a:.42 name:wall_glow

layer tablecloth brush:gouache
  path "M65 570 Q260 528 470 555 Q700 533 941 595 L960 752 Q736 731 515 752 Q270 726 48 750 Z" fill:tea.linen name:cloth
    each i in 0..9
      curve 80,590+i*20 340,570+i*20 610,590+i*20 943,610+i*20 stroke:tea.thread,2 a:.26 name:weft
    each i in 0..19
      curve 85+i*47,550 78+i*47,650 65+i*47,756 stroke:tea.white,2 a:.24 name:warp

layer ground
  ellipse 248,38 at:477,637 fill:tea.shadow a:.24 blur:17 name:pot_shadow
  ellipse 122,23 at:744,663 fill:tea.shadow a:.22 blur:11 name:lemon_shadow

layer handle_layer brush:gouache
  path "M603 366 C786 278 799 575 627 582" fill:none stroke:tea.dark,39 name:handle_shadow
  path "M610 362 C764 299 777 555 635 564" fill:none stroke:tea.green,29 name:handle
  path "M652 355 C736 335 764 444 731 501" fill:none stroke:tea.light,8 name:handle_light

layer spout_layer brush:gouache
  path "M346 441 C288 432 258 390 227 356 C218 347 201 348 193 340 C190 328 202 317 214 323 C254 345 291 355 322 375 L390 417 Z" fill:tea.green name:spout
    path "M197 327 Q271 377 316 384 L366 438 L337 457 Q280 412 258 376 Z" fill:tea.light name:spout_light
    path "M234 365 Q274 422 346 450 L363 431 Q284 404 261 368 Z" fill:tea.dark a:.5 name:spout_shade
  ellipse 17,6 at:204,330 rot:26 fill:tea.dark name:spout_mouth

layer vessel brush:gouache
  path "M365 363 C320 403 293 470 307 535 C317 604 376 635 477 637 C579 639 652 603 664 541 C678 466 639 402 600 364 Q485 345 365 363 Z" fill:tea.green name:body
    path "M571 365 C638 442 638 557 577 600 Q491 653 350 590 Q437 669 580 631 Q707 589 666 468 L609 371 Z" fill:tea.dark a:.6 name:shade
    ellipse 113,120 at:408,462 fill:tea.light a:.52 name:light_patch
    curve 356,432 338,474 344,521 stroke:tea.pale,[5 14 5] a:.6 name:shine
    each i in 0..6
      curve 373,554+i*5 431,568+i*5 500,567+i*5 stroke:tea.light,2 a:.18 name:body_brushwork
    curve 386,603 469,615 551,604 stroke:tea.light,5 a:.45 name:base_reflection
  ellipse 119,14 at:483,630 fill:tea.dark name:foot
  curve 387,629 480,638 575,628 stroke:tea.green,7 name:foot_light

layer lid_layer brush:gouache
  ellipse 125,24 at:483,366 fill:tea.dark name:lid_seam
  path "M359 360 Q385 316 483 314 Q575 316 608 360 Q485 390 359 360 Z" fill:tea.light name:lid
    path "M479 315 Q561 329 587 364 L616 362 L580 326 Z" fill:tea.green name:lid_shade
    curve 385,348 430,330 478,327 stroke:tea.pale,7 name:lid_glint
  curve 365,362 478,376 600,362 stroke:tea.green,5 name:lid_rim
  ellipse 26,9 at:482,314 fill:tea.dark name:knob_base
  path "M463 310 L466 293 Q482 278 498 294 L502 311 Q482 321 463 310 Z" fill:tea.green name:knob
    ellipse 12,5 at:478,295 fill:tea.pale name:knob_light

layer steam
  curve 455,267 441,238 457,204 448,167 432,144 stroke:tea.white,[4 12 8 2] brush:bristle(strength:.35 gaps:.2) a:.82 name:steam_left
  curve 495,260 518,218 500,184 509,145 528,117 stroke:tea.white,[8 15 9 1] brush:bristle(strength:.3 gaps:.2) a:.78 name:steam_center
  curve 542,277 560,250 547,223 554,196 stroke:tea.white,[3 9 5 1] brush:bristle(strength:.4 gaps:.2) a:.62 name:steam_right

layer lemon brush:gouache
  path "M703 576 Q748 541 794 568 Q842 598 833 632 Q814 674 762 660 Q710 647 695 610 Q684 600 703 576 Z" fill:tea.yellow name:lemon_half
    path "M748 635 Q792 660 834 615 L836 646 L800 673 L755 661 Z" fill:tea.gold name:peel_shadow
    each i in 0..24
      ellipse 1.5,1 at:716+mod(i*29 108),589+mod(i*17 53) fill:tea.gold a:.48 name:peel_pore
  group cut_face at:727,602 rot:-22
    ellipse 62,49 fill:tea.gold name:rind_edge
    ellipse 59,46 fill:tea.yellow name:rind
    ellipse 53,41 fill:tea.pith name:pith
    ellipse 47,35 fill:tea.flesh name:pulp
    each i in 0..9
      group at:0,0 rot:i*40
        path "M4 0 L34 -15 Q48 -7 44 6 L6 4 Z" fill:tea.yellow name:segment
        curve 10,1 26,-3 38,-4 stroke:tea.pith,2 a:.58 name:juice
    ellipse 6,5 fill:tea.pith name:core
    ellipse 3,6 at:-17,-13 rot:-25 fill:tea.white name:seed_one
    ellipse 3,6 at:16,12 rot:38 fill:tea.white name:seed_two
  group slice at:658,661 rot:12
    ellipse 62,24 fill:tea.gold name:slice_peel
    ellipse 61,22 at:0,-5 fill:tea.yellow name:slice_top
    ellipse 54,18 at:0,-6 fill:tea.pith name:slice_pith
    ellipse 48,14 at:0,-6 fill:tea.flesh name:slice_flesh
    each i in 0..8
      curve 0,-6 cos(i*45)*47,-6+sin(i*45)*14 stroke:tea.pith,2 name:slice_membrane

layer leaves brush:gouache
  path "M811 675 Q831 627 884 646 Q869 682 811 675 Z" fill:tea.leaf name:leaf_right
  curve 815,673 846,660 875,649 stroke:tea.light,2 name:leaf_vein
  path "M814 674 Q810 642 785 637 Q778 662 814 674 Z" fill:tea.dark name:leaf_left
  curve 814,676 805,656 790,643 stroke:tea.light,2 name:leaf_left_vein
