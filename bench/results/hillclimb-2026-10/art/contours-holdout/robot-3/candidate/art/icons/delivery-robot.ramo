@target icons/delivery-robot.png 512x512 bg:none
@target icons/delivery-robot.svg 512x512 bg:none

palette bot
  color ink #203744
  color face #243f4d
  color mint #79daca
  color light #c1f4df
  color shade #45adab
  color cream #fff3d7
  color orange #efa354
  color ochre #ce753c
  color tape #ffe0a1
  color glow #8df5df
  color blush #efaa88

layer antenna
  curve 259,114 259,78 275,64 stroke:bot.ink,10
  circle 14 at:278,61 fill:bot.orange stroke:bot.ink,6 name:antenna_tip
    circle 5 at:-4,-4 fill:bot.tape

layer wheels
  rect 60x76 r:24 at:175,412 fill:bot.ink name:left_wheel
    rect 12x47 r:6 at:-12,0 fill:bot.face
  rect 60x76 r:24 at:337,412 fill:bot.ink name:right_wheel
    rect 12x47 r:6 at:12,0 fill:bot.face

layer arms
  path "M151 283 C114 285 105 319 118 343 L144 356 L161 332 L146 320 L163 311 Z" fill:bot.shade stroke:bot.ink,7 name:left_arm
  path "M366 285 C400 280 410 253 401 230 L382 231 C386 252 371 256 355 260 Z" fill:bot.mint stroke:bot.ink,7 name:right_arm
  rect 34x41 r:14 at:394,222 rot:-15 fill:bot.light stroke:bot.ink,7 name:hand
  curve 387,216 401,213 stroke:bot.shade,4

layer body
  path "M161 267 Q256 242 351 267 L370 374 Q370 413 330 416 L180 416 Q140 412 142 375 Z" fill:bot.mint stroke:bot.ink,8 name:chassis
    path "M315 260 L349 265 L371 380 Q369 416 330 418 L172 418 L166 396 L307 395 Q341 391 339 370 Z" fill:bot.shade
    curve 166,296 171,281 203,275 stroke:bot.light,9
    rect 89x12 r:6 at:255,391 fill:bot.ink
    circle 5 at:188,380 fill:bot.cream
    circle 5 at:321,380 fill:bot.cream

layer head
  rect 244x166 r:59 at:256,193 fill:bot.mint stroke:bot.ink,8 name:head_shell
    path "M146 217 Q158 262 203 266 L322 267 Q367 260 376 223 L381 255 L365 280 L148 281 Z" at:-256,-193 fill:bot.shade
    curve 154,168 174,137 218,130 at:-256,-193 stroke:bot.light,10
  rect 195x108 r:39 at:256,196 fill:bot.face stroke:bot.ink,6 name:screen
    path "M166 185 Q171 151 205 151 L307 151 Q333 152 341 168 Q264 153 166 185 Z" at:-256,-196 fill:bot.ink
    curve -53,-2 -48,-15 -38,-15 -32,-2 stroke:bot.glow,9 name:left_eye
    curve 30,-2 35,-15 45,-15 51,-2 stroke:bot.glow,9 name:right_eye
    path "M235 212 Q255 232 277 211 Q271 240 256 240 Q241 240 235 212 Z" at:-256,-196 fill:bot.glow name:smile
    ellipse 11,5 at:-58,20 fill:bot.blush
    ellipse 11,5 at:58,20 fill:bot.blush

layer parcel
  path "M183 306 L246 285 L314 309 L314 366 L249 389 L183 365 Z" fill:bot.orange stroke:bot.ink,7 name:package
    path "M249 330 L315 307 L315 367 L249 390 Z" fill:bot.ochre
    path "M183 306 L247 285 L314 308 L249 331 Z" fill:bot.tape
    path "M210 298 L227 292 L294 315 L278 321 Z" fill:bot.orange
    path "M278 321 L294 315 L294 338 L278 344 Z" fill:bot.tape
    curve 249,334 249,383 stroke:bot.ink,4
    path "M199 328 L232 339 L232 358 L199 347 Z" fill:bot.cream
    curve 207,338 222,343 stroke:bot.ochre,3
  rect 34x27 r:12 at:179,349 rot:14 fill:bot.light stroke:bot.ink,6 name:parcel_grip
