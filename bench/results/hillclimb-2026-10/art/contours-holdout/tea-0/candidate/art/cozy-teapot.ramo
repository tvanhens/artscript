@target cozy-teapot.png 1000x800 bg:tea.paper

palette tea
  color paper #f3e8d4
  color cream #fff3d8
  color cloth #dec5ad
  color stitch #bb9681
  color shadow #9c8169
  color sage #749b89
  color deep #426e60
  color light #acc2a1
  color yellow #e9b733
  color rind #d39a22
  color pulp #f5d864
  color leaf #73814c
  color steam #b8aa96

brush gouache grain:.085 reach:1
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 19 + seeded(m), 3);
    float fine = hash12(m.p * 1.7 + seeded(m));
    float drag = vnoise(float2(m.uv.x / 45, m.uv.y / 1.6) + seeded(m));
    float3 paint = m.paint.rgb * (1 + (n-.5)*.16 + (fine-.5)*grain + (drag-.5)*.045);
    return float4(paint, cover(m.edge + (fine-.5)*1.4, m));
  }
  """

layer paper_texture brush:gouache
  rect 1000x800 at:500,400 fill:tea.paper name:paper

layer linen brush:gouache
  path "M115 505 Q350 479 602 511 L859 660 Q543 732 159 671 Z" fill:tea.cloth name:napkin
  curve 140,646 340,657 574,675 820,650 stroke:tea.stitch,2 name:hem
  curve 153,631 350,644 570,660 795,641 stroke:tea.cream,2 name:hem_light

layer grounding
  ellipse 245,33 at:438,576 fill:tea.shadow a:.24 blur:16 name:pot_shadow
  ellipse 116,24 at:721,624 fill:tea.shadow a:.23 blur:12 name:lemon_shadow

layer teapot_back brush:gouache
  path "M290 355 C168 296 136 381 170 458 C191 505 248 508 287 476 L278 446 C233 481 201 463 195 422 C186 369 221 359 272 393 Z" fill:tea.deep name:handle
    path "M280 365 C190 322 159 380 185 444" fill:none stroke:tea.light,10 name:handle_light
  path "M553 402 C611 403 638 364 658 319 C662 310 679 311 685 320 C670 379 639 447 565 479 Z" fill:tea.sage name:spout
    path "M590 416 Q639 386 668 330" stroke:tea.light,14 name:spout_light
    path "M582 460 Q642 425 669 367" stroke:tea.deep,10 name:spout_shade
  ellipse 16,7 at:672,318 rot:17 fill:tea.deep name:spout_opening

layer vessel brush:gouache
  path "M322 333 C286 355 253 414 257 474 C260 550 310 586 421 587 C528 587 579 553 589 488 C600 422 565 360 526 336 C478 312 369 310 322 333 Z" fill:tea.sage name:body
    path "M503 337 C592 451 550 551 451 588 L604 606 L628 345 Z" fill:tea.deep a:.42 name:body_shade
    path "M304 403 C322 358 363 351 397 351" stroke:tea.light,24 name:shoulder_light
    curve 288,443 286,481 302,511 stroke:tea.light,12 a:.65 name:side_light
    path "M289 548 Q429 591 555 548" stroke:tea.deep,9 a:.55 name:base_edge
    each i in 0..5
      group at:345+i*35,465
        curve -6,16 0,0 7,-13 stroke:tea.cream,3 name:stem
        ellipse 6,11 at:-5,2 rot:-35 fill:tea.cream name:petal_left
        ellipse 5,10 at:6,-8 rot:34 fill:tea.cream name:petal_right
  ellipse 112,19 at:424,337 fill:tea.deep name:lid_seam
  path "M310 332 C325 305 365 294 421 294 C479 294 521 305 538 331 C490 350 358 353 310 332 Z" fill:tea.sage name:lid
    curve 332,324 372,309 421,307 482,316 stroke:tea.light,8 name:lid_light
  ellipse 22,10 at:423,294 fill:tea.deep name:knob_base
  path "M410 294 Q400 272 416 266 Q433 260 439 276 L435 294 Z" fill:tea.deep name:knob
    curve 415,284 414,274 425,272 stroke:tea.light,5 name:knob_light

layer steam brush:gouache
  path "M419 245 C384 213 451 194 427 163 C410 140 416 123 433 106" fill:none stroke:tea.steam,[3 12 9 2] a:.65 name:steam_center
  path "M465 254 C446 233 489 213 479 191 C468 171 468 162 477 149" fill:none stroke:tea.steam,[2 8 6 1] a:.5 name:steam_right
  path "M374 252 C352 232 381 211 372 196" fill:none stroke:tea.steam,[2 7 1] a:.45 name:steam_left

layer lemons brush:gouache
  path "M698 538 C729 510 785 526 813 564 Q834 602 800 625 C762 649 703 629 688 596 Q677 567 698 538 Z" fill:tea.yellow name:lemon_half
    path "M791 541 Q849 586 797 625 L776 628 Q814 591 773 541 Z" fill:tea.rind name:lemon_peel_shadow
  group at:724,568 rot:-21
    ellipse 58,64 fill:tea.yellow name:cut_rind
    ellipse 51,57 fill:tea.cream name:cut_pith
    ellipse 44,50 fill:tea.pulp name:cut_flesh
    each i in 0..9
      group rot:i*40
        path "M0 -3 L-11 -39 Q0 -48 12 -39 Z" fill:tea.yellow name:segment
        curve 0,-10 1,-23 -1,-35 stroke:tea.pulp,3 name:juice
    ellipse 5,7 fill:tea.cream name:core
    ellipse 3,6 at:14,-17 rot:35 fill:tea.cream name:seed
  group at:637,636 rot:12
    ellipse 66,31 fill:tea.rind name:slice_edge
    ellipse 66,29 at:0,-6 fill:tea.yellow name:slice_rind
    ellipse 59,25 at:0,-7 fill:tea.cream name:slice_pith
    ellipse 52,20 at:0,-7 fill:tea.pulp name:slice_flesh
    each i in 0..8
      curve 0,-7 50*cos(i*45),-7+19*sin(i*45) stroke:tea.cream,3 name:membrane
    ellipse 5,3 at:0,-7 fill:tea.cream name:slice_core

layer small_details brush:gouache
  path "M790 653 Q827 617 854 638 Q836 672 790 653 Z" fill:tea.leaf name:lemon_leaf
  curve 789,654 814,649 843,640 stroke:tea.light,2 name:leaf_vein
  ellipse 3,2 at:583,660 fill:tea.rind name:crumb_one
  ellipse 2,2 at:568,648 fill:tea.rind name:crumb_two
