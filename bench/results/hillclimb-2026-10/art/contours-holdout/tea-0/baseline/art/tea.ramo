@target tea.png 1000x800 bg:tea.paper

palette tea
  color paper #f3e7cf
  color cream #fff2d4
  color wall #e5d5b6
  color cloth #c98769
  color stripe #e6b89a
  color shadow #92765c
  ramp sage #668b7e 5
  color deep #3d625a
  color glint #bdcbb0
  color rind #dbab30
  color yellow #f2cc56
  color pulp #f8df81
  color pith #fff0bd
  color leaf #6e8050
  color steam #b3a78e

brush gouache grit:.055 rag:1.3 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 19 + seeded(m), 3);
    float grain = hash12(floor(m.dev) + seeded(m));
    float streak = vnoise(float2(m.uv.x/35, m.uv.y/1.5) + seeded(m));
    float3 rgb = m.paint.rgb * (0.94 + n*.10) + (grain-.5)*grit + (streak-.5)*.025;
    return float4(rgb, cover(m.edge + (n-.5)*rag, m));
  }
  """

def lemon_slice size:132x118
  ellipse 66,59 fill:tea.rind name:rind brush:gouache
    ellipse 61,54 at:-1,-2 fill:tea.yellow name:peel
    ellipse 55,48 at:-1,-3 fill:tea.pith name:pith
    each i in 0..9
      group rot:i*40 at:-1,-3
        path "M 5 -3 Q 20 -30 38 -29 Q 52 -13 47 5 Q 22 5 5 2 Z" fill:tea.pulp name:segment
          each j in 0..5
            curve 12+j*5,-1 17+j*5,-11 23+j*4,-17 stroke:tea.yellow,1 a:.55 name:juice
    ellipse 6,5 at:-1,-3 fill:tea.pith name:center
    ellipse 2,5 at:20,-14 rot:34 fill:tea.cream name:seed_a
    ellipse 2,5 at:-20,18 rot:-40 fill:tea.cream name:seed_b

layer paper_surface brush:gouache
  rect 1000x800 at:500,400 fill:tea.paper name:paper brush:gouache(reach:0)
  ellipse 350,240 at:434,343 fill:tea.cream a:.33 name:daylight

layer linen brush:gouache
  path "M 100 552 Q 340 509 596 548 L 862 666 L 786 738 Q 460 692 139 733 Z" fill:tea.cloth name:napkin
    each i in 0..14
      curve 55,550+i*15 360,535+i*13 825,646+i*9 stroke:tea.stripe,2 a:.5 name:weave
    path "M 140 698 Q 460 650 799 701 L 785 738 Q 455 694 139 733 Z" fill:tea.shadow a:.18 name:fold

layer cast_shadows
  ellipse 232,35 at:466,611 fill:tea.shadow a:.25 blur:15 name:pot_shadow
  ellipse 131,19 at:746,659 fill:tea.shadow a:.27 blur:10 name:lemon_shadow

layer pottery brush:gouache
  path "M 577 363 C 724 287 756 461 644 510 L 617 479 C 699 446 698 357 608 400 Z" fill:tea.deep name:handle
    path "M 601 372 C 715 325 731 447 643 489" fill:none stroke:tea.sage.3,12 name:handle_light
  path "M 327 452 C 266 446 260 403 230 350 L 195 329 Q 184 321 193 314 Q 228 306 251 326 C 289 351 293 380 356 385 Z" fill:tea.sage name:spout
    path "M 200 321 Q 229 321 248 340 C 269 368 275 401 324 413" fill:none stroke:tea.glint,12 name:spout_light
    ellipse 26,7 at:215,322 rot:16 fill:tea.deep name:mouth
  path "M 380 323 C 328 350 289 409 297 486 C 304 575 361 612 465 614 C 579 618 633 571 639 487 C 645 408 599 352 550 328 Z" fill:tea.sage name:body
    path "M 559 330 C 620 387 605 498 569 543 C 523 592 421 599 339 558 C 367 611 463 638 558 607 C 647 578 680 439 601 359 Z" fill:tea.deep a:.55 name:shade
    path "M 369 367 C 335 403 326 456 339 493" fill:none stroke:tea.glint,[8 23 10] name:light_stroke
    path "M 361 389 Q 348 419 349 447" fill:none stroke:tea.cream,5 a:.5 name:shine
    curve 348,553 414,575 497,578 555,562 stroke:tea.sage.3,4 a:.55 name:reflected
    # A small hand-painted botanical decoration.
    curve 438,523 454,482 470,446 482,421 stroke:tea.cream,3 name:stem
    each i in 0..4
      ellipse 17,7 at:444+i*10,504-i*23 rot:30 fill:tea.glint name:leaf_left
      ellipse 16,7 at:461+i*9,493-i*23 rot:-38 fill:tea.glint name:leaf_right
  ellipse 82,12 at:467,607 fill:tea.deep name:foot
  ellipse 78,6 at:464,602 fill:tea.sage name:foot_rim
  ellipse 93,17 at:463,339 fill:tea.deep name:lid_seam
  path "M 367 334 Q 376 303 410 293 Q 465 277 518 294 Q 547 304 558 334 Q 462 361 367 334 Z" fill:tea.sage.3 name:lid
    curve 382,326 427,309 477,307 523,317 stroke:tea.glint,7 name:lid_light
  ellipse 96,9 at:463,335 fill:tea.sage name:lid_edge
  ellipse 22,10 at:462,294 fill:tea.deep name:knob_base
  ellipse 19,18 at:461,281 fill:tea.sage name:knob
    ellipse 10,5 at:-4,-7 fill:tea.glint name:knob_light

layer lemon brush:gouache
  path "M 683 584 C 695 548 767 538 809 571 Q 839 599 815 638 Q 793 670 731 654 Q 681 641 683 584 Z" fill:tea.rind name:lemon_half
    path "M 693 581 Q 747 548 800 575" fill:none stroke:tea.yellow,13 name:rind_light
  lemon_slice at:752,595 rot:-15 scale:1.04,.72 name:cut_half
  lemon_slice at:686,658 rot:13 scale:.88,.54 name:loose_slice
  path "M 792 550 Q 813 513 852 532 Q 832 562 792 550 Z" fill:tea.leaf name:lemon_leaf
    curve 798,547 819,539 843,534 stroke:tea.glint,2 name:vein

layer steam brush:gouache
  path "M 421 263 C 386 234 447 214 432 180 C 417 145 403 145 426 111" fill:none stroke:tea.steam,[4 11 9 2] a:.6 name:steam_left
  path "M 475 245 C 517 209 463 195 478 161 C 492 135 514 120 500 87" fill:none stroke:tea.steam,[3 13 10 2] a:.55 name:steam_right
  path "M 240 298 C 221 276 249 264 247 244" fill:none stroke:tea.steam,[2 7 1] a:.5 name:spout_steam
