@target cozy-teapot.png 1000x850 bg:tea.paper

palette tea
  color paper #f3e8d3
  color cream #fff4d9
  color wall #e8d9bb
  color cloth #d7c7a7
  color stripe #b8b69b
  ramp clay #ba654c 5
  color deep #743f38
  color glaze #e5a07b
  color yellow #e6b637
  color pulp #f4d365
  color pith #fff0bd
  color leaf #687856
  color shadow #ac9679

brush gouache grain:.13 rag:1.4 reach:2
  sksl """
  float4 shade(Mark m) {
    float n = fbm(m.p / 23 + seeded(m), 3);
    float tooth = hash12(floor(m.dev) + seeded(m));
    float streak = vnoise(float2(m.p.x / 35, m.p.y / 2.3) + seeded(m));
    float3 c = m.paint.rgb * (1 + grain * (n-.5) + grain*.45*(tooth-.5) + grain*.4*(streak-.5));
    return float4(c, cover(m.edge + (n-.5)*rag, m));
  }
  """

layer paper_layer brush:gouache
  rect 996x846 at:500,425 fill:tea.paper name:paper
  ellipse 340,285 at:479,372 fill:tea.wall a:.35 name:backwash

layer linen brush:gouache
  path "M 100 571 Q 280 546 426 571 L 826 561 L 901 744 Q 624 782 378 752 L 118 768 Z" fill:tea.cloth name:napkin
    each i in 0..13
      curve 85,593+i*13 400,585+i*13 910,582+i*13 stroke:tea.cream,2 a:.27 seed:40+i
    each i in 0..19
      curve 128+i*40,551 147+i*40,661 165+i*40,790 stroke:tea.stripe,1.8 a:.35 seed:80+i
  ellipse 245,27 at:443,656 fill:tea.shadow a:.6 name:pot_shadow
  ellipse 126,20 at:752,704 fill:tea.shadow a:.55 name:fruit_shadow

layer handle_layer brush:gouache
  path "M 329 371 C 173 285 127 415 181 505 C 209 552 274 565 322 531 L 319 491 C 263 524 216 492 207 445 C 193 374 254 370 312 409 Z" fill:tea.deep name:handle
    path "M 316 381 C 185 312 150 419 192 492 C 213 529 263 542 301 523" fill:none stroke:tea.clay,16 name:handle_light

layer spout_layer brush:gouache
  path "M 535 448 C 607 434 618 406 645 359 Q 659 334 692 339 Q 700 360 678 378 C 667 437 634 500 565 534 Z" fill:tea.clay name:spout
    path "M 575 458 C 638 432 648 386 668 361" fill:none stroke:tea.glaze,15 name:spout_light
    path "M 589 492 Q 651 456 673 384 L 681 368 Q 646 477 597 515 Z" fill:tea.deep a:.4 name:spout_shade
  ellipse 22,8 at:678,348 rot:-12 fill:tea.deep name:spout_mouth
  curve 657,344 676,340 695,344 stroke:tea.glaze,5 name:spout_lip

layer kettle brush:gouache
  path "M 338 346 C 305 370 266 432 264 500 C 257 591 306 641 391 653 C 483 669 560 636 580 575 C 607 500 567 394 527 349 Q 430 327 338 346 Z" fill:tea.clay name:body
    path "M 459 352 C 535 412 565 521 532 590 Q 507 635 370 649 Q 553 691 587 581 C 611 496 568 389 527 349 Z" fill:tea.deep a:.38 name:shade
    path "M 342 391 Q 292 465 305 529 Q 312 550 325 532 Q 311 471 369 390 Q 360 375 342 391 Z" fill:tea.glaze a:.8 name:highlight
    curve 329,578 360,605 411,616 stroke:tea.glaze,12 a:.5 name:lower_light
    each i in 0..9
      ellipse 4,2 at:335+i*23,564+sin(i*24)*8 fill:tea.cream a:.7 seed:160+i
    curve 357,489 399,478 442,485 485,474 stroke:tea.cream,3 a:.65 name:stem
    each i in 0..5
      ellipse 7,15 at:367+i*24,475+sin(i*50)*5 rot:-35+i*7 fill:tea.cream a:.7 seed:200+i
  ellipse 108,17 at:429,649 fill:tea.deep name:foot
  curve 342,646 428,655 517,642 stroke:tea.clay,8 name:foot_front
  ellipse 105,19 at:433,354 fill:tea.deep name:collar
  path "M 321 345 Q 339 311 383 304 Q 433 288 483 307 Q 516 316 539 345 Q 435 370 321 345 Z" fill:tea.clay name:lid
    curve 338,338 429,349 522,338 stroke:tea.glaze,8 name:lid_rim
    curve 354,323 390,310 422,311 stroke:tea.glaze,7 name:lid_light
  ellipse 24,11 at:431,299 fill:tea.deep name:knob_base
  path "M 411 296 Q 401 273 417 263 Q 435 254 449 269 Q 459 283 447 297 Z" fill:tea.clay name:knob
    ellipse 11,6 at:424,270 fill:tea.glaze name:knob_light

layer steam brush:gouache
  path "M 427 239 C 380 213 459 189 429 157 C 398 124 417 103 434 89" fill:none stroke:tea.cream,[2 10 8 2] a:.8 name:steam_center
  path "M 476 258 C 508 223 454 212 477 183 C 502 153 485 136 476 125" fill:none stroke:tea.cream,[3 8 6 1] a:.65 name:steam_right
  path "M 376 251 C 342 232 389 209 370 189" fill:none stroke:tea.cream,[2 7 1] a:.6 name:steam_left

def lemon_slice size:140
  ellipse 70,61 fill:tea.yellow name:rind
    ellipse 63,54 at:0,-2 fill:tea.pith name:pith
    ellipse 57,48 at:0,-2 fill:tea.pulp name:flesh
      each i in 0..9
        group rot:i*40
          path "M 3 -2 Q 18 -20 39 -33 Q 52 -22 53 -8 Q 30 -2 3 -2 Z" fill:tea.yellow a:.48 seed:300+i
          curve 5,0 32,-19 49,-30 stroke:tea.pith,3 seed:350+i
      ellipse 6,5 fill:tea.pith name:center
      ellipse 3,7 at:-23,-20 rot:-30 fill:tea.pith name:seed_one
      ellipse 3,6 at:21,21 rot:40 fill:tea.pith name:seed_two

layer lemons brush:gouache
  path "M 701 634 Q 698 612 717 600 C 731 577 791 577 811 603 Q 833 609 827 631 Q 838 658 810 680 Q 748 707 712 675 Q 694 663 701 634 Z" fill:tea.yellow name:lemon_half
    ellipse 58,28 at:758,650 fill:tea.pulp a:.6 name:half_light
  lemon_slice at:771,624 rot:-18 scale:.91 name:back_slice seed:24
  lemon_slice at:683,691 rot:13 name:front_slice seed:25
  path "M 803 685 Q 823 652 865 667 Q 852 703 803 685 Z" fill:tea.leaf name:leaf
    curve 810,683 833,678 854,673 stroke:tea.cloth,2 name:vein
  ellipse 4,2 at:612,707 rot:20 fill:tea.yellow name:crumb_one
  ellipse 3,2 at:623,718 fill:tea.yellow name:crumb_two
