@target kingfisher.png 1000x1000 bg:river.paper
@target kingfisher.svg 1000x1000 bg:river.paper

palette river
  color paper #f6e9ce
  color ink #123b47
  color blue #008dab
  color orange #ef7238

# Four solid inks; sweeping wings and river currents share the same rhythm.
layer sky
  circle 139 at:738,253 fill:river.orange name:sun

layer water
  path "M50 786 C190 721 285 805 430 782 C595 754 702 717 950 775 L950 950 L50 950 Z" fill:river.blue name:river_surface
  path "M50 855 C216 787 302 898 478 848 C637 801 772 806 950 853 L950 887 C772 840 644 839 488 883 C303 936 192 830 50 888 Z" fill:river.paper name:current
  path "M115 935 C264 892 341 968 508 926 C683 881 805 896 905 928" stroke:river.ink,13 fill:none name:deep_current
  path "M624 784 C684 755 785 756 839 785" fill:none stroke:river.ink,12 name:surface_ripple
  path "M672 806 C708 793 758 792 793 803" fill:none stroke:river.paper,9

layer far_wing
  path "M466 436 C471 340 509 213 616 113 C610 185 596 248 566 310 L621 266 C603 328 567 382 524 427 L493 470 Z" fill:river.ink name:raised_wing
  path "M491 411 C513 304 549 224 590 169 C568 274 539 350 508 403 Z" fill:river.blue name:wing_flash

layer tail
  path "M433 422 L304 365 L360 451 L325 443 L401 498 L466 475 Z" fill:river.ink name:tail_fan
  path "M422 444 L350 407 L401 469 L449 477 Z" fill:river.blue

layer body
  path "M416 399 C477 384 543 424 590 488 C616 515 634 539 644 572 C620 604 574 610 535 584 C483 552 449 493 416 399 Z" fill:river.blue name:back
  path "M425 454 C467 468 513 505 548 539 C571 557 594 567 620 568 L637 588 C603 621 564 613 528 587 C482 556 446 508 425 454 Z" fill:river.orange name:breast

layer near_wing
  path "M529 495 C477 499 417 478 368 444 C286 389 219 307 150 191 C238 218 325 254 399 307 C461 351 509 416 529 495 Z" fill:river.ink name:swept_wing
  path "M499 454 C437 426 388 387 346 345 C288 289 246 255 205 229 C298 260 362 298 417 347 C456 382 483 419 499 454 Z" fill:river.blue name:wing_panel
  path "M210 273 L345 371 L317 338 Z" fill:river.paper
  path "M256 342 L391 425 L362 394 Z" fill:river.paper
  path "M324 415 L450 471 L421 448 Z" fill:river.paper

layer head
  path "M563 508 C582 487 615 490 642 514 C666 535 677 561 670 586 L645 609 C619 603 592 583 579 560 Z" fill:river.blue name:head_shape
  path "M589 534 C614 533 642 553 662 575 L650 596 C622 582 603 561 589 534 Z" fill:river.ink name:eye_mask
  path "M579 550 L607 565 L629 593 L616 599 L586 578 Z" fill:river.paper name:collar
  path "M645 575 L782 735 L665 611 L646 604 Z" fill:river.ink name:bill
  path "M665 604 L753 705 L658 612 Z" fill:river.orange
  circle 10 at:631,558 fill:river.paper name:eye_ring
  circle 6.5 at:633,560 fill:river.ink name:eye

layer motion
  path "M771 654 L800 687" stroke:river.ink,7
  path "M808 634 L840 670" stroke:river.ink,7
  path "M697 721 L708 742" stroke:river.blue,9
  path "M811 727 L802 747" stroke:river.blue,9
