@target delivery-robot.png 512x512 bg:none
@target delivery-robot.svg 512x512 bg:none

palette bot
  ramp mint #65cdb8 5
  ramp cream #f3f3dc 5
  ramp gold #efb755 5
  color ink #233c4a
  color screen #193744
  color eyes #aefff0
  color pink #ed9290
  color white #ffffff

layer wheels
  rect 62x94 r:24 at:173,405 fill:bot.ink name:left_wheel
    rect 12x54 r:6 at:-14,-4 fill:bot.cream.1
  rect 62x94 r:24 at:341,405 fill:bot.ink name:right_wheel
    rect 12x54 r:6 at:14,-4 fill:bot.cream.1
  rect 174x28 r:12 at:257,410 fill:bot.mint.0 stroke:bot.ink,7

layer parcel
  rect 132x102 r:13 at:303,157 rot:8 fill:bot.gold stroke:bot.ink,8 name:package
    rect 132x18 at:0,-37 fill:bot.gold.3
    rect 25x102 at:0,0 fill:bot.cream
    rect 45x27 r:5 at:29,22 fill:bot.cream.4
    path "M 21 26 L 35 12 M 25 12 L 35 12 L 35 22" fill:none stroke:bot.ink,4

layer antenna
  curve 188,140 176,94 stroke:bot.ink,10
  circle 17 at:175,88 fill:bot.gold stroke:bot.ink,7
    circle 5 at:-5,-5 fill:bot.white

layer arms
  curve 145,303 114,289 108,260 stroke:bot.ink,31
  curve 145,303 114,289 108,260 stroke:bot.mint,17
  rect 39x42 r:15 at:108,246 rot:-15 fill:bot.cream stroke:bot.ink,7
  curve 367,301 395,280 390,244 stroke:bot.ink,31
  curve 367,301 395,280 390,244 stroke:bot.mint,17
  rect 40x42 r:15 at:387,235 rot:16 fill:bot.cream stroke:bot.ink,7

layer chassis
  rect 244x203 r:54 at:256,312 fill:bot.mint stroke:bot.ink,9 name:body
    rect 244x54 at:0,82 fill:bot.mint.1
    rect 195x18 r:9 at:-12,-81 fill:bot.mint.4
    rect 100x42 r:15 at:0,62 fill:bot.cream stroke:bot.ink,5
    path "M -18 63 L -3 63 L -3 51 L 18 64 L -3 77 L -3 66" fill:bot.gold stroke:bot.ink,3
    circle 5 at:-83,61 fill:bot.ink
    circle 5 at:83,61 fill:bot.ink

layer head
  rect 229x150 r:49 at:245,224 fill:bot.cream stroke:bot.ink,9 name:head_shell
    rect 229x28 at:0,66 fill:bot.cream.1
    rect 142x10 r:5 at:-13,-59 fill:bot.white
  rect 185x104 r:33 at:245,227 fill:bot.screen stroke:bot.ink,5 name:face
    path "M -60 -9 Q -48 -31 -36 -9" fill:none stroke:bot.eyes,9
    path "M 16 -9 Q 28 -31 40 -9" fill:none stroke:bot.eyes,9
    path "M -26 14 Q -10 34 9 14" fill:none stroke:bot.eyes,6
    ellipse 10,5 at:-58,20 fill:bot.pink
    ellipse 10,5 at:45,20 fill:bot.pink
    curve -65,-34 -40,-34 stroke:bot.white,4 a:.18
