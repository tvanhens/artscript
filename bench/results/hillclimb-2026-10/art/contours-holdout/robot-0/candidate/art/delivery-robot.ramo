@target delivery-robot.png 512x512 bg:none
@target delivery-robot.svg 512x512 bg:none

palette bot
  color ink #203d4b
  color mint #72dbbe
  color light #c4f9df
  color shade #38ad9e
  color cream #fff4d9
  color screen #234653
  color eye #b3ffe8
  color orange #f5ae58
  color gold #ffe0a0
  color rust #ce763c
  color tire #344e5c
  color hub #7796a1
  color blush #ffb39b

layer antenna_layer
  curve 262,109 274,72 fill:none stroke:bot.ink,12 name:antenna
  circle 16 at:278,61 fill:bot.orange stroke:bot.ink,7
    circle 5 at:-4,-5 fill:bot.gold

layer wheels
  rect 66x94 r:25 at:179,406 rot:5 fill:bot.tire stroke:bot.ink,8 name:left_wheel
    rect 14x58 r:7 at:-13,-1 fill:bot.hub
  rect 66x94 r:25 at:338,406 rot:-5 fill:bot.tire stroke:bot.ink,8 name:right_wheel
    rect 14x58 r:7 at:13,-1 fill:bot.hub

layer waving_arm
  path "M350 260 C382 262 404 238 412 210" fill:none stroke:bot.ink,29 name:raised_arm
  path "M350 260 C382 262 404 238 412 210" fill:none stroke:bot.shade,15
  group at:417,184 rot:17
    rect 45x55 r:19 fill:bot.mint stroke:bot.ink,7 name:hand
    curve -13,-20 -18,-40 fill:none stroke:bot.ink,15
    curve -13,-20 -18,-40 fill:none stroke:bot.light,6
    curve 3,-22 4,-47 fill:none stroke:bot.ink,15
    curve 3,-22 4,-47 fill:none stroke:bot.mint,6
    curve 17,-13 24,-31 fill:none stroke:bot.ink,14
    curve 17,-13 24,-31 fill:none stroke:bot.mint,5

layer chassis
  rect 225x171 r:53 at:256,326 fill:bot.mint stroke:bot.ink,9 name:body
    path "M65 -90 L125 -90 L125 100 L-125 100 L-125 60 L29 60 Q62 54 62 19 Z" fill:bot.shade
    curve -84,-41 -78,-59 -55,-67 fill:none stroke:bot.light,9
  rect 137x20 r:10 at:257,396 fill:bot.ink
  rect 64x8 r:4 at:257,396 fill:bot.shade

layer head_layer
  rect 262x166 r:57 at:250,184 rot:-4 fill:bot.mint stroke:bot.ink,9 name:head
    rect 260x35 at:0,78 fill:bot.shade
    curve -104,-42 -94,-60 -70,-65 36,-65 fill:none stroke:bot.light,9
    rect 207x108 r:36 at:0,9 fill:bot.screen stroke:bot.ink,6 name:visor
      path "M-103 -45 L70 -54 L-82 36 Z" fill:bot.hub a:.18
      curve -60,3 -60,-8 -54,-14 -47,-13 -42,-7 -42,3 fill:none stroke:bot.eye,11 name:left_eye
      curve 38,3 38,-8 44,-14 51,-13 56,-7 56,3 fill:none stroke:bot.eye,11 name:right_eye
      path "M-20 19 Q0 44 22 19 Z" fill:bot.eye name:smile
      ellipse 12,6 at:-76,22 fill:bot.blush
      ellipse 12,6 at:77,22 fill:bot.blush
  rect 17x44 r:8 at:110,188 rot:-4 fill:bot.cream stroke:bot.ink,6

layer parcel
  group at:248,333 rot:-7
    rect 142x104 r:12 fill:bot.orange stroke:bot.ink,8 name:package
      rect 140x19 at:0,44 fill:bot.rust
      rect 28x110 at:0,0 fill:bot.gold
      curve -59,-35 -38,-35 fill:none stroke:bot.gold,6
      rect 35x23 r:4 at:38,20 fill:bot.cream
      path "M30 20 L39 12 L47 20 M39 13 L39 28" fill:none stroke:bot.rust,4
    curve -69,-19 69,-19 fill:none stroke:bot.rust,3

layer holding_arm
  path "M149 278 Q112 287 127 333 Q136 354 167 353" fill:none stroke:bot.ink,31 name:carrying_arm
  path "M149 278 Q112 287 127 333 Q136 354 167 353" fill:none stroke:bot.mint,17
  rect 47x34 r:15 at:171,351 rot:-7 fill:bot.light stroke:bot.ink,7 name:gripper
    curve -2,-9 11,-9 fill:none stroke:bot.shade,4
