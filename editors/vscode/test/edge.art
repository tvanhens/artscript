# test/edge.art: a buffer that does not parse. Each line exercises one lexer rule.
# The unclosed raw string must stay the last line.
@target out/{name}.png 256x256 each name:[a b]
@a.b
palette p from base
  c #fff#abc
  d {#fff}
  e #ffff, #12345
circle 10 at:(1).5,.5 r:12deg s:5degx t:.25turn w:100%x60% q:50%
blob:3 in:2 from:x profile:vector
pose 1
mask: # a slot with a trailing comment
mask: #fff
.head.eye fill:red off
	tabbed 1
fill:"esc \" \\ \n \q" bad:"unclosed
x 14,0 y 14, 0 z a !b ~c 3 % 4 @ @r.1.* -> .. ~= != café
sksl """
  # not a comment
"""
use lib/face as f { a b }
let k = true and not none
tail """ unclosed to EOF
